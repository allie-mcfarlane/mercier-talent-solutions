---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ThemeSettings from "../components/ThemeSettings.astro";
import PageBuilder from "../components/PageBuilder.astro";
import VisualPageEdits from "../components/VisualPageEdits.astro";
import { getEntry } from "astro:content";
import { site } from "../data/site";
import "../styles/global.css";

const {
  title = "Mercier Talent Solutions",
  description = "Talent development for law firms.",
  image,
  type = "website",
  publishedTime,
  modifiedTime,
  author,
  visualStyles: suppliedVisualStyles,
  visualBuilderSections: suppliedVisualBuilderSections,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, site.url).toString();
const imageUrl = image ? new URL(image, site.url).toString() : undefined;
const publishedIso = publishedTime instanceof Date ? publishedTime.toISOString() : publishedTime;
const modifiedIso = modifiedTime instanceof Date ? modifiedTime.toISOString() : modifiedTime;

const existingPageByPath: Record<string, string> = {
  "/": "home",
  "/about/": "about",
  "/services/": "services",
  "/news/": "news",
  "/whitepapers/": "whitepapers",
  "/contactus/": "contact",
  "/privacy/": "privacy",
  "/privacy-choices/": "privacy-choices",
  "/data-requests/": "data-requests",
};

const fixedStyleSelectors: Record<string, Record<string, string>> = {
  home: {
    hero: ".hero",
    proof: ".proof",
    approach: ".approach",
    news: ".news-band",
  },
  about: {
    hero: ".about-hero",
    firm: ".firm-band",
    team: ".team-band",
  },
  services: {
    hero: ".services-hero",
    focus: ".coaching-focus",
    services: ".service-section",
    training: ".training-section",
    consulting: ".consulting-section",
  },
};

const pageEntryId = existingPageByPath[Astro.url.pathname];
const pageEntry = pageEntryId ? await getEntry("pages", pageEntryId) : undefined;
const additionalSections = (pageEntry?.data.sections ?? []) as Record<string, unknown>[];
const fixedVisualStyles = (suppliedVisualStyles ?? pageEntry?.data.visualStyles ?? {}) as Record<string, Record<string, unknown>>;
const visualBuilderSections = (suppliedVisualBuilderSections ?? additionalSections) as Record<string, unknown>[];

const finiteNumber = (value: unknown, min: number, max: number) => {
  const number = Number(value);
  return Number.isFinite(number) ? Math.min(max, Math.max(min, number)) : null;
};
const safeColor = (value: unknown) =>
  typeof value === "string" && /^#[0-9a-f]{6}$/i.test(value) ? value : null;

const fixedDesktopRules: string[] = [];
const fixedMobileRules: string[] = [];
const sectionSelectors = pageEntryId ? fixedStyleSelectors[pageEntryId] ?? {} : {};

Object.entries(sectionSelectors).forEach(([sectionId, selector]) => {
  const style = fixedVisualStyles[sectionId] ?? {};
  const paddingTop = finiteNumber(style.paddingTop, 0, 220);
  const paddingBottom = finiteNumber(style.paddingBottom, 0, 220);
  const headingSize = finiteNumber(style.headingFontSize, 22, 88);
  const bodySize = finiteNumber(style.bodyFontSize, 12, 26);
  const headingColor = safeColor(style.headingColor);
  const bodyColor = safeColor(style.bodyColor);
  const preserveHomeHeroSpacing = pageEntryId === "home" && sectionId === "hero";

  const sectionRules: string[] = [];
  if (!preserveHomeHeroSpacing && paddingTop !== null) sectionRules.push(`padding-top:${paddingTop}px!important`);
  if (!preserveHomeHeroSpacing && paddingBottom !== null) sectionRules.push(`padding-bottom:${paddingBottom}px!important`);
  if (sectionRules.length) fixedDesktopRules.push(`${selector}{${sectionRules.join(";")}}`);

  const headingRules: string[] = [];
  if (headingSize !== null) headingRules.push(`font-size:${headingSize}px!important`);
  if (headingColor) headingRules.push(`color:${headingColor}!important`);
  if (headingRules.length) fixedDesktopRules.push(`${selector} h1,${selector} h2,${selector} h3{${headingRules.join(";")}}`);

  const bodyRules: string[] = [];
  if (bodySize !== null) bodyRules.push(`font-size:${bodySize}px!important`);
  if (bodyColor) bodyRules.push(`color:${bodyColor}!important`);
  if (bodyRules.length) fixedDesktopRules.push(`${selector} p:not(.eyebrow):not(.service-number),${selector} li{${bodyRules.join(";")}}`);

  if (!preserveHomeHeroSpacing && paddingTop !== null) fixedMobileRules.push(`${selector}{padding-top:min(${paddingTop}px,64px)!important}`);
  if (!preserveHomeHeroSpacing && paddingBottom !== null) fixedMobileRules.push(`${selector}{padding-bottom:min(${paddingBottom}px,64px)!important}`);
  if (headingSize !== null) fixedMobileRules.push(`${selector} h1,${selector} h2,${selector} h3{font-size:min(${headingSize}px,56px)!important}`);
});

const fixedVisualCss = fixedDesktopRules.length
  ? `${fixedDesktopRules.join("\n")}\n${fixedMobileRules.length ? `@media(max-width:820px){${fixedMobileRules.join("\n")}}` : ""}`
  : "";

const aboutEntry = await getEntry("pages", "about");
const teamAuthors = Object.fromEntries(
  (aboutEntry?.data.team ?? []).map((person) => [
    person.name,
    {
      image: person.image,
      imageAlt: person.imageAlt,
      role: person.eyebrow,
    },
  ]),
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#45628E" />
    <link rel="icon" type="image/png" sizes="128x128" href="data:image/png;base64,...TRUNCATED_FOR_TOOL_LIMIT..." />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {type === "article" && publishedIso && <meta property="article:published_time" content={publishedIso} />}
    {type === "article" && modifiedIso && <meta property="article:modified_time" content={modifiedIso} />}
    {type === "article" && author && <meta property="article:author" content={author} />}
    {author && <meta name="author" content={author} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&family=Playfair+Display:ital,wght@0,700;1,700&family=Sora:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="https://use.typekit.net/iij2yik.css" />
    <ThemeSettings />
    {Astro.url.pathname === "/" && <link rel="stylesheet" href="/home-polish.css" />}
    {Astro.url.pathname === "/" && <link rel="stylesheet" href="/home-final-fixes.css" />}
    {Astro.url.pathname === "/" && <script is:inline src="/home-final-fixes.js" defer></script>}
    {Astro.url.pathname === "/about/" && <link rel="stylesheet" href="/about-polish.css" />}
    {Astro.url.pathname === "/services/" && <link rel="stylesheet" href="/services-polish.css" />}
    {Astro.url.pathname === "/services/" && <link rel="stylesheet" href="/services-final-fixes.css" />}
    {Astro.url.pathname === "/news/" && <link rel="stylesheet" href="/news-final-fixes.css" />}
    {Astro.url.pathname === "/whitepapers/" && <link rel="stylesheet" href="/whitepapers-final-fixes.css" />}
    {Astro.url.pathname === "/whitepapers/" && <script is:inline src="/whitepapers-final-fixes.js" defer></script>}
    {Astro.url.pathname.startsWith("/post/") && <link rel="stylesheet" href="/article-final-fixes.css" />}
    {Astro.url.pathname.startsWith("/post/") && <script is:inline src="/article-pdf-download.js" defer></script>}
    <link rel="stylesheet" href="/full-width-fixes.css" />
    {fixedVisualCss && <style is:inline set:html={fixedVisualCss}></style>}
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
      {additionalSections.length > 0 && <PageBuilder sections={additionalSections} />}
    </main>
    <VisualPageEdits visualStyles={fixedVisualStyles} builderSections={visualBuilderSections} />
    <Footer />
    <script is:inline define:vars={{ teamAuthors }}>
      (() => {
        const authorName = document.querySelector(".author-copy strong")?.textContent?.trim();
        if (!authorName || !teamAuthors[authorName]) return;

        const profile = teamAuthors[authorName];
        const photo = document.querySelector(".author-photo");
        const role = document.querySelector(".author-copy span");

        if (photo instanceof HTMLImageElement && profile.image) {
          photo.src = profile.image;
          photo.alt = profile.imageAlt || authorName;
        }

        if (role && profile.role) {
          role.textContent = profile.role;
        }
      })();
    </script>
    <script>
      (() => {
        const typedNavigator = navigator as unknown as Navigator & Record<string, unknown>;
        const typedWindow = window as unknown as Window & Record<string, unknown>;
        const hasGlobalPrivacyControl = typedNavigator["globalPrivacyControl"] === true;
        const hasDoNotTrack =
          typedNavigator.doNotTrack === "1" ||
          typedWindow["doNotTrack"] === "1" ||
          typedNavigator["msDoNotTrack"] === "1";
        const privacySignal = hasGlobalPrivacyControl ? "global_privacy_control" : hasDoNotTrack ? "do_not_track" : "none";

        document.documentElement.toggleAttribute("data-privacy-opt-out", privacySignal !== "none");
        typedWindow["__MTS_PRIVACY_SIGNAL__"] = privacySignal;

        document.querySelectorAll('input[name="browser_privacy_signal"]').forEach((input) => {
          if (input instanceof HTMLInputElement) {
            input.value = privacySignal;
          }
        });
      })();
    </script>
    <script>
      const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");

      if (!motionQuery.matches && "IntersectionObserver" in window) {
        const revealItems = document.querySelectorAll(
          ".hero-copy, .section-heading, .firm-card, .card, .news-card, .media-frame, .service-detail, .team-card",
        );
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -12% 0px", threshold: 0.12 },
        );

        revealItems.forEach((item) => {
          item.setAttribute("data-reveal", "");
          observer.observe(item);
        });
      }
    </script>
  </body>
</html>