---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import { getCollection, getEntry } from "astro:content";

type NewsPageData = {
  eyebrow: string;
  title: string;
  titleAccent: string;
  paragraphs: string[];
};

const newsPage = await getEntry("pages", "news");
if (!newsPage || !newsPage.data.paragraphs) {
  throw new Error("News page content is missing.");
}

const newsPageData = newsPage.data as NewsPageData;
const posts = (await getCollection("posts")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const dateFormat = { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" } as const;
---

<BaseLayout title="News & Insights | Mercier Talent Solutions" description={newsPageData.paragraphs[0]} image="/images/optimized/news-hero-1400.jpg">
  <section class="section news-hero">
    <div class="container hero-grid">
      <div class="section-heading">
        <p class="eyebrow">{newsPageData.eyebrow}</p>
        <h1>{newsPageData.title} <em>{newsPageData.titleAccent}</em></h1>
        <p>{newsPageData.paragraphs.join(" ")}</p>
      </div>
      <div class="media-frame hero-image">
        <ResponsiveImage src="/images/news-hero.png" alt="News and insights visual" sizes="(min-width: 900px) 38vw, 100vw" eager />
      </div>
      <div class="news-shapes" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="posts">
        {posts.map((post) => (
          <a class="card post" href={`/post/${post.slug}/`}>
            <span class="pill">{post.data.category}</span>
            <h2>{post.data.title}</h2>
            <p>{post.data.excerpt}</p>
            <span class="meta-row news-author">
              <img src={post.data.image ?? "/images/julia-mercier.jpg"} alt="" loading="lazy" />
              <span>{post.data.author} · {post.data.pubDate.toLocaleDateString("en-US", dateFormat)}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .news-hero {
    position: relative;
    overflow: hidden;
    padding-bottom: clamp(6rem, 11vw, 9rem);
    background: var(--color-blue-dark);
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.78fr);
    gap: clamp(2.5rem, 6vw, 4.75rem);
    align-items: center;
  }

  .hero-image {
    margin-bottom: clamp(-10rem, -11vw, -6rem);
    aspect-ratio: 1.18;
    border-radius: 0;
    box-shadow: none;
  }

  .news-hero .eyebrow {
    display: inline-flex;
    gap: 14px;
    align-items: center;
    color: rgba(255, 255, 255, 0.68);
  }

  .news-hero .eyebrow::before {
    display: inline-block;
    width: 16px;
    height: 1px;
    background: rgba(255, 255, 255, 0.5);
    content: "";
  }

  .news-hero .section-heading {
    z-index: 1;
    padding-top: clamp(2rem, 4vw, 3rem);
  }

  h1 {
    margin: 0.4rem 0 0;
    color: var(--color-white);
    font-family: var(--font-heading);
    font-size: var(--page-title-size);
    font-weight: 700;
    line-height: 1;
  }

  .news-hero h1 em {
    color: var(--color-blue);
  }

  .news-hero p:not(.eyebrow) {
    color: rgba(255, 255, 255, 0.78);
  }

  .news-shapes {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .news-shapes span {
    position: absolute;
    width: 150px;
    aspect-ratio: 1;
    border: 2px solid rgba(255, 255, 255, 0.12);
    clip-path: polygon(25% 4%, 75% 4%, 100% 50%, 75% 96%, 25% 96%, 0 50%);
  }

  .news-shapes span:nth-child(1) {
    right: 6%;
    top: 0;
  }

  .news-shapes span:nth-child(2) {
    right: -2%;
    bottom: 4%;
  }

  .news-shapes span:nth-child(3) {
    right: 14%;
    bottom: -8%;
  }

  .posts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.35rem);
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .post {
    text-decoration: none;
  }

  .news-author {
    align-items: center;
    gap: 0.7rem;
  }

  .news-author img {
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 30%;
  }

  h2 {
    margin: 0 0 0.55rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    font-weight: 700;
  }

  @media (max-width: 980px) {
    .posts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .hero-grid,
    .posts {
      grid-template-columns: 1fr;
    }

    .hero-image {
      margin-bottom: 0;
    }
  }
</style>
