---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="News & Insights | Mercier Talent Solutions">
  <section class="section news-hero">
    <div class="container hero-grid">
      <div class="section-heading">
        <p class="eyebrow">News & Insights</p>
        <h1>Thinking on modern legal practice</h1>
        <p>Explore our latest thinking on lawyer development, leadership, and the changing legal profession, alongside updates from conferences, presentations, and other speaking engagements. These articles and event highlights share practical ideas, emerging perspectives, and lessons drawn from our work with lawyers, firm leaders, talent professionals, and practice leaders.</p>
        <p>Together, they offer timely insight into the challenges shaping law firms today and the approaches that can help strengthen leadership, collaboration, professional growth, and long-term performance.</p>
      </div>
      <div class="media-frame hero-image">
        <img src="/images/news-hero.png" alt="News and insights visual" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="posts">
        {posts.map((post) => (
          <a class="card post" href={`/post/${post.slug}/`}>
            <span class="pill">{post.data.category}</span>
            <h2>{post.data.title}</h2>
            <p>{post.data.excerpt}</p>
            <span class="meta-row">
              Julia Mercier · {post.data.pubDate.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .news-hero {
    background: var(--color-white);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.78fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .hero-image {
    aspect-ratio: 1.18;
  }

  h1 {
    margin: 0.4rem 0 0;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: clamp(2.8rem, 7vw, 6rem);
    font-weight: 500;
    line-height: 1;
  }

  .posts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }

  .post {
    text-decoration: none;
  }

  h2 {
    margin: 0 0 0.55rem;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    font-weight: 500;
  }

  @media (max-width: 980px) {
    .posts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .hero-grid,
    .posts {
      grid-template-columns: 1fr;
    }
  }
</style>
