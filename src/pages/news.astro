---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, getEntry } from "astro:content";

type NewsPageData = {
  eyebrow: string;
  title: string;
  titleAccent: string;
  paragraphs: string[];
};

const newsPage = await getEntry("pages", "news");
if (!newsPage || !newsPage.data.paragraphs) {
  throw new Error("News page content is missing.");
}

const newsPageData = newsPage.data as NewsPageData;
const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [featuredPost, ...remainingPosts] = posts;
const introText = newsPageData.paragraphs.join(" ");

const dateFormat = {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
} as const;

const categoryClass = (category: string) => {
  if (category === "Speaking") return "pill-speaking";
  if (category === "White Paper") return "pill-whitepaper";
  if (category === "Announcement") return "pill-announcement";
  if (category === "News") return "pill-news";
  return "pill-insight";
};
---

<BaseLayout
  title="News & Insights | Mercier Talent Solutions"
  description={introText}
  image="/images/news-insights-office.jpg"
>
  <section class="news-hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">{newsPageData.eyebrow}</p>
        <div class="hero-rule" aria-hidden="true"></div>
        <h1>
          Thinking on modern legal <em>{newsPageData.titleAccent}</em>
        </h1>
        <p class="hero-intro">{introText}</p>
      </div>
    </div>
  </section>

  <section class="featured-section">
    <div class="container featured-shell">
      {featuredPost ? (
        <>
          <p class="eyebrow section-label" data-reveal>Featured</p>
          <article class="featured-article">
            <div class="featured-copy" data-reveal="left">
              <div class="meta-row">
                <span class={`pill ${categoryClass(featuredPost.data.category)}`}>
                  {featuredPost.data.category}
                </span>
                <time datetime={featuredPost.data.pubDate.toISOString()}>
                  {featuredPost.data.pubDate.toLocaleDateString("en-US", dateFormat)}
                </time>
              </div>

              <h2>{featuredPost.data.title}</h2>
              <p>{featuredPost.data.excerpt}</p>
              <a class="read-more" href={`/post/${featuredPost.slug}/`}>
                Read more <span aria-hidden="true">→</span>
              </a>
            </div>

            <div class="network-panel" data-reveal="right" aria-hidden="true">
              <svg viewBox="0 0 760 620" role="presentation">
                <line class="network-line" x1="128" y1="140" x2="365" y2="292" />
                <line class="network-line" x1="128" y1="140" x2="300" y2="92" />
                <line class="network-line" x1="300" y1="92" x2="542" y2="154" />
                <line class="network-line" x1="542" y1="154" x2="365" y2="292" />
                <line class="network-line" x1="365" y1="292" x2="615" y2="356" />
                <line class="network-line" x1="615" y1="356" x2="500" y2="510" />
                <line class="network-line" x1="500" y1="510" x2="250" y2="500" />
                <line class="network-line" x1="250" y1="500" x2="142" y2="358" />
                <line class="network-line" x1="142" y1="358" x2="365" y2="292" />
                <line class="network-line main" x1="365" y1="292" x2="300" y2="92" />
                <line class="network-line main" x1="365" y1="292" x2="542" y2="154" />
                <line class="network-line main" x1="365" y1="292" x2="615" y2="356" />
                <line class="network-line main" x1="365" y1="292" x2="500" y2="510" />
                <line class="network-line main" x1="365" y1="292" x2="250" y2="500" />
                <line class="network-line main" x1="365" y1="292" x2="142" y2="358" />
                <circle class="center-ring" cx="365" cy="292" r="31" />
                <circle class="node center" cx="365" cy="292" r="12" />
                <circle class="node" cx="128" cy="140" r="8" />
                <circle class="node small" cx="300" cy="92" r="6" />
                <circle class="node" cx="542" cy="154" r="8" />
                <circle class="node small" cx="615" cy="356" r="7" />
                <circle class="node" cx="500" cy="510" r="8" />
                <circle class="node small" cx="250" cy="500" r="6" />
                <circle class="node" cx="142" cy="358" r="7" />
              </svg>
            </div>
          </article>
        </>
      ) : (
        <p>No News & Insights posts are available yet.</p>
      )}
    </div>
  </section>

  {remainingPosts.length > 0 && (
    <section class="other-news">
      <div class="container other-shell">
        <p class="eyebrow other-label" data-reveal>Other News</p>

        <div class="news-list">
          {remainingPosts.map((post) => (
            <article class="news-item" data-reveal>
              <div class="meta-row item-meta">
                <span class={`pill ${categoryClass(post.data.category)}`}>
                  {post.data.category}
                </span>
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString("en-US", dateFormat)}
                </time>
              </div>

              <div class="item-content">
                <h3>{post.data.title}</h3>
                <p>{post.data.excerpt}</p>
              </div>

              <a class="read-more item-link" href={`/post/${post.slug}/`}>
                Read more <span aria-hidden="true">→</span>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<script is:inline>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const revealItems = document.querySelectorAll("[data-reveal]");

  if (!reduced && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
    );

    revealItems.forEach((item) => observer.observe(item));
  } else {
    revealItems.forEach((item) => item.classList.add("is-visible"));
  }

  if (!reduced) {
    const network = document.querySelector(".network-panel svg");
    let ticking = false;

    const updateMotion = () => {
      if (network) {
        const rect = network.getBoundingClientRect();
        const delta = (rect.top + rect.height / 2 - window.innerHeight / 2) / window.innerHeight;
        const y = Math.max(-8, Math.min(8, delta * -8));
        network.style.transform = `translate3d(0, ${y}px, 0) scale(1.045)`;
      }
      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(updateMotion);
      },
      { passive: true },
    );

    window.addEventListener("resize", updateMotion);
    updateMotion();
  }
</script>

<style>
  .news-hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 78% 32%, rgba(69, 98, 142, 0.14), transparent 28%),
      linear-gradient(135deg, #17263f 0%, #1a2b46 72%, #213755 100%);
    color: var(--color-white);
  }

  .hero-inner {
    display: grid;
    width: min(calc(100% - (var(--page-gutter) * 2)), 1380px);
    min-height: clamp(470px, 36vw, 570px);
    align-items: center;
  }

  .hero-copy {
    max-width: 900px;
    padding: clamp(4.1rem, 6vw, 6rem) 0;
    animation: heroIn 900ms var(--ease-soft) both;
  }

  .news-hero .eyebrow {
    color: rgba(255, 255, 255, 0.72);
  }

  .hero-rule {
    width: 82px;
    height: 2px;
    margin: 1.65rem 0 1.75rem;
    background: rgba(255, 255, 255, 0.9);
  }

  .hero-copy h1 {
    max-width: 860px;
    margin: 0 0 1.8rem;
    color: var(--color-white);
    font-family: var(--font-heading);
    font-size: clamp(3.25rem, 5vw, 5.25rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.03;
  }

  .hero-copy h1 em {
    color: #8da0bd;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 700;
  }

  .hero-intro {
    max-width: 760px;
    margin: 0;
    color: rgba(255, 255, 255, 0.86);
    font-size: clamp(16px, 1.05vw, 18px);
    line-height: 1.68;
  }

  .featured-section {
    padding: clamp(4.9rem, 7vw, 7rem) 0;
    background: var(--color-white);
  }

  .featured-shell,
  .other-shell {
    max-width: 1500px;
  }

  .section-label,
  .other-label {
    margin-bottom: 1.8rem;
    color: var(--color-blue);
  }

  .featured-article {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(360px, 0.72fr);
    gap: clamp(2.6rem, 6vw, 5.5rem);
    align-items: center;
    padding: clamp(2.8rem, 4.5vw, 4.25rem) 0;
    border-top: 1px solid var(--color-line);
  }

  .featured-article::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: linear-gradient(90deg, var(--color-line), rgba(221, 220, 215, 0.28), transparent);
    content: "";
  }

  .featured-copy {
    max-width: 830px;
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    align-items: center;
    margin-bottom: 1.45rem;
  }

  .meta-row time {
    border: 0;
    color: var(--color-blue);
    font-family: var(--font-label);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 3.2px;
    text-decoration: none;
    text-transform: uppercase;
    box-shadow: none;
  }

  .pill {
    display: inline-flex;
    min-height: 32px;
    align-items: center;
    border: 2px solid transparent;
    padding: 0.42rem 0.78rem;
    font-family: var(--font-label);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
  }

  .pill-insight {
    border-color: var(--color-blue);
    background: var(--color-white);
    color: var(--color-blue-dark);
  }

  .pill-speaking {
    border-color: var(--color-blue);
    background: var(--color-blue);
    color: var(--color-white);
  }

  .pill-whitepaper {
    border-color: #9aabc2;
    background: var(--color-blue-soft);
    color: var(--color-blue-dark);
  }

  .pill-announcement {
    border-color: var(--color-blue-dark);
    background: var(--color-blue-dark);
    color: var(--color-white);
  }

  .pill-news {
    border-color: #a8adb5;
    background: #efefeb;
    color: var(--color-ink);
  }

  .featured-copy h2 {
    max-width: 790px;
    margin: 0 0 1.35rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 3.5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.06;
  }

  .featured-copy > p,
  .item-content > p {
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(16px, 1.05vw, 18px);
    line-height: 1.7;
  }

  .read-more {
    display: inline-flex;
    width: max-content;
    align-items: center;
    gap: 0.7rem;
    margin-top: 1.9rem;
    border-bottom: 1px solid var(--color-blue-dark);
    padding-bottom: 0.45rem;
    color: var(--color-blue-dark);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: gap 300ms var(--ease-soft), color 220ms ease, border-color 220ms ease;
  }

  .read-more:hover,
  .read-more:focus-visible {
    gap: 1rem;
    border-color: var(--color-blue);
    color: var(--color-blue);
  }

  .network-panel {
    min-height: 375px;
    overflow: visible;
    transform-origin: center;
  }

  .network-panel svg {
    display: block;
    width: 100%;
    min-height: 375px;
    filter: drop-shadow(0 18px 35px rgba(26, 43, 70, 0.12));
    transform: scale(1.045);
    transform-origin: center;
  }

  .network-line {
    stroke: rgba(69, 98, 142, 0.22);
    stroke-width: 1;
  }

  .network-line.main {
    stroke: rgba(69, 98, 142, 0.5);
    stroke-width: 1.25;
    stroke-dasharray: 5 10;
    animation: dash 18s linear infinite;
  }

  .node {
    fill: var(--color-blue);
    transform-box: fill-box;
    transform-origin: center;
    animation: pulse 4s ease-in-out infinite;
  }

  .node.small {
    fill: #8da0bd;
  }

  .node.center {
    fill: var(--color-blue-dark);
  }

  .center-ring {
    fill: none;
    stroke: rgba(26, 43, 70, 0.18);
    stroke-width: 1;
  }

  .other-news {
    padding: clamp(4.9rem, 7vw, 7.25rem) 0 clamp(5.75rem, 8vw, 8rem);
    background: linear-gradient(180deg, #fafaf8 0%, #f7f7f4 100%);
  }

  .news-list {
    border-top: 1px solid var(--color-line);
  }

  .news-item {
    display: grid;
    grid-template-columns: minmax(165px, 0.25fr) minmax(0, 1fr) auto;
    gap: clamp(1.75rem, 4vw, 4.5rem);
    align-items: start;
    padding: clamp(4.25rem, 6vw, 5.75rem) 0;
    border-bottom: 1px solid var(--color-line);
  }

  .item-meta {
    display: grid;
    gap: 1rem;
    align-content: start;
    margin: 0;
  }

  .item-meta .pill {
    width: max-content;
  }

  .item-content {
    display: grid;
    max-width: 850px;
    gap: 1.15rem;
  }

  .item-content h3 {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: clamp(1.45rem, 2vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.16;
    text-decoration: none;
  }

  .item-content > p {
    max-width: 720px;
    font-size: 16px;
    line-height: 1.7;
    text-decoration: none;
  }

  .item-link {
    margin: 0;
    padding-top: 0.2rem;
    white-space: nowrap;
  }

  [data-reveal] {
    opacity: 0;
    transform: translateY(32px);
    transition: opacity 850ms var(--ease-soft), transform 950ms var(--ease-soft);
  }

  [data-reveal="left"] {
    transform: translateX(-42px);
  }

  [data-reveal="right"] {
    transform: translateX(42px);
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: none;
  }

  @keyframes heroIn {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes dash {
    to {
      stroke-dashoffset: -180;
    }
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 0.55;
      transform: scale(0.85);
    }
    50% {
      opacity: 1;
      transform: scale(1.18);
    }
  }

  @media (min-width: 1800px) {
    .hero-inner {
      width: min(calc(100% - (var(--page-gutter) * 2)), 1420px);
    }

    .featured-article {
      grid-template-columns: minmax(0, 820px) minmax(390px, 470px);
      justify-content: space-between;
    }
  }

  @media (max-width: 1080px) {
    .hero-inner {
      width: min(calc(100% - (var(--page-gutter) * 2)), 900px);
    }

    .featured-article {
      grid-template-columns: 1fr;
      gap: 1.8rem;
    }

    .network-panel,
    .network-panel svg {
      min-height: 310px;
    }

    .network-panel {
      width: min(100%, 520px);
    }

    .news-item {
      grid-template-columns: minmax(145px, 0.28fr) minmax(0, 1fr);
      gap: 2rem 2.5rem;
    }

    .item-link {
      grid-column: 2;
      margin-top: 0.25rem;
      justify-self: start;
    }
  }

  @media (max-width: 720px) {
    .hero-inner {
      width: calc(100% - (var(--page-gutter) * 2));
      min-height: 0;
    }

    .hero-copy {
      padding: 3.5rem 0 3.75rem;
    }

    .hero-copy h1 {
      font-size: clamp(2.625rem, 12vw, 3.625rem);
    }

    .featured-section {
      padding: 3.6rem 0 4.4rem;
    }

    .featured-article {
      padding: 2.1rem 0;
    }

    .network-panel,
    .network-panel svg {
      min-height: 255px;
    }

    .network-panel svg {
      transform: scale(1.025);
    }

    .other-news {
      padding: 3.9rem 0 4.75rem;
    }

    .news-item {
      display: block;
      padding: 3.5rem 0;
    }

    .item-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.8rem 1rem;
      margin-bottom: 1.5rem;
    }

    .item-content {
      gap: 1rem;
    }

    .item-content h3 {
      font-size: 1.55rem;
    }

    .item-content > p {
      font-size: 16px;
    }

    .item-link {
      display: inline-flex;
      margin-top: 1.65rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-copy,
    .network-line.main,
    .node,
    [data-reveal] {
      animation: none !important;
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }
</style>
