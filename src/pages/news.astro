---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, getEntry } from "astro:content";

type NewsPageData = {
  eyebrow: string;
  title: string;
  titleAccent: string;
  paragraphs: string[];
};

const newsPage = await getEntry("pages", "news");

if (!newsPage || !newsPage.data.paragraphs) {
  throw new Error("News page content is missing.");
}

const newsPageData = newsPage.data as NewsPageData;

const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const [featuredPost, ...remainingPosts] = posts;

const introText = newsPageData.paragraphs.join(" ");

const dateFormat = {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
} as const;
---

<BaseLayout
  title="News & Insights | Mercier Talent Solutions"
  description={introText}
  image="/images/news-insights-office.jpg"
>
  <!-- HERO -->
  <section class="news-hero">
    <div class="hero-grid">
      <div class="hero-copy reveal">
        <p class="eyebrow">{newsPageData.eyebrow}</p>

        <h1>
          <span class="hero-title-line">Thinking on modern</span>
          <span class="hero-title-line">
            legal <em>{newsPageData.titleAccent}</em>
          </span>
        </h1>
      </div>

      <span class="shape one" aria-hidden="true"></span>
      <span class="shape two" aria-hidden="true"></span>
    </div>
  </section>

  <!-- INTRO IMAGE / COPY -->
  <section class="news-intro">
    <div class="news-intro-grid">
      <div class="intro-copy reveal">
        <p>{introText}</p>
      </div>

      <div class="intro-image reveal">
        <img
          src="/images/news-insights-office.jpg"
          alt="Modern office interior"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- ARTICLES -->
  <section class="posts-section">
    <div class="articles-shell">
      {
        featuredPost ? (
          <>
            <p class="articles-eyebrow reveal">Featured</p>

            <a
              class="featured-article reveal"
              href={`/post/${featuredPost.slug}/`}
            >
              <div class="featured-copy">
                <div class="featured-top">
                  <span class="pill">{featuredPost.data.category}</span>

                  <time
                    class="featured-date"
                    datetime={featuredPost.data.pubDate.toISOString()}
                  >
                    {featuredPost.data.pubDate.toLocaleDateString(
                      "en-US",
                      dateFormat,
                    )}
                  </time>
                </div>

                <h2>{featuredPost.data.title}</h2>

                <p>{featuredPost.data.excerpt}</p>

                <span class="read-more">
                  Read more <span aria-hidden="true">→</span>
                </span>
              </div>

              <!-- ANIMATED NETWORK -->
              <div class="network-panel" aria-hidden="true">
                <div class="network-wrapper" id="featuredNetwork">
                  <svg
                    viewBox="0 0 900 800"
                    preserveAspectRatio="xMidYMid meet"
                    role="img"
                    aria-label="Minimal animated network"
                  >
                    <!-- BACKGROUND CONNECTIONS -->
                    <line
                      class="secondary-line secondary-1"
                      x1="280"
                      y1="250"
                      x2="520"
                      y2="210"
                    />

                    <line
                      class="secondary-line secondary-2"
                      x1="520"
                      y1="210"
                      x2="705"
                      y2="350"
                    />

                    <line
                      class="secondary-line secondary-3"
                      x1="705"
                      y1="350"
                      x2="625"
                      y2="590"
                    />

                    <line
                      class="secondary-line secondary-4"
                      x1="625"
                      y1="590"
                      x2="340"
                      y2="610"
                    />

                    <line
                      class="secondary-line secondary-5"
                      x1="340"
                      y1="610"
                      x2="190"
                      y2="430"
                    />

                    <line
                      class="secondary-line secondary-6"
                      x1="190"
                      y1="430"
                      x2="280"
                      y2="250"
                    />

                    <line
                      class="secondary-line secondary-7"
                      x1="520"
                      y1="210"
                      x2="640"
                      y2="250"
                    />

                    <line
                      class="secondary-line secondary-8"
                      x1="640"
                      y1="250"
                      x2="760"
                      y2="500"
                    />

                    <line
                      class="secondary-line secondary-9"
                      x1="760"
                      y1="500"
                      x2="625"
                      y2="590"
                    />

                    <line
                      class="secondary-line secondary-10"
                      x1="280"
                      y1="250"
                      x2="165"
                      y2="315"
                    />

                    <!-- CONNECTIONS FROM CENTER -->
                    <line
                      class="main-line main-1"
                      x1="455"
                      y1="410"
                      x2="280"
                      y2="250"
                    />

                    <line
                      class="main-line main-2"
                      x1="455"
                      y1="410"
                      x2="520"
                      y2="210"
                    />

                    <line
                      class="main-line main-3"
                      x1="455"
                      y1="410"
                      x2="705"
                      y2="350"
                    />

                    <line
                      class="main-line main-4"
                      x1="455"
                      y1="410"
                      x2="625"
                      y2="590"
                    />

                    <line
                      class="main-line main-5"
                      x1="455"
                      y1="410"
                      x2="340"
                      y2="610"
                    />

                    <line
                      class="main-line main-6"
                      x1="455"
                      y1="410"
                      x2="190"
                      y2="430"
                    />

                    <line
                      class="main-line main-7"
                      x1="455"
                      y1="410"
                      x2="640"
                      y2="250"
                    />

                    <line
                      class="main-line main-8"
                      x1="455"
                      y1="410"
                      x2="760"
                      y2="500"
                    />

                    <line
                      class="main-line main-9"
                      x1="455"
                      y1="410"
                      x2="165"
                      y2="315"
                    />

                    <!-- CENTER -->
                    <circle
                      class="center-ring"
                      cx="455"
                      cy="410"
                      r="28"
                    />

                    <circle
                      class="node center-node"
                      cx="455"
                      cy="410"
                      r="13"
                    />

                    <!-- NODES -->
                    <circle
                      class="node node-1"
                      cx="280"
                      cy="250"
                      r="9"
                    />

                    <circle
                      class="node node-2"
                      cx="520"
                      cy="210"
                      r="7"
                    />

                    <circle
                      class="node node-3"
                      cx="705"
                      cy="350"
                      r="9"
                    />

                    <circle
                      class="node node-4"
                      cx="625"
                      cy="590"
                      r="8"
                    />

                    <circle
                      class="node node-5"
                      cx="340"
                      cy="610"
                      r="7"
                    />

                    <circle
                      class="node node-6"
                      cx="190"
                      cy="430"
                      r="7"
                    />

                    <circle
                      class="node node-7"
                      cx="640"
                      cy="250"
                      r="6"
                    />

                    <circle
                      class="node node-8"
                      cx="760"
                      cy="500"
                      r="6"
                    />

                    <circle
                      class="node node-9"
                      cx="165"
                      cy="315"
                      r="6"
                    />

                    <circle
                      class="node node-10"
                      cx="735"
                      cy="625"
                      r="5"
                    />

                    <circle
                      class="node node-11"
                      cx="230"
                      cy="565"
                      r="5"
                    />
                  </svg>
                </div>
              </div>
            </a>

            {remainingPosts.length > 0 && (
              <>
                <p class="articles-eyebrow other-news-eyebrow reveal">
                  Other News
                </p>

                <div class="carousel-shell">
                  <button
                    class="carousel-control prev"
                    type="button"
                    data-carousel-prev
                    aria-label="Previous articles"
                  >
                    ←
                  </button>

                  <div
                    class="article-carousel"
                    id="articleCarousel"
                  >
                    {remainingPosts.map((post) => (
                      <a
                        class="article-card reveal"
                        href={`/post/${post.slug}/`}
                      >
                        <div class="card-top">
                          <span
                            class={`pill ${
                              post.data.category === "Speaking"
                                ? "filled"
                                : ""
                            }`}
                          >
                            {post.data.category}
                          </span>

                          <time
                            class="card-date"
                            datetime={post.data.pubDate.toISOString()}
                          >
                            {post.data.pubDate.toLocaleDateString(
                              "en-US",
                              dateFormat,
                            )}
                          </time>
                        </div>

                        <h3>{post.data.title}</h3>

                        <p>{post.data.excerpt}</p>

                        <span class="read-more">
                          Read more <span aria-hidden="true">→</span>
                        </span>
                      </a>
                    ))}
                  </div>

                  <button
                    class="carousel-control next"
                    type="button"
                    data-carousel-next
                    aria-label="Next articles"
                  >
                    →
                  </button>
                </div>
              </>
            )}
          </>
        ) : (
          <p class="empty-state">
            No News & Insights posts are available yet.
          </p>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .news-hero {
    position: relative;
    overflow: hidden;
    height: 560px;
    min-height: 560px;
    padding: 0;
    background: var(--color-blue-dark);
    color: var(--color-white);
  }

  .hero-grid {
    position: relative;
    display: grid;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0 var(--page-gutter);
    grid-template-columns: minmax(420px, 42vw) minmax(0, 1fr);
    align-items: center;
  }

  .news-hero .eyebrow {
    color: rgba(255, 255, 255, 0.7);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 5.2px;
  }

  .hero-title-line {
    display: block;
    white-space: nowrap;
  }

  .hero-copy h1 {
    max-width: 580px;
    margin: 1.15rem 0 0;
    color: var(--color-white);
    font-family: var(--font-heading);
    font-size: clamp(2.55rem, 3.25vw, 4.1rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .hero-copy h1 em {
    color: #8da0bd;
    font-family: var(--font-serif);
    font-style: italic;
  }

  .shape {
    position: absolute;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 50%;
    pointer-events: none;
  }

  .shape.one {
    width: 250px;
    height: 250px;
    right: 88px;
    top: 82px;
  }

  .shape.two {
    width: 155px;
    height: 155px;
    right: 235px;
    top: 205px;
  }

  .news-intro {
    width: 100%;
    background: var(--color-white);
    color: var(--color-ink);
  }

  .news-intro-grid {
    display: grid;
    grid-template-columns:
      minmax(0, 1.55fr)
      minmax(360px, 0.85fr);
    width: 100%;
    min-height: 105px;
    align-items: stretch;
  }

  .intro-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding:
      0.55rem
      clamp(1.75rem, 2.5vw, 2.5rem)
      0.55rem
      var(--page-gutter);
  }

  .intro-copy p {
    width: min(100%, 980px);
    margin: 0;
    color: var(--color-ink);
    font-size: 16px;
    line-height: 1.42;
  }

  .intro-image {
    width: 100%;
    height: 100%;
    min-height: 105px;
    overflow: hidden;
    clip-path: polygon(
      6% 0,
      100% 0,
      100% 100%,
      0 100%
    );
  }

  .intro-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 78%;
    transform: scale(1.16);
    transform-origin: center bottom;
  }

  .posts-section {
    padding:
      clamp(4.5rem, 7vw, 7rem)
      var(--page-gutter);
    background: var(--color-paper);
  }

  .articles-shell {
    width: 100%;
    margin: 0;
  }

  .articles-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin: 0 0 1.25rem;
    color: var(--color-blue);
    font-family: var(--font-label);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 7px;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .articles-eyebrow::before {
    display: inline-block;
    width: 16px;
    height: 1px;
    flex: 0 0 16px;
    background: var(--color-blue);
    content: "";
  }

  .other-news-eyebrow {
    margin-top: clamp(2.8rem, 4.5vw, 4rem);
    margin-bottom: 1.35rem;
  }

  .featured-article {
    display: grid;
    grid-template-columns:
      minmax(0, 1.28fr)
      minmax(320px, 0.72fr);
    min-height: 420px;
    overflow: hidden;
    background: var(--color-white);
    color: inherit;
    text-decoration: none;
    box-shadow:
      0 10px 28px
      rgba(20, 28, 38, 0.035);
  }

  .featured-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2.7rem, 4.5vw, 4.3rem);
  }

  .featured-top,
  .card-top {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .featured-date,
  .card-date {
    color: var(--color-muted);
    font-size: 0.78rem;
  }

  .featured-copy h2 {
    max-width: 760px;
    margin: 1.25rem 0 1rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: clamp(2.35rem, 3.4vw, 4rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .featured-copy p {
    max-width: 700px;
    margin: 0;
    color: var(--color-ink);
    font-size: 16px;
    line-height: 1.55;
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    width: max-content;
    margin-top: 1.9rem;
    color: var(--color-blue);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* NETWORK */

  .network-panel {
    position: relative;
    min-height: 100%;
    overflow: hidden;
    background: var(--color-blue-dark);
  }

  .network-wrapper {
    display: flex;
    width: 100%;
    height: 100%;
    min-height: 420px;
    align-items: stretch;
    justify-content: stretch;
    background: var(--color-blue-dark);
  }

  .network-wrapper svg {
    display: block;
    width: 100%;
    height: 100%;
    transform: translateZ(0);
    contain: paint;
  }

  .network-wrapper .main-line,
  .network-wrapper .secondary-line {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1000;
    stroke-dashoffset: 1000;
    vector-effect: non-scaling-stroke;
    will-change: opacity, stroke-dashoffset;
    backface-visibility: hidden;
  }

  .network-wrapper .main-line {
    stroke: rgba(242, 240, 235, 0.78);
    stroke-width: 1.6;
  }

  .network-wrapper .secondary-line {
    stroke: rgba(141, 160, 189, 0.28);
    stroke-width: 1.2;
    opacity: 0.75;
  }

  .network-wrapper .node {
    fill: #f2f0eb;
    stroke: rgba(255, 255, 255, 0.12);
    stroke-width: 1.5;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0);
    will-change: transform, opacity;
    backface-visibility: hidden;
  }

  .network-wrapper .center-ring {
    fill: none;
    stroke: rgba(141, 160, 189, 0.42);
    stroke-width: 1.5;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.5);
    will-change: transform, opacity;
    backface-visibility: hidden;
  }

  /*
    Start with the center dot, then let the lines flow
    outward continuously. Each next dot fades in as its
    connection reaches it.
  */

  .network-wrapper.animate .center-node {
    animation:
      revealNode
      0.72s
      cubic-bezier(0.22, 0.68, 0.24, 1)
      forwards;
  }

  .network-wrapper.animate .center-ring {
    animation:
      revealRing
      1.08s
      cubic-bezier(0.22, 0.68, 0.24, 1)
      forwards;
    animation-delay: 0.06s;
  }

  .network-wrapper.animate .main-1 {
    animation:
      drawLine
      1.48s
      cubic-bezier(0.32, 0.02, 0.18, 1)
      forwards;
    animation-delay: 0.22s;
  }

  .network-wrapper.animate .node-1 {
    animation:
      revealNode
      0.62s
      cubic-bezier(0.22, 0.68, 0.24, 1)
      forwards;
    animation-delay: 1.28s;
  }

  .network-wrapper.animate .main-2 {
    animation:
      drawLine
      1.5s
      cubic-bezier(0.32, 0.02, 0.18, 1)
      forwards;
    animation-delay: 0.38s;
  }

  .network-wrapper.animate .node-2 {
    animation:
      revealNode
      0.62s
      cubic-bezier(0.22, 0.68, 0.24, 1)
      forwards;
    animation-delay: 1.44s;
  }

  .network-wrapper.animate .main-3 {
    animation:
      drawLine
      1.52s
      cubic-bezier(0.32, 0.02, 0.18, 1)
      forwards;
    animation-delay: 0.54s;
  }

  .network-wrapper.animate .node-3 {
    animation:
      revealNode
      0.62s
      cubic-bezier(0.22, 0.68, 0.24, 1)
      forwards;
    animation-delay: 1.6s;
  }

  .network-wrapper.animate .main-4 {
    animation:
      drawLine
      1.54s
      cubic-bezier(0.32, 0.02, 0.18, 1)
      forwards;
    animation-delay: 0.7s;
  }

  .network-wrapper.animate .node-4 {
    animation:
      revealNode
      0.62s
      cubic-bezier(0.22, 0.68, 0.24, 1)
      forwards;
    animation-delay: 1.76s;
  }

  .network-wrapper.animate .main-5 {
    animation:
      drawLine
      1.56s
      cubic-bezier(0.32, 0.02, 0.18, 1)
      forwards;
    animation-delay: 0.86s;
  }

  .network-wrapper.animate .node-5 {
    animation:
      revealNode
      0.62s
      cubic-bezier(0.22, 0.68, 0.24, 1)
      forwards;
    animation-delay: 1.92s;
  }

  .network-wrapper.animate .main-6 {
    animation:
      drawLine
      1.58s
      cubic-bezier(0.32, 0.02, 0.18, 1)
      forwards;
    animation-delay: 1.02s;
  }

  .network-wrapper.animate .node-6 {
    animation:
      revealNode
      0.62s
      cubic-bezier(0.22, 0.68, 0.24, 1)
      forwards;
    animation-delay: 2.08s;
  }

  .network-wrapper.animate .main-7 {
    animation:
      drawLine
      1.6s
      cubic-bezier(0.32, 0.02, 0.18, 1)
      forwards;
    animation-delay: 1.18s;
  }

  .network-wrapper.animate .node-7 {
    animation:
      revealNode
      0.62s
      cubic-bezier(0.22, 0.68, 0.24, 1)
      forwards;
    animation-delay: 2.24s;
  }

  .network-wrapper.animate .main-8 {
    animation:
      drawLine
      1.62s
      cubic-bezier(0.32, 0.02, 0.18, 1)
      forwards;
    animation-delay: 1.34s;
  }

  .network-wrapper.animate .node-8 {
    animation:
      revealNode
      0.62s
      cubic-bezier(0.22, 0.68, 0.24, 1)
      forwards;
    animation-delay: 2.4s;
  }

  .network-wrapper.animate .main-9 {
    animation:
      drawLine
      1.64s
      cubic-bezier(0.32, 0.02, 0.18, 1)
      forwards;
    animation-delay: 1.5s;
  }

  .network-wrapper.animate .node-9 {
    animation:
      revealNode
      0.62s
      cubic-bezier(0.22, 0.68, 0.24, 1)
      forwards;
    animation-delay: 2.56s;
  }

  /*
    Secondary connections start while the primary lines are
    still moving so the sequence feels continuous rather than
    like a separate second stage.
  */

  .network-wrapper.animate .secondary-line {
    animation:
      drawSecondary
      1.78s
      cubic-bezier(0.32, 0.02, 0.18, 1)
      forwards;
  }

  .network-wrapper.animate .secondary-1 {
    animation-delay: 1.56s;
  }

  .network-wrapper.animate .secondary-2 {
    animation-delay: 1.66s;
  }

  .network-wrapper.animate .secondary-3 {
    animation-delay: 1.76s;
  }

  .network-wrapper.animate .secondary-4 {
    animation-delay: 1.86s;
  }

  .network-wrapper.animate .secondary-5 {
    animation-delay: 1.96s;
  }

  .network-wrapper.animate .secondary-6 {
    animation-delay: 2.06s;
  }

  .network-wrapper.animate .secondary-7 {
    animation-delay: 2.16s;
  }

  .network-wrapper.animate .secondary-8 {
    animation-delay: 2.26s;
  }

  .network-wrapper.animate .secondary-9 {
    animation-delay: 2.36s;
  }

  .network-wrapper.animate .secondary-10 {
    animation-delay: 2.46s;
  }

  .network-wrapper.animate .node-10 {
    animation:
      revealNode
      0.62s
      cubic-bezier(0.22, 0.68, 0.24, 1)
      forwards;
    animation-delay: 2.74s;
  }

  .network-wrapper.animate .node-11 {
    animation:
      revealNode
      0.62s
      cubic-bezier(0.22, 0.68, 0.24, 1)
      forwards;
    animation-delay: 2.88s;
  }

  @keyframes drawLine {
    0% {
      stroke-dashoffset: 1000;
      opacity: 0;
    }

    16% {
      opacity: 0.18;
    }

    70% {
      opacity: 0.76;
    }

    100% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
  }

  @keyframes drawSecondary {
    0% {
      stroke-dashoffset: 1000;
      opacity: 0;
    }

    18% {
      opacity: 0.08;
    }

    72% {
      opacity: 0.46;
    }

    100% {
      stroke-dashoffset: 0;
      opacity: 0.9;
    }
  }

  @keyframes revealNode {
    0% {
      opacity: 0;
      transform: scale(0.86);
    }

    52% {
      opacity: 0.52;
      transform: scale(0.95);
    }

    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes revealRing {
    0% {
      opacity: 0;
      transform: scale(0.86);
    }

    100% {
      opacity: 0.9;
      transform: scale(1);
    }
  }

  /* CAROUSEL */

  .carousel-shell {
    position: relative;
    display: grid;
    grid-template-columns:
      auto
      minmax(0, 1fr)
      auto;
    gap: 1rem;
    align-items: center;
