</style>

<script>
  const featuredNetwork =
    document.getElementById("featuredNetwork");

  if (featuredNetwork) {
    const startNetworkAnimation = () => {
      if (
        featuredNetwork.classList.contains("animate")
      ) {
        return;
      }

      requestAnimationFrame(() => {
        featuredNetwork.classList.add("animate");
      });
    };

    if ("IntersectionObserver" in window) {
      const networkObserver =
        new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                startNetworkAnimation();
                observer.unobserve(entry.target);
              }
            });
          },
          {
            threshold: 0.35,
          },
        );

      networkObserver.observe(featuredNetwork);
    } else {
      startNetworkAnimation();
    }
  }
</script>

<script>
  (() => {
    const carousel =
      document.getElementById("articleCarousel");

    const prev =
      document.querySelector(
        "[data-carousel-prev]",
      );

    const next =
      document.querySelector(
        "[data-carousel-next]",
      );

    if (!(carousel instanceof HTMLElement)) {
      return;
    }

    if (!(prev instanceof HTMLButtonElement)) {
      return;
    }

    if (!(next instanceof HTMLButtonElement)) {
      return;
    }

    const cardStep = () => {
      const card =
        carousel.querySelector(".article-card");

      if (!(card instanceof HTMLElement)) {
        return Math.max(
          320,
          carousel.clientWidth * 0.8,
        );
      }

      const styles =
        getComputedStyle(carousel);

      const gap =
        Number.parseFloat(
          styles.gap ||
            styles.columnGap ||
            "0",
        );

      return (
        card.getBoundingClientRect().width +
        gap
      );
    };

    const updateButtons = () => {
      const max = Math.max(
        0,
        carousel.scrollWidth -
          carousel.clientWidth,
      );

      prev.disabled =
        carousel.scrollLeft <= 4;

      next.disabled =
        carousel.scrollLeft >= max - 4;
    };

    prev.addEventListener(
      "click",
      () => {
        carousel.scrollBy({
          left: -cardStep(),
          behavior: "smooth",
        });
      },
    );

    next.addEventListener(
      "click",
      () => {
        carousel.scrollBy({
          left: cardStep(),
          behavior: "smooth",
        });
      },
    );

    carousel.addEventListener(
      "scroll",
      updateButtons,
      {
        passive: true,
      },
    );

    window.addEventListener(
      "resize",
      updateButtons,
    );

    requestAnimationFrame(updateButtons);

    setTimeout(
      updateButtons,
      250,
    );
  })();
</script>
