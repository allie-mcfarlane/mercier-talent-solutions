---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import { getCollection, getEntry } from "astro:content";

type NewsPageData = {
  eyebrow: string;
  title: string;
  titleAccent: string;
  paragraphs: string[];
};

const newsPage = await getEntry("pages", "news");
if (!newsPage || !newsPage.data.paragraphs) {
  throw new Error("News page content is missing.");
}

const newsPageData = newsPage.data as NewsPageData;
const posts = (await getCollection("posts")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="News & Insights | Mercier Talent Solutions" image="/images/optimized/news-hero-1400.jpg">
  <section class="section news-hero">
    <div class="container hero-grid">
      <div class="section-heading">
        <p class="eyebrow">{newsPageData.eyebrow}</p>
        <h1>{newsPageData.title} <em>{newsPageData.titleAccent}</em></h1>
        {newsPageData.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <div class="media-frame hero-image">
        <ResponsiveImage src="/images/news-hero.png" alt="News and insights visual" sizes="(min-width: 900px) 38vw, 100vw" eager />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="posts">
        {posts.map((post) => (
          <a class="card post" href={`/post/${post.slug}/`}>
            <span class="pill">{post.data.category}</span>
            <h2>{post.data.title}</h2>
            <p>{post.data.excerpt}</p>
            <span class="meta-row">
              Julia Mercier · {post.data.pubDate.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .news-hero {
    background: var(--color-white);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.78fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .hero-image {
    aspect-ratio: 1.18;
  }

  h1 {
    margin: 0.4rem 0 0;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: var(--page-title-size);
    font-weight: 700;
    line-height: 1;
  }

  .posts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }

  .post {
    text-decoration: none;
  }

  h2 {
    margin: 0 0 0.55rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    font-weight: 700;
  }

  @media (max-width: 980px) {
    .posts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .hero-grid,
    .posts {
      grid-template-columns: 1fr;
    }
  }
</style>
