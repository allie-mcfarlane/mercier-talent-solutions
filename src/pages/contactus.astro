---
import BaseLayout from "../layouts/BaseLayout.astro";
import Turnstile from "../components/Turnstile.astro";
import { site } from "../data/site";
import { getEntry } from "astro:content";

type ContactData = {
  eyebrow: string;
  title: string;
  titleAccent: string;
  contacts: { name: string; email: string; phone: string; linkedin?: string }[];
};

const contact = await getEntry("pages", "contact");
if (!contact || !contact.data.contacts) {
  throw new Error("Contact page content is missing.");
}

const contactData = contact.data as ContactData;
const formEndpoint = `https://formsubmit.co/${site.email}`;
const description = "Contact Mercier Talent Solutions for executive coaching, assessments, training, and consulting for law firms.";
---

<BaseLayout title="Contact Us | Mercier Talent Solutions" description={description} image="/images/optimized/contact-hero-1400.jpg">
  <section class="section contact-hero">
    <div class="container contact-grid">
      <div>
        <h1>{contactData.title} <em>{contactData.titleAccent}</em></h1>
      </div>
      <div class="media-frame contact-image">
        <img src="/images/contact-hero.png" alt="Modern office lounge and reception area" loading="eager" decoding="async" />
      </div>
    </div>
    <div class="container direct">
      {contactData.contacts.map((person, index) => (
        <div class="contact-person">
          <p class="eyebrow">{index === 0 ? "Principal" : "Practice Manager"}</p>
          <p>
            <strong>{person.name}</strong><br />
            <a href={`mailto:${person.email}`}>{person.email}</a><br />
            <a href={`tel:${person.phone.replaceAll(/[^\d+]/g, "")}`}>{person.phone}</a><br />
            {person.linkedin && <a href={person.linkedin}>LinkedIn</a>}
          </p>
        </div>
      ))}
    </div>
  </section>

  <section class="section contact-form-band">
    <div class="container form-wrap">
      <form action={formEndpoint} method="POST">
        <input type="hidden" name="_subject" value="Mercier Talent Solutions Contact Form" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="form_name" value="Contact Us" />
        <input type="hidden" name="browser_privacy_signal" value="none" />
        <input class="honeypot" type="text" name="_honey" tabindex="-1" autocomplete="off" />
        <label>FIRST NAME <input type="text" name="first_name" /></label>
        <label>LAST NAME <input type="text" name="last_name" /></label>
        <label>EMAIL* <input type="email" name="email" required /></label>
        <label>MESSAGE <textarea name="message" rows="6"></textarea></label>
        <Turnstile />
        <button class="button" type="submit">Submit</button>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero {
    background: var(--color-white);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(300px, 0.78fr);
    gap: clamp(2.5rem, 6vw, 4.75rem);
    align-items: center;
  }

  h1 {
    margin: 0 0 2.3rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: var(--page-title-size);
    font-weight: 700;
    line-height: 1;
  }

  .direct {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.2rem, 3vw, 1.75rem);
    margin-top: clamp(3.5rem, 8vw, 6.25rem);
    color: var(--color-muted);
  }

  .contact-person p:not(.eyebrow) {
    margin: 0.4rem 0 0;
  }

  .contact-person strong {
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: 1.22rem;
  }

  .contact-person a {
    color: var(--color-muted);
    text-decoration: none;
  }

  .contact-person a:hover,
  .contact-person a:focus-visible {
    color: var(--color-blue);
    text-decoration: underline;
  }

  .contact-image {
    aspect-ratio: 499 / 369;
  }

  .contact-form-band {
    background: var(--color-paper);
  }

  .form-wrap {
    display: grid;
    justify-items: end;
  }

  form {
    display: grid;
    width: min(100%, 680px);
    gap: 1.1rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-white);
    padding: clamp(1.35rem, 3vw, 2.15rem);
  }

  label {
    display: grid;
    gap: 0.35rem;
    color: var(--color-blue);
    font-family: var(--font-label);
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.5px;
  }

  input,
  textarea {
    width: 100%;
    border: 1px solid var(--color-line);
    border-radius: 6px;
    padding: 0.85rem;
    font: inherit;
  }

  textarea {
    resize: vertical;
  }

  button {
    border: 0;
    cursor: pointer;
  }

  .honeypot {
    display: none;
  }

  @media (max-width: 800px) {
    .contact-grid,
    .form-wrap,
    .direct {
      grid-template-columns: 1fr;
      justify-items: stretch;
    }
  }
</style>
