---
import BaseLayout from "../layouts/BaseLayout.astro";
import Turnstile from "../components/Turnstile.astro";
import { getEntry } from "astro:content";

type ContactData = {
  eyebrow: string;
  title: string;
  titleAccent: string;
  contacts: {
    name: string;
    email: string;
    phone: string;
    linkedin?: string;
  }[];
};

const contact = await getEntry("pages", "contact");

if (!contact || !contact.data.contacts) {
  throw new Error("Contact page content is missing.");
}

const contactData = contact.data as ContactData;

const formEndpoint = "/api/contact";

const description =
  "Contact Mercier Talent Solutions for executive coaching, assessments, training, and consulting for law firms.";
---

<BaseLayout
  title="Contact Us | Mercier Talent Solutions"
  description={description}
  image="/images/optimized/contact-hero-1400.jpg"
>
  <section class="contact-hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">{contactData.eyebrow}</p>

        <h1>
          {contactData.title} <em>{contactData.titleAccent}</em>
        </h1>

        <p class="hero-lede">
          We partner with law firms and legal professionals on coaching,
          assessments, training, and consulting engagements designed around
          the realities of legal practice.
        </p>
      </div>
    </div>
  </section>

  <section class="contact-section">
    <div class="container contact-grid">
      <aside class="direct-panel" data-contact-reveal="left">
        <p class="eyebrow">Direct contact</p>

        <div class="direct-list">
          {
            contactData.contacts.map((person, index) => {
              const isJulia = person.name === "Julia Mercier";
              const isAllie = person.name === "Allie McFarlane";

              const linkedin = isJulia
                ? "https://www.linkedin.com/in/juliamercier/"
                : isAllie
                  ? "https://www.linkedin.com/in/allieemcfarlane/"
                  : person.linkedin;

              return (
                <div class="contact-person">
                  <p class="person-role">
                    {index === 0 ? "Principal" : "Practice Manager"}
                  </p>

                  <strong>{person.name}</strong>

                  <a href={`mailto:${person.email}`}>
                    {person.email}
                  </a>

                  <a
                    href={`tel:${person.phone.replaceAll(/[^\d+]/g, "")}`}
                  >
                    {person.phone}
                  </a>

                  {
                    linkedin && (
                      <a
                        href={linkedin}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        LinkedIn
                      </a>
                    )
                  }
                </div>
              );
            })
          }
        </div>
      </aside>

      <div class="form-wrap" data-contact-reveal="right">
        <div class="form-heading">
          <h2>Contact us</h2>
        </div>

        <form action={formEndpoint} method="POST" data-contact-form>
          <input
            type="hidden"
            name="form_name"
            value="Contact Us"
          />

          <input
            type="hidden"
            name="browser_privacy_signal"
            value="none"
          />

          <input
            type="hidden"
            name="form_started_at"
            data-form-started-at
          />

          <input
            class="honeypot"
            type="text"
            name="company_website"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />

          <div class="form-grid">
            <label>
              FIRST NAME
              <input
                type="text"
                name="first_name"
                autocomplete="given-name"
              />
            </label>

            <label>
              LAST NAME
              <input
                type="text"
                name="last_name"
                autocomplete="family-name"
              />
            </label>

            <label class="full">
              EMAIL*
              <input
                type="email"
                name="email"
                autocomplete="email"
                required
              />
            </label>

            <label class="full">
              I'M INTERESTED IN

              <select name="interest" data-contact-interest>
                <option value=""></option>
                <option>Executive Coaching</option>
                <option>Assessments</option>
                <option>Training</option>
                <option>Consulting</option>
                <option>White Papers</option>
                <option>Other</option>
              </select>
            </label>

            <label class="full">
              MESSAGE
              <textarea
                name="message"
                rows="6"
                data-contact-message
              ></textarea>
            </label>

            <div class="full turnstile-wrap">
              <Turnstile />
            </div>

            <button
              class="button submit-button full"
              type="submit"
            >
              Submit
            </button>
          </div>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid rgba(221, 220, 215, 0.85);
    background:
      linear-gradient(135deg, #fafaf8 0%, #f1f1ec 100%);
  }

  .hero-inner {
    display: grid;
    width: min(
      calc(100% - (var(--page-gutter) * 2)),
      1380px
    );
    min-height: clamp(440px, 34vw, 540px);
    margin-inline: auto;
    padding: clamp(4.25rem, 6.5vw, 6.125rem) 0;
    align-items: center;
  }

  .hero-copy {
    max-width: 920px;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin: 0;
    color: var(--color-blue);
    font-family: var(--font-label);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 5.5px;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .eyebrow::before {
    width: 18px;
    height: 1px;
    flex: 0 0 18px;
    background: currentColor;
    content: "";
  }

  .contact-hero .eyebrow {
    margin-bottom: clamp(1.9rem, 2.5vw, 2.35rem);
  }

  h1 {
    max-width: 880px;
    margin: 0 0 1.75rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: clamp(52px, 5vw, 84px);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.03;
  }

  h1 em {
    color: var(--color-blue);
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 700;
  }

  .hero-lede {
    max-width: 720px;
    margin: 0;
    color: #000;
    font-size: clamp(17px, 1.15vw, 19px);
    line-height: 1.68;
  }

  .contact-section {
    padding:
      clamp(5.125rem, 8vw, 8rem)
      0
      clamp(6rem, 9vw, 9.0625rem);
    background: var(--color-white);
  }

  .contact-grid {
    display: grid;
    grid-template-columns:
      minmax(280px, 0.62fr)
      minmax(0, 1.38fr);
    gap: clamp(3.5rem, 8vw, 8rem);
    align-items: start;
    width: min(
      calc(100% - (var(--page-gutter) * 2)),
      1500px
    );
    margin-inline: auto;
  }

  .direct-panel {
    position: sticky;
    top: 120px;
    padding-top: 0;
  }

  .direct-list {
    display: grid;
    margin-top: 1.75rem;
    border-top: 1px solid var(--color-line);
  }

  .contact-person {
    display: grid;
    justify-items: start;
    padding: 1.45rem 0 1.625rem;
    border-bottom: 1px solid var(--color-line);
  }

  .person-role {
    margin: 0 0 0.5rem;
    color: var(--color-blue);
    font-family: var(--font-label);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.13em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .contact-person strong {
    display: block;
    margin-bottom: 0.45rem;
    color: #000;
    font-family: var(--font-heading);
    font-size: 18px;
    line-height: 1.35;
  }

  .contact-person a {
    display: block;
    width: max-content;
    max-width: 100%;
    color: #000;
    font-size: 15px;
    line-height: 1.75;
    text-decoration: none;
    text-underline-offset: 3px;
  }

  .contact-person a:hover,
  .contact-person a:focus-visible {
    color: var(--color-blue);
    text-decoration: underline;
  }

  .form-wrap {
    position: relative;
    padding-left: clamp(2rem, 5vw, 4.875rem);
    border-left: 1px solid var(--color-line);
  }

  .form-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.875rem;
    margin-bottom: 2.125rem;
    padding-bottom: 1.5625rem;
    border-bottom: 1px solid var(--color-line);
  }

  .form-heading h2 {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: clamp(34px, 3vw, 48px);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.08;
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.625rem 1.75rem;
  }

  .full {
    grid-column: 1 / -1;
  }

  label {
    display: grid;
    gap: 0.625rem;
    color: var(--color-blue);
    font-family: var(--font-label);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.2;
  }

  input,
  select,
  textarea {
    width: 100%;
    border: 0;
    border-bottom: 1px solid #bdb8ae;
    border-radius: 0;
    background: transparent;
    padding: 0.75rem 0 0.8125rem;
    color: #000;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.45;
    transition:
      border-color 220ms ease,
      background 220ms ease;
  }

  input:focus,
  select:focus,
  textarea:focus {
    border-color: var(--color-blue);
    outline: none;
    background: rgba(232, 237, 244, 0.22);
  }

  select {
    cursor: pointer;
  }

  textarea {
    min-height: 135px;
    resize: vertical;
  }

  .turnstile-wrap {
    min-width: 0;
  }

  .turnstile-wrap :global(.form-note) {
    margin: 0;
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.5;
  }

  .submit-button {
    width: max-content;
    min-width: 148px;
    min-height: 45px;
    border: 1px solid var(--color-blue-dark);
    background: var(--color-blue-dark);
    color: var(--color-white);
    cursor: pointer;
    transition:
      transform 250ms var(--ease-smooth),
      background 250ms var(--ease-smooth),
      border-color 250ms var(--ease-smooth);
  }

  .submit-button:hover,
  .submit-button:focus-visible {
    transform: translateY(-2px);
    border-color: var(--color-blue);
    background: var(--color-blue);
  }

  .honeypot {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    overflow: hidden !important;
    clip: rect(0 0 0 0) !important;
    clip-path: inset(50%) !important;
    white-space: nowrap !important;
  }

  [data-contact-reveal] {
    opacity: 0;
    transform: translateY(34px);
    transition:
      opacity 850ms var(--ease-soft),
      transform 950ms var(--ease-soft);
  }

  [data-contact-reveal="left"] {
    transform: translateX(-42px);
  }

  [data-contact-reveal="right"] {
    transform: translateX(42px);
  }

  [data-contact-reveal].is-visible {
    opacity: 1;
    transform: none;
  }

  .hero-copy {
    animation: contactHeroIn 950ms var(--ease-soft) both;
  }

  @keyframes contactHeroIn {
    from {
      opacity: 0;
      transform: translateY(24px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (min-width: 1800px) {
    .hero-inner {
      min-height: 540px;
      max-width: 1380px;
    }

    .contact-grid {
      max-width: 1500px;
    }
  }

  @media (max-width: 1050px) {
    .hero-inner {
      width: min(
        calc(100% - (var(--page-gutter) * 2)),
        900px
      );
      min-height: 0;
      padding: 4rem 0 4.375rem;
    }

    .contact-grid {
      grid-template-columns: 1fr;
      gap: 3.625rem;
    }

    .direct-panel {
      position: static;
      max-width: 760px;
    }

    .direct-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      border-bottom: 1px solid var(--color-line);
    }

    .contact-person {
      padding: 1.45rem 1.5rem 1.625rem 0;
      border-bottom: 0;
    }

    .contact-person + .contact-person {
      padding-left: 1.75rem;
      border-left: 1px solid var(--color-line);
    }

    .form-wrap {
      padding-left: 0;
      border-left: 0;
    }
  }

  @media (max-width: 680px) {
    .hero-inner {
      width: calc(100% - (var(--page-gutter) * 2));
      padding: 3.375rem 0 3.75rem;
    }

    .contact-hero .eyebrow {
      margin-bottom: 1.75rem;
    }

    h1 {
      margin-bottom: 1.5rem;
      font-size: clamp(42px, 12vw, 58px);
    }

    .hero-lede {
      font-size: 16px;
      line-height: 1.63;
    }

    .contact-section {
      padding: 4rem 0 4.875rem;
    }

    .direct-list {
      grid-template-columns: 1fr;
    }

    .contact-person {
      padding: 1.3125rem 0 1.4375rem !important;
      border-bottom: 1px solid var(--color-line);
      border-left: 0 !important;
    }

    .form-heading {
      margin-bottom: 1.6875rem;
    }

    .form-heading h2 {
      font-size: 34px;
    }

    .form-grid {
      grid-template-columns: 1fr;
      gap: 1.4375rem;
    }

    .full {
      grid-column: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-copy,
    [data-contact-reveal] {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  const reducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  const revealItems = document.querySelectorAll(
    "[data-contact-reveal]",
  );

  if (!reducedMotion && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.12,
        rootMargin: "0px 0px -8% 0px",
      },
    );

    revealItems.forEach((item) => observer.observe(item));
  } else {
    revealItems.forEach((item) => item.classList.add("is-visible"));
  }

  const contactForm = document.querySelector("[data-contact-form]");
  const startedAt = contactForm?.querySelector("[data-form-started-at]");
  const interest = contactForm?.querySelector("[data-contact-interest]");
  const message = contactForm?.querySelector("[data-contact-message]");

  if (startedAt instanceof HTMLInputElement) {
    startedAt.value = String(Date.now());
  }

  const clearDetailsError = () => {
    if (message instanceof HTMLTextAreaElement) {
      message.setCustomValidity("");
    }
  };

  interest?.addEventListener("change", clearDetailsError);
  message?.addEventListener("input", clearDetailsError);

  contactForm?.addEventListener("submit", (event) => {
    const selectedInterest =
      interest instanceof HTMLSelectElement ? interest.value.trim() : "";
    const messageText =
      message instanceof HTMLTextAreaElement ? message.value.trim() : "";

    if (!selectedInterest && messageText.length < 8) {
      event.preventDefault();
      if (message instanceof HTMLTextAreaElement) {
        message.setCustomValidity(
          "Please choose what you're interested in or add a short message.",
        );
        message.reportValidity();
      }
    }
  });
</script>