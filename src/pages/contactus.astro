---
import BaseLayout from "../layouts/BaseLayout.astro";
import Turnstile from "../components/Turnstile.astro";
import { site } from "../data/site";
import { getEntry } from "astro:content";

type ContactData = {
  eyebrow: string;
  title: string;
  titleAccent: string;
  contacts: { name: string; email: string; phone: string; linkedin?: string }[];
};

const contact = await getEntry("pages", "contact");
if (!contact || !contact.data.contacts) {
  throw new Error("Contact page content is missing.");
}

const contactData = contact.data as ContactData;
const formEndpoint = `https://formsubmit.co/${site.email}`;
---

<BaseLayout title="Contact Us | Mercier Talent Solutions" image="/images/optimized/contact-hero-1400.jpg">
  <section class="section">
    <div class="container contact-grid">
      <div>
        <p class="eyebrow">{contactData.eyebrow}</p>
        <h1>{contactData.title} <em>{contactData.titleAccent}</em></h1>
        <div class="direct">
          {contactData.contacts.map((person) => (
            <p><strong>{person.name}</strong><br /><a href={`mailto:${person.email}`}>{person.email}</a><br />{person.phone}</p>
          ))}
        </div>
      </div>
      <form action={formEndpoint} method="POST">
        <input type="hidden" name="_subject" value="Mercier Talent Solutions Contact Form" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="form_name" value="Contact Us" />
        <input class="honeypot" type="text" name="_honey" tabindex="-1" autocomplete="off" />
        <label>FIRST NAME <input type="text" name="first_name" /></label>
        <label>LAST NAME <input type="text" name="last_name" /></label>
        <label>EMAIL <input type="email" name="email" required /></label>
        <label>I'M INTERESTED IN
          <select name="interest">
            <option value="">Select one</option>
            <option>COACHING</option>
            <option>TRAINING</option>
            <option>OTHER</option>
          </select>
        </label>
        <label>MESSAGE <textarea name="message" rows="6"></textarea></label>
        <Turnstile />
        <button class="button" type="submit">Submit</button>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(300px, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
  }

  h1 {
    margin: 0.4rem 0 1.4rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: var(--page-title-size);
    font-weight: 700;
    line-height: 1;
  }

  .direct {
    color: var(--color-muted);
  }

  form {
    display: grid;
    gap: 1rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-white);
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  label {
    display: grid;
    gap: 0.35rem;
    color: var(--color-blue);
    font-family: var(--font-label);
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0;
  }

  input,
  select,
  textarea {
    width: 100%;
    border: 1px solid var(--color-line);
    border-radius: 6px;
    padding: 0.85rem;
    font: inherit;
  }

  textarea {
    resize: vertical;
  }

  button {
    border: 0;
    cursor: pointer;
  }

  .honeypot {
    display: none;
  }

  @media (max-width: 800px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
