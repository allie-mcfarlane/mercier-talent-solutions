---
import BaseLayout from "../layouts/BaseLayout.astro";
import Turnstile from "../components/Turnstile.astro";
import { site } from "../data/site";
import { getEntry } from "astro:content";

type ContactData = {
  eyebrow: string;
  title: string;
  titleAccent: string;
  contacts: { name: string; email: string; phone: string; linkedin?: string }[];
};

const contact = await getEntry("pages", "contact");
if (!contact || !contact.data.contacts) {
  throw new Error("Contact page content is missing.");
}

const contactData = contact.data as ContactData;
const formEndpoint = `https://formsubmit.co/${site.email}`;
const description = "Contact Mercier Talent Solutions for executive coaching, assessments, training, and consulting for law firms.";
---

<BaseLayout title="Contact Us | Mercier Talent Solutions" description={description} image="/images/optimized/contact-hero-1400.jpg">
  <section class="section contact-hero">
    <div class="container contact-grid">
      <div>
        <p class="eyebrow">{contactData.eyebrow}</p>
        <h1>{contactData.title} <em>{contactData.titleAccent}</em></h1>
      </div>
      <div class="media-frame contact-image">
        <img src="/images/contact-hero.png" alt="Modern office lounge and reception area" loading="eager" decoding="async" />
      </div>
    </div>
    <div class="container contact-main">
      <div>
        <p class="eyebrow">Direct contact</p>
        <div class="direct">
          {contactData.contacts.map((person, index) => (
            <div class="contact-person">
              <p class="eyebrow">{index === 0 ? "Principal" : "Practice Manager"}</p>
              <p>
                <strong>{person.name}</strong><br />
                <a href={`mailto:${person.email}`}>{person.email}</a><br />
                <a href={`tel:${person.phone.replaceAll(/[^\d+]/g, "")}`}>{person.phone}</a><br />
                {person.linkedin && <a href={person.linkedin}>LinkedIn</a>}
              </p>
            </div>
          ))}
        </div>
      </div>
      <div class="form-wrap">
        <form action={formEndpoint} method="POST">
          <h2>Contact us</h2>
          <input type="hidden" name="_subject" value="Mercier Talent Solutions Contact Form" />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="form_name" value="Contact Us" />
          <input type="hidden" name="browser_privacy_signal" value="none" />
          <input class="honeypot" type="text" name="_honey" tabindex="-1" autocomplete="off" />
          <label>FIRST NAME <input type="text" name="first_name" /></label>
          <label>LAST NAME <input type="text" name="last_name" /></label>
          <label>EMAIL* <input type="email" name="email" required /></label>
          <label>
            I'M INTERESTED IN
            <select name="interest">
              <option value=""></option>
              <option>Executive Coaching</option>
              <option>Assessments</option>
              <option>Training</option>
              <option>Consulting</option>
              <option>White Papers</option>
              <option>Other</option>
            </select>
          </label>
          <label>MESSAGE <textarea name="message" rows="6"></textarea></label>
          <Turnstile />
          <button class="button" type="submit">Submit</button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero {
    background: #e7e6e0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(380px, 1fr);
    gap: clamp(2.5rem, 6vw, 4.75rem);
    align-items: center;
  }

  h1 {
    margin: 1.6rem 0 0;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: var(--page-title-size);
    font-weight: 700;
    line-height: 1;
  }

  .contact-hero .eyebrow {
    display: inline-flex;
    gap: 14px;
    align-items: center;
  }

  .contact-hero .eyebrow::before,
  .contact-main > div > .eyebrow::before {
    display: inline-block;
    width: 16px;
    height: 1px;
    background: var(--color-blue);
    content: "";
  }

  .contact-main > div > .eyebrow {
    display: inline-flex;
    gap: 14px;
    align-items: center;
  }

  .contact-main {
    display: grid;
    grid-template-columns: minmax(300px, 0.74fr) minmax(440px, 0.86fr);
    gap: clamp(2.5rem, 6vw, 5.5rem);
    max-width: var(--content-wide);
    margin-top: clamp(3.5rem, 7vw, 5rem);
    margin-inline: auto;
    align-items: start;
  }

  .direct {
    display: grid;
    gap: clamp(2.3rem, 5vw, 3.3rem);
    margin-top: clamp(2rem, 4vw, 3rem);
    color: var(--color-muted);
  }

  .contact-person p:not(.eyebrow) {
    margin: 0.4rem 0 0;
  }

  .contact-person strong {
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: 1.22rem;
  }

  .contact-person a {
    color: var(--color-muted);
    text-decoration: none;
  }

  .contact-person a:hover,
  .contact-person a:focus-visible {
    color: var(--color-blue);
    text-decoration: underline;
  }

  .contact-image {
    aspect-ratio: 1.42;
  }

  .form-wrap {
    display: grid;
    justify-items: stretch;
  }

  form {
    display: grid;
    width: 100%;
    gap: 1.1rem;
    border: 1px solid var(--color-line);
    border-radius: 0;
    background: transparent;
    padding: 0;
  }

  form h2 {
    margin: 0 0 0.5rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3vw, 2.4rem);
    line-height: 1.1;
  }

  label {
    display: grid;
    gap: 0.35rem;
    color: var(--color-blue);
    font-family: var(--font-label);
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.5px;
  }

  input,
  select,
  textarea {
    width: 100%;
    border: 1px solid var(--color-line);
    border-radius: 0;
    padding: 0.85rem;
    background: var(--color-white);
    font: inherit;
  }

  textarea {
    resize: vertical;
  }

  button {
    border: 0;
    cursor: pointer;
  }

  .honeypot {
    display: none;
  }

  @media (max-width: 800px) {
    .contact-grid,
    .contact-main,
    .form-wrap,
    .direct {
      grid-template-columns: 1fr;
      justify-items: stretch;
    }
  }
</style>
