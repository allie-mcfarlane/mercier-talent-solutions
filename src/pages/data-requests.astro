---
import BaseLayout from "../layouts/BaseLayout.astro";
import Turnstile from "../components/Turnstile.astro";
import { getEntry } from "astro:content";

type PrivacyFormData = {
  eyebrow: string;
  title: string;
  titleAccent: string;
  formSubject: string;
  formName: string;
  includeName?: boolean;
  requestOptions: string[];
};

const page = await getEntry("pages", "data-requests");
if (!page || !page.data.requestOptions) {
  throw new Error("Data requests content is missing.");
}

const pageData = page.data as PrivacyFormData;
const { Content } = await page.render();
const formEndpoint = "/api/privacy";
const description = "Submit a privacy request or appeal to Mercier Talent Solutions.";
const successMessage = "Thank you. Your privacy request has been submitted to Mercier Talent Solutions. We will review your request and respond as required by applicable law.";
---

<BaseLayout title="Data Requests & Appeals | Mercier Talent Solutions" description={description}>
  <section class="section">
    <div class="container privacy-grid">
      <div>
        <p class="eyebrow">{pageData.eyebrow}</p>
        <h1>{pageData.title} <em>{pageData.titleAccent}</em></h1>
        <div class="intro"><Content /></div>
      </div>
      <form action={formEndpoint} method="POST">
        <input type="hidden" name="form_name" value={pageData.formName} />
        <input class="honeypot" type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" />
        {pageData.includeName && (
          <label>
            NAME
            <input type="text" name="name" autocomplete="name" />
          </label>
        )}
        <label>
          EMAIL ADDRESS
          <input type="email" name="email" autocomplete="email" required />
        </label>
        <label>
          REQUEST TYPE
          <select name="request_type" required>
            <option value="">Select one</option>
            {pageData.requestOptions.map((option) => <option value={option}>{option}</option>)}
          </select>
        </label>
        <label>
          MESSAGE OR REQUEST DETAILS
          <textarea name="message" rows="6"></textarea>
        </label>
        <p class="sensitive-note"><strong>Please do not include sensitive personal information in this form.</strong></p>
        <Turnstile action="privacy" endpoint={formEndpoint} successMessage={successMessage} />
        <button class="button" type="submit">Submit Request</button>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .privacy-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(360px, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    max-width: var(--content-wide);
    margin-inline: auto;
  }

  h1 {
    margin: 0.4rem 0 1.2rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: var(--page-title-size);
    font-weight: 700;
    line-height: 1;
  }

  .intro :global(p) {
    color: var(--color-ink);
    font-size: var(--paragraph-size);
  }

  .intro :global(a) {
    color: var(--color-blue-dark);
    font-weight: 800;
  }

  form {
    display: grid;
    gap: 1rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-white);
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  label {
    display: grid;
    gap: 0.35rem;
    color: var(--color-blue);
    font-family: var(--font-label);
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0;
  }

  input,
  select,
  textarea {
    width: 100%;
    border: 1px solid var(--color-line);
    border-radius: 6px;
    padding: 0.85rem;
    font: inherit;
  }

  .sensitive-note {
    margin: -0.25rem 0 0;
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  button {
    border: 0;
    cursor: pointer;
  }

  .honeypot {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    overflow: hidden !important;
    clip: rect(0 0 0 0) !important;
    clip-path: inset(50%) !important;
    white-space: nowrap !important;
  }

  @media (max-width: 800px) {
    .privacy-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
