---
import BaseLayout from "../layouts/BaseLayout.astro";
import Turnstile from "../components/Turnstile.astro";
import { site } from "../data/site";
import { getEntry } from "astro:content";

type PrivacyFormData = {
  eyebrow: string;
  title: string;
  titleAccent: string;
  formSubject: string;
  formName: string;
  includeName?: boolean;
  requestOptions: string[];
};

const page = await getEntry("pages", "data-requests");
if (!page || !page.data.requestOptions) {
  throw new Error("Data requests content is missing.");
}

const pageData = page.data as PrivacyFormData;
const { Content } = await page.render();
const formEndpoint = `https://formsubmit.co/${site.privacyEmail}`;
const description = "Submit a privacy request or appeal to Mercier Talent Solutions.";
---

<BaseLayout title="Data Requests & Appeals | Mercier Talent Solutions" description={description}>
  <section class="section">
    <div class="container privacy-grid">
      <div>
        <p class="eyebrow">{pageData.eyebrow}</p>
        <h1>{pageData.title} <em>{pageData.titleAccent}</em></h1>
        <div class="intro"><Content /></div>
      </div>
      <form action={formEndpoint} method="POST">
        <input type="hidden" name="_subject" value={pageData.formSubject} />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="form_name" value={pageData.formName} />
        <input type="hidden" name="browser_privacy_signal" value="none" />
        <input class="honeypot" type="text" name="_honey" tabindex="-1" autocomplete="off" />
        {pageData.includeName && (
          <label>
            NAME
            <input type="text" name="name" />
          </label>
        )}
        <label>
          EMAIL
          <input type="email" name="email" required />
        </label>
        <label>
          REQUEST TYPE
          <select name="request_type" required>
            <option value="">Select one</option>
            {pageData.requestOptions.map((option) => <option>{option}</option>)}
          </select>
        </label>
        <label>
          MESSAGE
          <textarea name="message" rows="6"></textarea>
        </label>
        <Turnstile />
        <button class="button" type="submit">Submit Request</button>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .privacy-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(300px, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
  }

  h1 {
    margin: 0.4rem 0 1.2rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: var(--page-title-size);
    font-weight: 700;
    line-height: 1;
  }

  .intro :global(p) {
    color: var(--color-muted);
    font-size: var(--paragraph-size);
  }

  .intro :global(a) {
    color: var(--color-blue-dark);
    font-weight: 800;
  }

  form {
    display: grid;
    gap: 1rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-white);
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  label {
    display: grid;
    gap: 0.35rem;
    color: var(--color-blue);
    font-family: var(--font-label);
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0;
  }

  input,
  select,
  textarea {
    width: 100%;
    border: 1px solid var(--color-line);
    border-radius: 6px;
    padding: 0.85rem;
    font: inherit;
  }

  button {
    border: 0;
    cursor: pointer;
  }

  .honeypot {
    display: none;
  }

  @media (max-width: 800px) {
    .privacy-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
