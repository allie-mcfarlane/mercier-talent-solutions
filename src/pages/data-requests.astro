---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const formEndpoint = `https://formsubmit.co/${site.privacyEmail}`;
---

<BaseLayout title="Data Requests & Appeals | Mercier Talent Solutions">
  <section class="section">
    <div class="container privacy-grid">
      <div>
        <p class="eyebrow">Data Requests & Appeals</p>
        <h1>Submit a privacy request or <em>appeal</em></h1>
        <p>
          Visitors may use this page to request access, correction, deletion, portability, opt out, or to
          appeal a privacy request decision.
        </p>
        <p>
          This form sends privacy requests and appeals to
          <a href={`mailto:${site.privacyEmail}`}>{site.privacyEmail}</a>. Visitors may also email that
          address directly.
        </p>
      </div>
      <form action={formEndpoint} method="POST">
        <input type="hidden" name="_subject" value="Privacy Request or Appeal" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="form_name" value="Data Requests and Appeals" />
        <input class="honeypot" type="text" name="_honey" tabindex="-1" autocomplete="off" />
        <label>
          NAME
          <input type="text" name="name" />
        </label>
        <label>
          EMAIL
          <input type="email" name="email" required />
        </label>
        <label>
          REQUEST TYPE
          <select name="request_type" required>
            <option value="">Select one</option>
            <option>Access my data</option>
            <option>Correct my data</option>
            <option>Delete my data</option>
            <option>Receive a copy of my data</option>
            <option>Opt out of targeted advertising data use</option>
            <option>Appeal a privacy request decision</option>
          </select>
        </label>
        <label>
          MESSAGE
          <textarea name="message" rows="6"></textarea>
        </label>
        <button class="button" type="submit">Submit Request</button>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .privacy-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(300px, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
  }

  h1 {
    margin: 0.4rem 0 1.2rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: var(--page-title-size);
    font-weight: 700;
    line-height: 1;
  }

  p {
    color: var(--color-muted);
    font-size: 1.08rem;
  }

  form {
    display: grid;
    gap: 1rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-white);
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  label {
    display: grid;
    gap: 0.35rem;
    color: var(--color-blue);
    font-family: var(--font-label);
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0;
  }

  input,
  select,
  textarea {
    width: 100%;
    border: 1px solid var(--color-line);
    border-radius: 6px;
    padding: 0.85rem;
    font: inherit;
  }

  button {
    border: 0;
    cursor: pointer;
  }

  .honeypot {
    display: none;
  }

  @media (max-width: 800px) {
    .privacy-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
