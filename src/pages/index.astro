---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { services, site } from "../data/site";

const recentPosts = (await getCollection("posts"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 8);

const homeServices = [services[0], services[2], services[1], services[3]];
const marqueeItems = [
  "Leadership",
  "Communication",
  "Executive Presence",
  "Feedback",
  "Delegation",
  "Business Development",
  "Time Management",
  "Team Effectiveness",
  "Career Strategy",
];
---

<BaseLayout title="Home | Mercier Talent Solutions" description={site.description}>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Talent development for law firms</p>
        <h1>Let's do our best work <em>together</em></h1>
        <p class="lede">
          Mercier Talent Solutions partners with law firms and legal professionals to strengthen the leadership,
          communication, and practice management capabilities that sustain excellence over time.
        </p>
        <div class="button-row">
          <a class="button" href="/services/">Explore our services</a>
          <a class="button secondary" href="/contactus/">Contact us</a>
        </div>
      </div>
      <div class="hero-panel media-frame">
        <img src="/images/navy-office-corridor.png" alt="A calm professional office lounge and corridor" />
      </div>
    </div>
  </section>

  <section class="section proof">
    <div class="container proof-grid">
      <article>
        <h2>Beyond technical excellence</h2>
        <p>The demands of legal practice are more visible and interconnected than ever, requiring lawyers to lead, communicate, and manage with greater intentionality.</p>
      </article>
      <article>
        <h2>Leadership is learned</h2>
        <p>Strong leadership, effective communication, and executive presence are learned capabilities built deliberately, not left to chance.</p>
      </article>
      <article>
        <h2>Firms built to perform</h2>
        <p>Deliberate investment in professional skills builds more engaged teams, stronger practices, and organizations positioned to perform over the long term.</p>
      </article>
    </div>
  </section>

  <section class="marquee-band" aria-label="Core focus areas">
    <div class="marquee-track">
      {[...marqueeItems, ...marqueeItems].map((item) => <span>{item}</span>)}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">What we do</p>
        <h2>How we work with firms</h2>
      </div>
      <div class="grid service-grid">
        {homeServices.map((service) => (
          <article class="card">
            <p class="eyebrow">{service.eyebrow}</p>
            <h3>{service.title}</h3>
            <p>{service.text}</p>
            <a class="button text" href="/services/">LEARN MORE</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section approach">
    <div class="container approach-grid">
      <div class="section-heading">
        <p class="eyebrow">Our approach</p>
        <h2>Grounded in the realities of legal practice</h2>
        <p>Our firm is led by Julia Mercier, a former litigator, executive coach, and seasoned legal talent professional who has designed and implemented firmwide training systems inside global law firms.</p>
      </div>
      <ul>
        <li>Practical, rigorous engagements, not generic leadership theory</li>
        <li>Deep experience inside complex, global legal organizations</li>
        <li>Insight that translates into action, habits, and systems</li>
        <li>Measurable progress for individuals, teams, and firms</li>
      </ul>
    </div>
  </section>

  <section class="section news-band">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">News & Insights</p>
        <h2>Thought leadership on modern legal practice.</h2>
      </div>
      <div class="news-list">
        {recentPosts.map((post) => (
          <a class="news-card" href={`/post/${post.slug}/`}>
            <span class="pill">{post.data.category}</span>
            <h3>{post.data.title}</h3>
            <p>{post.data.excerpt}</p>
            <span class="meta-row">Julia Mercier · {post.data.pubDate.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: min(720px, calc(100vh - 78px));
    padding: clamp(4.5rem, 9vw, 8rem) 0 clamp(3rem, 7vw, 6rem);
    background: var(--color-white);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(360px, 1.1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
  }

  .hero-copy::before {
    display: block;
    width: 92px;
    height: 3px;
    margin: 1.7rem 0 2.8rem;
    background: var(--color-blue-dark);
    content: "";
  }

  h1 {
    max-width: 820px;
    margin: 0.45rem 0 1.1rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: var(--page-title-size);
    font-weight: 700;
    line-height: 0.96;
  }

  h1 em {
    color: var(--color-blue);
    font-style: italic;
  }

  .lede {
    max-width: 680px;
    margin: 0 0 1.5rem;
    color: var(--color-muted);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
  }

  .hero-panel {
    position: relative;
    align-self: stretch;
    width: calc(100% + max(1rem, (100vw - var(--container)) / 2));
    min-height: 520px;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    clip-path: polygon(17% 0, 100% 0, 100% 100%, 0 100%);
  }

  .hero-panel::before,
  .hero-panel::after {
    position: absolute;
    z-index: 1;
    pointer-events: none;
    content: "";
  }

  .hero-panel::before {
    right: 14%;
    top: 2%;
    width: 52%;
    height: 94%;
    border-right: 3px solid rgba(255, 255, 255, 0.78);
    border-radius: 50%;
    transform: rotate(-17deg);
  }

  .hero-panel::after {
    right: 12%;
    top: 4%;
    width: 24px;
    height: 24px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
  }

  .proof {
    background: var(--color-blue-dark);
    color: var(--color-white);
  }

  .proof-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: transparent;
    border: 0;
  }

  .proof article {
    background: transparent;
    padding: clamp(1.4rem, 3vw, 2rem);
    text-align: center;
  }

  .proof h2 {
    margin: 0 0 0.6rem;
    color: var(--color-white);
    font-family: var(--font-heading);
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    font-weight: 800;
  }

  .proof p {
    margin: 0;
    color: rgba(255, 255, 255, 0.78);
  }

  .marquee-band {
    overflow: hidden;
    padding: 1.05rem 0;
    background: #d8d7d2;
    color: rgba(26, 43, 70, 0.58);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 34s linear infinite;
  }

  .marquee-track span {
    display: inline-flex;
    align-items: center;
    font-size: clamp(0.86rem, 1.3vw, 1.06rem);
    font-weight: 600;
  }

  .marquee-track span::after {
    margin: 0 0.9rem;
    color: rgba(69, 98, 142, 0.62);
    content: "◆";
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  .service-grid {
    margin-top: 2rem;
  }

  .approach {
    background: var(--color-blue-dark);
    color: var(--color-white);
  }

  .approach .section-heading h2,
  .approach .section-heading p {
    color: var(--color-white);
  }

  .approach-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.72fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 1rem;
  }

  li {
    border-top: 1px solid rgba(255, 255, 255, 0.24);
    padding-top: 1rem;
    color: rgba(255, 255, 255, 0.82);
  }

  .news-band {
    background: var(--color-white);
  }

  .news-list {
    display: grid;
    margin-top: 2rem;
    border-top: 1px solid var(--color-line);
  }

  .news-card {
    display: grid;
    gap: 0.55rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-line);
    text-decoration: none;
  }

  .news-card h3 {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: clamp(1.45rem, 3vw, 2.4rem);
    font-weight: 700;
  }

  .news-card p {
    max-width: 780px;
    margin: 0;
    color: var(--color-muted);
  }

  @media (max-width: 860px) {
    .hero-grid,
    .approach-grid,
    .proof-grid {
      grid-template-columns: 1fr;
    }

    .hero {
      min-height: 0;
    }

    .hero-copy::before {
      margin: 1.2rem 0 2rem;
    }

    .hero-panel {
      width: 100%;
      min-height: auto;
      aspect-ratio: 1.25;
      border-radius: var(--radius);
      clip-path: none;
      box-shadow: var(--shadow);
    }

    .hero-panel::before,
    .hero-panel::after {
      display: none;
    }

    .proof article {
      text-align: left;
    }
  }
</style>
