---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import { getCollection, getEntry } from "astro:content";
import { site } from "../data/site";

type HomeData = {
  eyebrow: string;
  title: string;
  titleAccent: string;
  lede: string;
  primaryCta: { label: string; href: string };
  secondaryCta: { label: string; href: string };
  proof: { title: string; text: string }[];
  marqueeItems: string[];
  approach: { eyebrow: string; title: string; text: string; items: string[] };
  news: { eyebrow: string; title: string };
};

type ServiceItem = {
  eyebrow: string;
  title: string;
  text: string;
};

const home = await getEntry("pages", "home");
const servicesPage = await getEntry("pages", "services");
if (!home || !servicesPage || !servicesPage.data.services) {
  throw new Error("Home page content is missing.");
}

const serviceItems = servicesPage.data.services as ServiceItem[];
const homeServices = [serviceItems[0], serviceItems[1], serviceItems[2], serviceItems[3]];
const homeData = home.data as HomeData;
const recentPosts = (await getCollection("posts"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const dateFormat = { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" } as const;
const stats = [
  { value: "9", suffix: "+", text: "Years of developing lawyers in-house and as a consultant for global firms" },
  { value: "12", suffix: "+", text: "Coaching, assessment & training offerings" },
  { value: "9", suffix: "+", text: "Signature training programs for legal teams" },
];
---

<BaseLayout title="Home | Mercier Talent Solutions" description={site.description} image="/images/optimized/waiting-area-1400.jpg">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{homeData.eyebrow}</p>
        <h1>{homeData.title} <em>{homeData.titleAccent}</em></h1>
        <p class="lede">{homeData.lede}</p>
        <div class="button-row">
          <a class="button" href={homeData.primaryCta.href}>{homeData.primaryCta.label}</a>
          <a class="button secondary" href={homeData.secondaryCta.href}>{homeData.secondaryCta.label}</a>
        </div>
      </div>
      <div class="hero-panel media-frame">
        <ResponsiveImage
          src="/images/waiting-area.png"
          alt="A calm professional waiting area and office corridor"
          sizes="(min-width: 900px) 56vw, 100vw"
          eager
        />
        <div class="hero-art-circle-animation" aria-hidden="true">
          <svg viewBox="0 0 600 800" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
            <g class="floating-group">
              <g class="rings" fill="none" stroke="#E9E7E2" stroke-opacity=".32" stroke-width="1.2">
                <circle cx="430" cy="260" r="180"></circle>
                <circle cx="430" cy="260" r="260"></circle>
                <circle cx="430" cy="260" r="340"></circle>
              </g>
              <path
                class="draw"
                pathLength="1"
                d="M120 700 L300 460 L430 260"
                fill="none"
                stroke="#E9E7E2"
                stroke-opacity=".85"
                stroke-width="2"
              ></path>
              <circle class="dot dot-1" cx="120" cy="700" r="5" fill="#E9E7E2" fill-opacity=".6"></circle>
              <circle class="dot dot-2" cx="300" cy="460" r="5" fill="#E9E7E2" fill-opacity=".85"></circle>
              <circle class="dot dot-3" cx="430" cy="260" r="7" fill="#E9E7E2"></circle>
            </g>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <section class="section proof">
    <div class="container proof-grid">
      {homeData.proof.map((item) => (
        <article>
          <h2>{item.title}</h2>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="marquee-band" aria-label="Core focus areas">
    <div class="marquee-track">
      {[...homeData.marqueeItems, ...homeData.marqueeItems].map((item) => <span>{item}</span>)}
    </div>
  </section>

  <section class="section stats-band">
    <div class="container stats-grid">
      {stats.map((item) => (
        <article class="stat">
          <div class="number-row" aria-label={`${item.value}${item.suffix}`}>
            <span class="stat-number" data-count-target={item.value}>{item.value}</span>
            <span class="suffix" aria-hidden="true">{item.suffix}</span>
          </div>
          <p class="description">{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section services-preview">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">What we do</p>
        <h2>How we work with firms</h2>
      </div>
      <div class="grid service-grid">
        {homeServices.map((service) => (
          <article class="card">
            <p class="eyebrow">{service.eyebrow}</p>
            <h3>{service.title}</h3>
            <p>{service.text}</p>
            <a class="button text" href="/services/">LEARN MORE</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section approach">
    <div class="container approach-grid">
      <div class="approach-copy">
        <div class="section-heading">
          <p class="eyebrow">{homeData.approach.eyebrow}</p>
          <h2>{homeData.approach.title}</h2>
          <p>{homeData.approach.text}</p>
        </div>
        <ul>
          {homeData.approach.items.map((item) => <li>{item}</li>)}
        </ul>
        <a class="button secondary approach-cta" href="/about/">Meet the team</a>
      </div>
      <div class="chart-wrapper approach-chart" data-approach-chart>
        <svg viewBox="0 0 900 800" preserveAspectRatio="none" role="img" aria-labelledby="approachChartDescription">
          <desc id="approachChartDescription">An animated line chart showing upward development over time.</desc>
          <line class="grid-line" x1="0" y1="200" x2="900" y2="200"></line>
          <line class="grid-line" x1="0" y1="400" x2="900" y2="400"></line>
          <line class="grid-line" x1="0" y1="600" x2="900" y2="600"></line>
          <polyline class="secondary-line" points="50,690 270,545 490,585 710,325 850,215"></polyline>
          <polyline class="main-line" points="50,615 270,455 490,475 710,220 850,105"></polyline>
          <circle class="data-point point-1" cx="50" cy="615" r="10"></circle>
          <circle class="data-point point-2" cx="270" cy="455" r="10"></circle>
          <circle class="data-point point-3" cx="490" cy="475" r="10"></circle>
          <circle class="data-point point-4" cx="710" cy="220" r="10"></circle>
          <circle class="data-point point-5" cx="850" cy="105" r="11"></circle>
        </svg>
      </div>
    </div>
  </section>

  <section class="section news-band">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">{homeData.news.eyebrow}</p>
        <h2>{homeData.news.title}</h2>
      </div>
      <div class="news-list">
        {recentPosts.map((post) => (
          <a class="card news-card" href={`/post/${post.slug}/`}>
            <span class="pill">{post.data.category}</span>
            <h3>{post.data.title}</h3>
            <p>{post.data.excerpt}</p>
            <span class="meta-row news-author">
              <img src={post.data.image ?? "/images/julia-mercier.jpg"} alt="" loading="lazy" />
              <span>{post.data.author} · {post.data.pubDate.toLocaleDateString("en-US", dateFormat)}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    height: 610px;
    min-height: 610px;
    padding: 0;
    background: var(--color-white);
  }

  .hero-grid {
    display: grid;
    height: 100%;
    grid-template-columns: minmax(0, 500px) minmax(0, 1fr);
    gap: 48px;
    align-items: start;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    width: min(500px, calc(100vw - 80px));
  }

  .hero-copy::before {
    content: none;
  }

  .hero .eyebrow {
    margin-top: 0.1rem;
    white-space: nowrap;
  }

  .hero .eyebrow::before {
    background: var(--color-blue);
  }

  h1::before {
    display: block;
    width: 92px;
    height: 3px;
    margin: 2.35rem 0 2.45rem;
    background: var(--color-blue-dark);
    content: "";
  }

  h1 {
    max-width: 500px;
    margin: 0.45rem 0 1.1rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: clamp(2.55rem, 4.4vw, 3.45rem);
    font-weight: 700;
    line-height: 1.2;
  }

  h1 em {
    color: var(--color-blue);
    font-style: italic;
  }

  .lede {
    max-width: 470px;
    margin: 0 0 1.5rem;
    color: var(--color-ink);
    font-size: var(--paragraph-size);
  }

  .hero .button {
    min-width: 164px;
    min-height: 42px;
    border-radius: 0;
    padding: 0.62rem 1.25rem;
    font-size: 0.9rem;
    font-weight: 400;
  }

  .hero .button-row {
    gap: 60px;
  }

  .hero-panel {
    position: relative;
    align-self: stretch;
    width: calc(100% + max(1rem, (100vw - var(--container)) / 2) + 4rem);
    height: 627px;
    min-height: 627px;
    margin-top: -17px;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    clip-path: polygon(17% 0, 100% 0, 100% 100%, 0 100%);
  }

  .hero-art-circle-animation {
    position: absolute;
    inset: 0;
    z-index: 2;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-art-circle-animation svg {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .draw {
    animation: drawline 2.2s 0.35s var(--ease-smooth) forwards;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .dot {
    opacity: 0;
    transform: scale(0);
    transform-box: fill-box;
    transform-origin: center;
    animation: dotPop 0.72s cubic-bezier(0.34, 1.36, 0.64, 1) forwards;
  }

  .dot-1 {
    animation-delay: 0.6s;
  }

  .dot-2 {
    animation-delay: 1.25s;
  }

  .dot-3 {
    animation-delay: 1.9s;
  }

  .rings {
    opacity: 0;
    transform: scale(0.92);
    transform-box: fill-box;
    transform-origin: center;
    animation: ringsIn 1.8s 1.45s var(--ease-smooth) forwards;
  }

  .floating-group {
    animation: floatGraphic 11s 3s ease-in-out infinite;
  }

  @keyframes drawline {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes dotPop {
    60% {
      opacity: 1;
      transform: scale(1.45);
    }

    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes ringsIn {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes floatGraphic {
    50% {
      transform: translateY(-6px);
    }
  }

  .proof {
    background: var(--color-blue-dark);
    padding: 0;
  }

  .proof-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    border: 0;
    background: var(--color-blue-dark);
    min-height: 236px;
  }

  .proof article {
    display: grid;
    align-content: center;
    background: var(--color-blue-dark);
    padding: clamp(1.55rem, 3vw, 2rem);
    text-align: center;
  }

  .proof article + article {
    border-left: 0;
  }

  .proof h2 {
    margin: 0 0 0.6rem;
    color: var(--color-white);
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 700;
    line-height: 1.35;
  }

  .proof p {
    max-width: 390px;
    margin: 0;
    margin-inline: auto;
    color: rgba(255, 255, 255, 0.84);
    font-size: 15px;
    line-height: 1.5;
  }

  .marquee-band {
    overflow: hidden;
    padding: 1.32rem 0;
    background: #d8d7d2;
    color: rgba(26, 43, 70, 0.58);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 42s linear infinite;
  }

  .marquee-track span {
    display: inline-flex;
    align-items: center;
    font-size: clamp(0.86rem, 1.3vw, 1.06rem);
    font-weight: 600;
  }

  .marquee-track span::after {
    margin: 0 0.9rem;
    color: rgba(69, 98, 142, 0.62);
    content: "◆";
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  .service-grid {
    margin-top: 34px;
  }

  .stats-band {
    padding: 70px 0 62px;
    background: var(--color-white);
  }

  .stats-grid {
    display: grid;
    min-height: 216px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: 100%;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    background: var(--color-white);
  }

  .stat {
    display: flex;
    min-width: 0;
    min-height: 215px;
    flex-direction: column;
    align-items: center;
    padding: 42px 35px 35px;
    text-align: center;
  }

  .stat + .stat {
    border-left: 1px solid var(--color-line);
  }

  .number-row {
    display: flex;
    width: 100%;
    align-items: baseline;
    justify-content: center;
    margin-bottom: 14px;
    line-height: 1;
    text-align: center;
  }

  .stat-number {
    color: #172641;
    font-family: var(--font-heading);
    font-size: 62px;
    font-weight: 700;
    letter-spacing: -2px;
  }

  .suffix {
    margin-left: 5px;
    color: var(--color-blue);
    font-family: var(--font-heading);
    font-size: 43px;
    font-weight: 500;
  }

  .description {
    width: 100%;
    max-width: 300px;
    margin: 0;
    color: var(--color-ink);
    font-size: var(--paragraph-size);
    font-weight: 400;
    line-height: 1.5;
    text-align: center;
  }

  .services-preview {
    padding: 55px 0 121px;
  }

  .services-preview .section-heading {
    max-width: 543px;
    gap: 49px;
  }

  .services-preview .section-heading > .eyebrow {
    font-weight: 500;
    letter-spacing: 7px;
  }

  .services-preview .section-heading > .eyebrow::before {
    background: var(--color-blue);
  }

  .services-preview .section-heading h2 {
    width: min(436px, 100%);
    font-size: 20px;
    line-height: 1.3;
  }

  .services-preview .service-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 35px 24px;
  }

  .services-preview .card {
    min-height: 296px;
    padding: 40px 34px 28px;
  }

  .services-preview .card h3 {
    margin: 19px 0 14px;
    font-size: 16px;
    line-height: 1.5;
  }

  .services-preview .card p:not(.eyebrow) {
    max-width: 522px;
    font-size: var(--paragraph-size);
    line-height: 1.5;
  }

  .approach {
    min-height: 523px;
    padding: 0;
    background: var(--color-white);
    color: var(--color-text);
  }

  .approach-grid {
    display: grid;
    min-height: 523px;
    grid-template-columns: minmax(0, 671px) minmax(380px, 1fr);
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: stretch;
  }

  .approach-copy {
    display: grid;
    align-content: start;
    gap: 28px;
    padding-top: 48px;
  }

  .approach .section-heading {
    max-width: 588px;
    gap: 46px;
  }

  .approach .section-heading h2 {
    font-size: 19px;
    line-height: 1.3;
  }

  .approach .section-heading p:not(.eyebrow) {
    max-width: 588px;
    color: var(--color-ink);
    font-size: var(--paragraph-size);
    line-height: 1.5;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 12px;
  }

  li {
    position: relative;
    border-top: 0;
    padding-top: 0;
    padding-left: 31px;
    color: var(--color-ink);
    font-size: 15px;
    line-height: 1.5;
  }

  .approach li::before {
    position: absolute;
    top: 0.45em;
    left: 3px;
    width: 11px;
    height: 6px;
    border-bottom: 2px solid var(--color-blue);
    border-left: 2px solid var(--color-blue);
    content: "";
    transform: rotate(-45deg);
  }

  .approach-cta {
    justify-self: start;
    margin-top: 2px;
    border-color: var(--color-blue);
    color: var(--color-blue);
  }

  .chart-wrapper {
    display: flex;
    width: 100%;
    min-height: 523px;
    align-items: stretch;
    justify-content: stretch;
    overflow: hidden;
    background: #1b2b46;
  }

  .chart-wrapper svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .grid-line {
    stroke: #2b3e5d;
    stroke-width: 2;
    opacity: 0.9;
  }

  .secondary-line {
    fill: none;
    stroke: #36547f;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.85;
  }

  .main-line {
    fill: none;
    stroke: #f2f0eb;
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .data-point {
    fill: #f2f0eb;
    stroke: rgba(255, 255, 255, 0.35);
    stroke-width: 4;
    opacity: 0;
    transform: scale(0);
    transform-box: fill-box;
    transform-origin: center;
  }

  .secondary-line,
  .main-line {
    stroke-dasharray: 2000;
    stroke-dashoffset: 2000;
  }

  .chart-wrapper.animate .secondary-line {
    animation: drawSecondary 3.15s var(--ease-smooth) forwards;
  }

  .chart-wrapper.animate .main-line {
    animation: drawMain 3.95s var(--ease-smooth) forwards;
    animation-delay: 0.2s;
  }

  .chart-wrapper.animate .data-point {
    animation: revealPoint 0.68s var(--ease-soft) forwards;
  }

  .chart-wrapper.animate .point-1 {
    animation-delay: 0.45s;
  }

  .chart-wrapper.animate .point-2 {
    animation-delay: 1.1s;
  }

  .chart-wrapper.animate .point-3 {
    animation-delay: 1.75s;
  }

  .chart-wrapper.animate .point-4 {
    animation-delay: 2.4s;
  }

  .chart-wrapper.animate .point-5 {
    animation-delay: 3.05s;
  }

  @keyframes drawSecondary {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes drawMain {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes revealPoint {
    70% {
      opacity: 1;
      transform: scale(1.15);
    }

    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  .news-band {
    padding: 46px 0 92px;
    background: #ececec;
  }

  .news-band .section-heading {
    max-width: 1202px;
    gap: 24px;
  }

  .news-band .section-heading h2 {
    max-width: 585px;
    font-size: 20px;
    line-height: 1.3;
  }

  .news-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-top: 48px;
  }

  .news-card {
    display: grid;
    min-height: 306px;
    align-content: start;
    gap: 14px;
    padding: 31px 30px 28px;
    text-decoration: none;
  }

  .news-card h3 {
    margin: 4px 0 0;
    font-size: 20px;
    line-height: 1.28;
  }

  .news-card p {
    color: var(--color-ink);
    font-size: 15px;
    line-height: 1.55;
  }

  .news-card .meta-row {
    align-self: end;
    margin-top: 10px;
  }

  .news-author {
    align-items: center;
    gap: 0.7rem;
  }

  .news-author img {
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 30%;
  }

  @media (max-width: 860px) {
    .hero-grid,
    .approach-grid,
    .proof-grid,
    .services-preview .service-grid,
    .news-list {
      grid-template-columns: 1fr;
    }

    .hero {
      height: auto;
      min-height: 0;
      padding: clamp(3.75rem, 10vw, 5rem) 0 clamp(3rem, 8vw, 4rem);
    }

    h1::before {
      margin: 1.9rem 0 2rem;
    }

    .hero-panel {
      width: 100%;
      min-height: auto;
      aspect-ratio: 1.25;
      border-radius: var(--radius);
      clip-path: none;
      box-shadow: var(--shadow);
    }

    .hero-art-circle-animation {
      display: none;
    }

    .proof article {
      text-align: left;
    }

    .proof article + article {
      border-top: 1px solid var(--color-line);
      border-left: 0;
    }

    .chart-wrapper {
      min-height: 420px;
    }

    .services-preview {
      padding: clamp(4rem, 12vw, 6rem) 0;
    }

    .stats-band {
      padding: clamp(4rem, 12vw, 6rem) 0;
    }

    .services-preview .section-heading,
    .approach .section-heading {
      gap: 0.72rem;
    }

    .approach {
      padding: clamp(4rem, 12vw, 6rem) 0;
    }

    .approach-grid {
      min-height: 0;
    }

    .approach-copy {
      padding-top: 0;
    }

    .news-band {
      min-height: 0;
      padding: clamp(4rem, 12vw, 6rem) 0;
    }
  }

  @media (max-width: 900px) {
    .stats-band {
      padding: 64px 0 58px;
    }

    .stat {
      min-height: 165px;
      padding: 26px 18px 24px;
    }

    .number-row {
      margin-bottom: 10px;
    }

    .stat-number {
      font-size: 42px;
      letter-spacing: -1.5px;
    }

    .suffix {
      margin-left: 4px;
      font-size: 29px;
    }

    .description {
      max-width: 100%;
      font-size: var(--paragraph-size);
      line-height: 1.4;
    }
  }

  @media (max-width: 700px) {
    .stat {
      min-height: 155px;
      padding: 24px 14px 22px;
    }

    .stat-number {
      font-size: 36px;
    }

    .suffix {
      font-size: 25px;
    }

    .description {
      font-size: var(--paragraph-size);
      line-height: 1.35;
    }
  }

  @media (max-width: 560px) {
    .stats-grid {
      grid-template-columns: 1fr;
    }

    .stat {
      min-height: auto;
      padding: 26px 20px;
    }

    .stat + .stat {
      border-top: 1px solid var(--color-line);
      border-left: 0;
    }

    .stat-number {
      font-size: 42px;
    }

    .suffix {
      font-size: 29px;
    }

    .description {
      font-size: 15px;
      line-height: 1.45;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .draw,
    .dot,
    .rings,
    .floating-group {
      animation: none;
    }

    .draw {
      stroke-dashoffset: 0;
    }

    .dot,
    .rings {
      opacity: 1;
      transform: none;
    }

    .secondary-line,
    .main-line {
      stroke-dashoffset: 0;
    }

    .data-point {
      opacity: 1;
      transform: scale(1);
    }

    .chart-wrapper.animate .secondary-line,
    .chart-wrapper.animate .main-line,
    .chart-wrapper.animate .data-point,
    .stat-number {
      animation: none;
    }
  }
</style>

<script>
  const chartWrapper = document.querySelector("[data-approach-chart]");

  if (chartWrapper) {
    const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
    let animationStarted = false;

    const startChartAnimation = () => {
      if (animationStarted) {
        return;
      }

      animationStarted = true;
      requestAnimationFrame(() => {
        chartWrapper.classList.add("animate");
      });
    };

    if (motionQuery.matches || !("IntersectionObserver" in window)) {
      startChartAnimation();
    } else {
      const chartObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              startChartAnimation();
              chartObserver.disconnect();
            }
          });
        },
        { threshold: 0.35 },
      );

      chartObserver.observe(chartWrapper);
    }
  }
</script>

<script>
  const statNumbers = document.querySelectorAll<HTMLElement>("[data-count-target]");
  const statsBand = document.querySelector(".stats-band");
  const countMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
  let countAnimationHasRun = false;

  const easeOutCubic = (progress: number) => 1 - Math.pow(1 - progress, 3);

  const animateNumber = (element: HTMLElement, duration: number) => {
    const target = Number(element.dataset.countTarget);
    const startTime = performance.now();
    element.textContent = "0";

    const updateNumber = (currentTime: number) => {
      const elapsedTime = currentTime - startTime;
      const progress = Math.min(elapsedTime / duration, 1);
      const easedProgress = easeOutCubic(progress);

      element.textContent = String(Math.round(target * easedProgress));

      if (progress < 1) {
        requestAnimationFrame(updateNumber);
      } else {
        element.textContent = String(target);
      }
    };

    requestAnimationFrame(updateNumber);
  };

  const startCountUp = () => {
    if (countAnimationHasRun) {
      return;
    }

    countAnimationHasRun = true;

    statNumbers.forEach((number) => {
      animateNumber(number, 1800);
    });
  };

  if (statNumbers.length > 0 && statsBand) {
    if (countMotionQuery.matches || !("IntersectionObserver" in window)) {
      statNumbers.forEach((number) => {
        number.textContent = number.dataset.countTarget ?? number.textContent;
      });
    } else {
      const countObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              startCountUp();
              countObserver.disconnect();
            }
          });
        },
        { rootMargin: "0px 0px -10% 0px", threshold: 0.3 },
      );

      countObserver.observe(statsBand);
    }
  }

  window.addEventListener("message", (event) => {
    if (event.data === "start-count-up") {
      startCountUp();
    }
  });
</script>
