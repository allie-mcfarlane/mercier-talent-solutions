---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import { getCollection } from "astro:content";
import { services, site } from "../data/site";

const recentPosts = (await getCollection("posts"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 8);

const homeServices = [services[0], services[2], services[1], services[3]];
const marqueeItems = [
  "Leadership",
  "Communication",
  "Executive Presence",
  "Feedback",
  "Delegation",
  "Business Development",
  "Time Management",
  "Team Effectiveness",
  "Career Strategy",
];
---

<BaseLayout title="Home | Mercier Talent Solutions" description={site.description} image="/images/optimized/waiting-area-1400.jpg">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Talent development for law firms</p>
        <h1>Let's do our best work <em>together</em></h1>
        <p class="lede">
          Mercier Talent Solutions partners with law firms and legal professionals to strengthen the leadership,
          communication, and practice management capabilities that sustain excellence over time.
        </p>
        <div class="button-row">
          <a class="button" href="/services/">Explore our services</a>
          <a class="button secondary" href="/contactus/">Contact us</a>
        </div>
      </div>
      <div class="hero-panel media-frame">
        <ResponsiveImage
          src="/images/waiting-area.png"
          alt="A calm professional waiting area and office corridor"
          sizes="(min-width: 900px) 56vw, 100vw"
          eager
        />
        <div class="hero-art-circle-animation" aria-hidden="true">
          <svg viewBox="0 0 600 800" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
            <g class="floating-group">
              <g class="rings" fill="none" stroke="#E9E7E2" stroke-opacity=".32" stroke-width="1.2">
                <circle cx="430" cy="260" r="180"></circle>
                <circle cx="430" cy="260" r="260"></circle>
                <circle cx="430" cy="260" r="340"></circle>
              </g>
              <path
                class="draw"
                pathLength="1"
                d="M120 700 L300 460 L430 260"
                fill="none"
                stroke="#E9E7E2"
                stroke-opacity=".85"
                stroke-width="2"
              ></path>
              <circle class="dot dot-1" cx="120" cy="700" r="5" fill="#E9E7E2" fill-opacity=".6"></circle>
              <circle class="dot dot-2" cx="300" cy="460" r="5" fill="#E9E7E2" fill-opacity=".85"></circle>
              <circle class="dot dot-3" cx="430" cy="260" r="7" fill="#E9E7E2"></circle>
            </g>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <section class="section proof">
    <div class="container proof-grid">
      <article>
        <h2>Beyond technical excellence</h2>
        <p>The demands of legal practice are more visible and interconnected than ever, requiring lawyers to lead, communicate, and manage with greater intentionality.</p>
      </article>
      <article>
        <h2>Leadership is learned</h2>
        <p>Strong leadership, effective communication, and executive presence are learned capabilities built deliberately, not left to chance.</p>
      </article>
      <article>
        <h2>Firms built to perform</h2>
        <p>Deliberate investment in professional skills builds more engaged teams, stronger practices, and organizations positioned to perform over the long term.</p>
      </article>
    </div>
  </section>

  <section class="marquee-band" aria-label="Core focus areas">
    <div class="marquee-track">
      {[...marqueeItems, ...marqueeItems].map((item) => <span>{item}</span>)}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">What we do</p>
        <h2>How we work with firms</h2>
      </div>
      <div class="grid service-grid">
        {homeServices.map((service) => (
          <article class="card">
            <p class="eyebrow">{service.eyebrow}</p>
            <h3>{service.title}</h3>
            <p>{service.text}</p>
            <a class="button text" href="/services/">LEARN MORE</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section approach">
    <div class="container approach-grid">
      <div class="approach-copy">
        <div class="section-heading">
          <p class="eyebrow">Our approach</p>
          <h2>Grounded in the realities of legal practice</h2>
          <p>Our firm is led by Julia Mercier, a former litigator, executive coach, and seasoned legal talent professional who has designed and implemented firmwide training systems inside global law firms.</p>
        </div>
        <ul>
          <li>Practical, rigorous engagements, not generic leadership theory</li>
          <li>Deep experience inside complex, global legal organizations</li>
          <li>Insight that translates into action, habits, and systems</li>
          <li>Measurable progress for individuals, teams, and firms</li>
        </ul>
      </div>
      <div class="chart-wrapper approach-chart" data-approach-chart>
        <svg viewBox="0 0 900 800" preserveAspectRatio="none" role="img" aria-labelledby="approachChartDescription">
          <desc id="approachChartDescription">An animated line chart showing upward development over time.</desc>
          <line class="grid-line" x1="0" y1="200" x2="900" y2="200"></line>
          <line class="grid-line" x1="0" y1="400" x2="900" y2="400"></line>
          <line class="grid-line" x1="0" y1="600" x2="900" y2="600"></line>
          <polyline class="secondary-line" points="50,690 270,545 490,585 710,325 850,215"></polyline>
          <polyline class="main-line" points="50,615 270,455 490,475 710,220 850,105"></polyline>
          <circle class="data-point point-1" cx="50" cy="615" r="10"></circle>
          <circle class="data-point point-2" cx="270" cy="455" r="10"></circle>
          <circle class="data-point point-3" cx="490" cy="475" r="10"></circle>
          <circle class="data-point point-4" cx="710" cy="220" r="10"></circle>
          <circle class="data-point point-5" cx="850" cy="105" r="11"></circle>
        </svg>
      </div>
    </div>
  </section>

  <section class="section news-band">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">News & Insights</p>
        <h2>Thought leadership on modern legal practice.</h2>
      </div>
      <div class="news-list">
        {recentPosts.map((post) => (
          <a class="news-card" href={`/post/${post.slug}/`}>
            <span class="pill">{post.data.category}</span>
            <h3>{post.data.title}</h3>
            <p>{post.data.excerpt}</p>
            <span class="meta-row">Julia Mercier · {post.data.pubDate.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: min(720px, calc(100vh - 78px));
    padding: clamp(4.5rem, 9vw, 8rem) 0 clamp(3rem, 7vw, 6rem);
    background: var(--color-white);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(360px, 1.1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
  }

  .hero-copy::before {
    display: block;
    width: 92px;
    height: 3px;
    margin: 1.7rem 0 2.8rem;
    background: var(--color-blue-dark);
    content: "";
  }

  h1 {
    max-width: 820px;
    margin: 0.45rem 0 1.1rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: var(--page-title-size);
    font-weight: 700;
    line-height: 0.96;
  }

  h1 em {
    color: var(--color-blue);
    font-style: italic;
  }

  .lede {
    max-width: 680px;
    margin: 0 0 1.5rem;
    color: var(--color-muted);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
  }

  .hero-panel {
    position: relative;
    align-self: stretch;
    width: calc(100% + max(1rem, (100vw - var(--container)) / 2));
    min-height: 520px;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    clip-path: polygon(17% 0, 100% 0, 100% 100%, 0 100%);
  }

  .hero-art-circle-animation {
    position: absolute;
    inset: 0;
    z-index: 2;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-art-circle-animation svg {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .draw {
    animation: drawline 1.8s 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .dot {
    opacity: 0;
    transform: scale(0);
    transform-box: fill-box;
    transform-origin: center;
    animation: dotPop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  .dot-1 {
    animation-delay: 0.6s;
  }

  .dot-2 {
    animation-delay: 1.25s;
  }

  .dot-3 {
    animation-delay: 1.9s;
  }

  .rings {
    opacity: 0;
    transform: scale(0.92);
    transform-box: fill-box;
    transform-origin: center;
    animation: ringsIn 1.5s 1.6s ease forwards;
  }

  .floating-group {
    animation: floatGraphic 8s 3s ease-in-out infinite;
  }

  @keyframes drawline {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes dotPop {
    60% {
      opacity: 1;
      transform: scale(1.45);
    }

    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes ringsIn {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes floatGraphic {
    50% {
      transform: translateY(-10px);
    }
  }

  .proof {
    background: var(--color-white);
  }

  .proof-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    border: 1px solid var(--color-line);
    background: var(--color-white);
  }

  .proof article {
    background: var(--color-white);
    padding: clamp(1.4rem, 3vw, 2rem);
    text-align: left;
  }

  .proof article + article {
    border-left: 1px solid var(--color-line);
  }

  .proof h2 {
    margin: 0 0 0.6rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: clamp(1.65rem, 2.4vw, 2.25rem);
    font-weight: 700;
    line-height: 1.14;
  }

  .proof p {
    margin: 0;
    color: var(--color-muted);
  }

  .marquee-band {
    overflow: hidden;
    padding: 1.05rem 0;
    background: #d8d7d2;
    color: rgba(26, 43, 70, 0.58);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 34s linear infinite;
  }

  .marquee-track span {
    display: inline-flex;
    align-items: center;
    font-size: clamp(0.86rem, 1.3vw, 1.06rem);
    font-weight: 600;
  }

  .marquee-track span::after {
    margin: 0 0.9rem;
    color: rgba(69, 98, 142, 0.62);
    content: "◆";
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  .service-grid {
    margin-top: 2rem;
  }

  .approach {
    background: var(--color-blue-dark);
    color: var(--color-white);
  }

  .approach .section-heading h2,
  .approach .section-heading p {
    color: var(--color-white);
  }

  .approach-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(320px, 0.9fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .approach-copy {
    display: grid;
    gap: clamp(1.6rem, 4vw, 2.8rem);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 1rem;
  }

  li {
    border-top: 1px solid rgba(255, 255, 255, 0.24);
    padding-top: 1rem;
    color: rgba(255, 255, 255, 0.82);
  }

  .chart-wrapper {
    display: flex;
    width: 100%;
    min-height: 520px;
    align-items: stretch;
    justify-content: stretch;
    overflow: hidden;
    background: #1b2b46;
  }

  .chart-wrapper svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .grid-line {
    stroke: #2b3e5d;
    stroke-width: 2;
    opacity: 0.9;
  }

  .secondary-line {
    fill: none;
    stroke: #36547f;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.85;
  }

  .main-line {
    fill: none;
    stroke: #f2f0eb;
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .data-point {
    fill: #f2f0eb;
    stroke: rgba(255, 255, 255, 0.35);
    stroke-width: 4;
    opacity: 0;
    transform: scale(0);
    transform-box: fill-box;
    transform-origin: center;
  }

  .secondary-line,
  .main-line {
    stroke-dasharray: 2000;
    stroke-dashoffset: 2000;
  }

  .chart-wrapper.animate .secondary-line {
    animation: drawSecondary 2.8s ease-out forwards;
  }

  .chart-wrapper.animate .main-line {
    animation: drawMain 3.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: 0.2s;
  }

  .chart-wrapper.animate .data-point {
    animation: revealPoint 0.55s ease-out forwards;
  }

  .chart-wrapper.animate .point-1 {
    animation-delay: 0.45s;
  }

  .chart-wrapper.animate .point-2 {
    animation-delay: 1.1s;
  }

  .chart-wrapper.animate .point-3 {
    animation-delay: 1.75s;
  }

  .chart-wrapper.animate .point-4 {
    animation-delay: 2.4s;
  }

  .chart-wrapper.animate .point-5 {
    animation-delay: 3.05s;
  }

  @keyframes drawSecondary {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes drawMain {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes revealPoint {
    70% {
      opacity: 1;
      transform: scale(1.15);
    }

    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  .news-band {
    background: var(--color-white);
  }

  .news-list {
    display: grid;
    margin-top: 2rem;
    border-top: 1px solid var(--color-line);
  }

  .news-card {
    display: grid;
    gap: 0.55rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-line);
    text-decoration: none;
  }

  .news-card h3 {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: clamp(1.45rem, 3vw, 2.4rem);
    font-weight: 700;
  }

  .news-card p {
    max-width: 780px;
    margin: 0;
    color: var(--color-muted);
  }

  @media (max-width: 860px) {
    .hero-grid,
    .approach-grid,
    .proof-grid {
      grid-template-columns: 1fr;
    }

    .hero {
      min-height: 0;
    }

    .hero-copy::before {
      margin: 1.2rem 0 2rem;
    }

    .hero-panel {
      width: 100%;
      min-height: auto;
      aspect-ratio: 1.25;
      border-radius: var(--radius);
      clip-path: none;
      box-shadow: var(--shadow);
    }

    .hero-art-circle-animation {
      display: none;
    }

    .proof article {
      text-align: left;
    }

    .proof article + article {
      border-top: 1px solid var(--color-line);
      border-left: 0;
    }

    .chart-wrapper {
      min-height: 420px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .draw,
    .dot,
    .rings,
    .floating-group {
      animation: none;
    }

    .draw {
      stroke-dashoffset: 0;
    }

    .dot,
    .rings {
      opacity: 1;
      transform: none;
    }

    .secondary-line,
    .main-line {
      stroke-dashoffset: 0;
    }

    .data-point {
      opacity: 1;
      transform: scale(1);
    }

    .chart-wrapper.animate .secondary-line,
    .chart-wrapper.animate .main-line,
    .chart-wrapper.animate .data-point {
      animation: none;
    }
  }
</style>

<script>
  const chartWrapper = document.querySelector("[data-approach-chart]");

  if (chartWrapper) {
    const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
    let animationStarted = false;

    const startChartAnimation = () => {
      if (animationStarted) {
        return;
      }

      animationStarted = true;
      requestAnimationFrame(() => {
        chartWrapper.classList.add("animate");
      });
    };

    if (motionQuery.matches || !("IntersectionObserver" in window)) {
      startChartAnimation();
    } else {
      const chartObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              startChartAnimation();
              chartObserver.disconnect();
            }
          });
        },
        { threshold: 0.35 },
      );

      chartObserver.observe(chartWrapper);
    }
  }
</script>
