    .news-card[data-reveal] {
      animation: none;
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const homeMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
  const hero = document.querySelector<HTMLElement>(".hero");

  if (hero && !homeMotionQuery.matches) {
    let ticking = false;
    const updateHeroDepth = () => {
      const rect = hero.getBoundingClientRect();
      const progress = Math.min(Math.max(-rect.top / Math.max(rect.height, 1), 0), 1);
      hero.style.setProperty("--hero-scroll", progress.toFixed(3));
      ticking = false;
    };
    const requestHeroDepthUpdate = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(updateHeroDepth);
    };
    updateHeroDepth();
    window.addEventListener("scroll", requestHeroDepthUpdate, { passive: true });
    window.addEventListener("resize", requestHeroDepthUpdate);
  }
</script>

<script>
  const homeRevealItems = document.querySelectorAll<HTMLElement>(".proof article, .stat");
  const homeRevealMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");

  homeRevealItems.forEach((item, index) => {
    item.style.setProperty("--home-reveal-delay", `${(index % 3) * 90}ms`);
    item.setAttribute("data-reveal", "");
  });

  document.querySelectorAll<HTMLElement>(".services-preview .card, .news-card").forEach((item, index) => {
    item.style.setProperty("--home-reveal-delay", `${(index % 3) * 90}ms`);
  });

  if (homeRevealItems.length > 0) {
    if (homeRevealMotionQuery.matches || !("IntersectionObserver" in window)) {
      homeRevealItems.forEach((item) => item.classList.add("is-visible"));
    } else {
      const homeRevealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              homeRevealObserver.unobserve(entry.target);
            }
          });
        },
        { rootMargin: "0px 0px -10% 0px", threshold: 0.14 },
      );
      homeRevealItems.forEach((item) => homeRevealObserver.observe(item));
    }
  }
</script>

<script>
  const chartWrapper = document.querySelector("[data-approach-chart]");
  if (chartWrapper) {
    const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
    let animationStarted = false;
    const startChartAnimation = () => {
      if (animationStarted) return;
      animationStarted = true;
      requestAnimationFrame(() => chartWrapper.classList.add("animate"));
    };
    if (motionQuery.matches || !("IntersectionObserver" in window)) {
      startChartAnimation();
    } else {
      const chartObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              startChartAnimation();
              chartObserver.disconnect();
            }
          });
        },
        { threshold: 0.35 },
      );
      chartObserver.observe(chartWrapper);
    }
  }
</script>

<script>
  const statNumbers = document.querySelectorAll<HTMLElement>("[data-count-target]");
  const statsBand = document.querySelector(".stats-band");
  const countMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
  let countAnimationHasRun = false;
  const easeOutCubic = (progress: number) => 1 - Math.pow(1 - progress, 3);
  const animateNumber = (element: HTMLElement, duration: number) => {
    const target = Number(element.dataset.countTarget);
    const startTime = performance.now();
    element.textContent = "0";
    const updateNumber = (currentTime: number) => {
      const progress = Math.min((currentTime - startTime) / duration, 1);
      element.textContent = String(Math.round(target * easeOutCubic(progress)));
      if (progress < 1) requestAnimationFrame(updateNumber);
      else element.textContent = String(target);
    };
    requestAnimationFrame(updateNumber);
  };
  const startCountUp = () => {
    if (countAnimationHasRun) return;
    countAnimationHasRun = true;
    statNumbers.forEach((number) => animateNumber(number, 1800));
  };
  if (statNumbers.length > 0 && statsBand) {
    if (countMotionQuery.matches || !("IntersectionObserver" in window)) {
      statNumbers.forEach((number) => { number.textContent = number.dataset.countTarget ?? number.textContent; });
    } else {
      const countObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              startCountUp();
              countObserver.disconnect();
            }
          });
        },
        { rootMargin: "0px 0px -10% 0px", threshold: 0.3 },
      );
      countObserver.observe(statsBand);
    }
  }
  window.addEventListener("message", (event) => {
    if (event.data === "start-count-up") startCountUp();
  });
</script>

<script>
  const newsCarousel = document.querySelector<HTMLElement>("[data-news-carousel]");
  const newsPrev = document.querySelector<HTMLButtonElement>("[data-news-prev]");
  const newsNext = document.querySelector<HTMLButtonElement>("[data-news-next]");

  if (newsCarousel && newsPrev && newsNext) {
    const scrollCarousel = (direction: number) => {
      const card = newsCarousel.querySelector<HTMLElement>(".news-card");
      const gap = parseFloat(getComputedStyle(newsCarousel).gap || "0");
      const distance = card ? card.getBoundingClientRect().width + gap : newsCarousel.clientWidth * 0.8;
      newsCarousel.scrollBy({ left: direction * distance, behavior: "smooth" });
    };
    newsPrev.addEventListener("click", () => scrollCarousel(-1));
    newsNext.addEventListener("click", () => scrollCarousel(1));
  }
</script>
