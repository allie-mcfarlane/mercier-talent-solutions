---
import BaseLayout from "../layouts/BaseLayout.astro";
import { recentPosts, services, site } from "../data/site";
---

<BaseLayout title="Home | Mercier Talent Solutions" description={site.description}>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Talent development for law firms</p>
        <h1>Let's do our best work <em>together</em></h1>
        <p class="lede">
          Mercier Talent Solutions partners with law firms and legal professionals to strengthen the leadership,
          communication, and practice management capabilities that sustain excellence over time.
        </p>
        <div class="button-row">
          <a class="button" href="/services/">Explore our services</a>
          <a class="button secondary" href="/contactus/">Contact us</a>
        </div>
      </div>
      <div class="hero-panel" aria-label="Mercier Talent Solutions focus areas">
        <p>LEADERSHIP ◆ COMMUNICATION ◆ EXECUTIVE PRESENCE ◆ FEEDBACK ◆ DELEGATION ◆ BUSINESS DEVELOPMENT ◆ TIME MANAGEMENT ◆ TEAM EFFECTIVENESS ◆ CAREER STRATEGY ◆</p>
      </div>
    </div>
  </section>

  <section class="section proof">
    <div class="container proof-grid">
      <article>
        <h2>Beyond technical excellence</h2>
        <p>The demands of legal practice are more visible and interconnected than ever, requiring lawyers to lead, communicate, and manage with greater intentionality.</p>
      </article>
      <article>
        <h2>Leadership is learned</h2>
        <p>Strong leadership, effective communication, and executive presence are learned capabilities built deliberately, not left to chance.</p>
      </article>
      <article>
        <h2>Firms built to perform</h2>
        <p>Deliberate investment in professional skills builds more engaged teams, stronger practices, and organizations positioned to perform over the long term.</p>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">What we do</p>
        <h2>How we work with firms</h2>
      </div>
      <div class="grid service-grid">
        {services.map((service) => (
          <article class="card">
            <p class="eyebrow">{service.eyebrow}</p>
            <h3>{service.title}</h3>
            <p>{service.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section approach">
    <div class="container approach-grid">
      <div class="section-heading">
        <p class="eyebrow">Our approach</p>
        <h2>Grounded in the realities of legal practice</h2>
        <p>Our firm is led by Julia Mercier, a former litigator, executive coach, and seasoned legal talent professional who has designed and implemented firmwide training systems inside global law firms.</p>
      </div>
      <ul>
        <li>Practical, rigorous engagements, not generic leadership theory</li>
        <li>Deep experience inside complex, global legal organizations</li>
        <li>Insight that translates into action, habits, and systems</li>
        <li>Measurable progress for individuals, teams, and firms</li>
      </ul>
    </div>
  </section>

  <section class="section news-band">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">News & Insights</p>
        <h2>Thought leadership on modern legal practice.</h2>
      </div>
      <div class="news-list">
        {recentPosts.map((post) => (
          <a class="news-card" href={post.href}>
            <h3>{post.title}</h3>
            <p>{post.excerpt}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: clamp(4.5rem, 9vw, 8rem) 0 clamp(3rem, 7vw, 6rem);
    background:
      linear-gradient(120deg, rgba(245, 245, 243, 0.94), rgba(245, 245, 243, 0.74)),
      radial-gradient(circle at 84% 12%, rgba(69, 98, 142, 0.18), transparent 34%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.16fr) minmax(280px, 0.84fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  h1 {
    max-width: 820px;
    margin: 0.45rem 0 1.1rem;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: clamp(3rem, 8vw, 7rem);
    font-weight: 500;
    line-height: 0.96;
  }

  h1 em {
    color: var(--color-blue);
    font-style: italic;
  }

  .lede {
    max-width: 680px;
    margin: 0 0 1.5rem;
    color: var(--color-muted);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
  }

  .hero-panel {
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-white);
    box-shadow: var(--shadow);
    padding: clamp(1.4rem, 4vw, 2rem);
  }

  .hero-panel p {
    margin: 0;
    color: var(--color-blue-dark);
    font-size: clamp(1.4rem, 3vw, 2.3rem);
    font-weight: 800;
    line-height: 1.18;
  }

  .proof {
    background: var(--color-white);
  }

  .proof-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
  }

  .proof article {
    background: var(--color-white);
    padding: clamp(1.4rem, 3vw, 2rem);
  }

  .proof h2 {
    margin: 0 0 0.6rem;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: clamp(1.45rem, 3vw, 2.35rem);
    font-weight: 500;
  }

  .proof p {
    margin: 0;
    color: var(--color-muted);
  }

  .service-grid {
    margin-top: 2rem;
  }

  .approach {
    background: var(--color-blue-dark);
    color: var(--color-white);
  }

  .approach .section-heading h2,
  .approach .section-heading p {
    color: var(--color-white);
  }

  .approach-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.72fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 1rem;
  }

  li {
    border-top: 1px solid rgba(255, 255, 255, 0.24);
    padding-top: 1rem;
    color: rgba(255, 255, 255, 0.82);
  }

  .news-band {
    background: var(--color-white);
  }

  .news-list {
    display: grid;
    margin-top: 2rem;
    border-top: 1px solid var(--color-line);
  }

  .news-card {
    display: grid;
    gap: 0.55rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-line);
    text-decoration: none;
  }

  .news-card h3 {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: clamp(1.45rem, 3vw, 2.4rem);
    font-weight: 500;
  }

  .news-card p {
    max-width: 780px;
    margin: 0;
    color: var(--color-muted);
  }

  @media (max-width: 860px) {
    .hero-grid,
    .approach-grid,
    .proof-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
