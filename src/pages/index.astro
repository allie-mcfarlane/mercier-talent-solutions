  @media (min-width: 1800px) {
    .hero-grid { grid-template-columns: minmax(520px, 36%) minmax(0, 64%); }
    .hero-copy { max-width: 630px; }
    .hero-art-circle-animation svg { width: 86%; right: 0; }
  }

  @media (max-width: 1200px) {
