---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import { getEntry } from "astro:content";
import { site } from "../data/site";

type HomeData = {
  eyebrow: string;
  title: string;
  titleAccent: string;
  lede: string;
  primaryCta: { label: string; href: string };
  secondaryCta: { label: string; href: string };
  proof: { title: string; text: string }[];
  marqueeItems: string[];
  approach: { eyebrow: string; title: string; text: string; items: string[] };
  news: { eyebrow: string; title: string };
};

type ServiceItem = {
  eyebrow: string;
  title: string;
  text: string;
};

const home = await getEntry("pages", "home");
const servicesPage = await getEntry("pages", "services");
if (!home || !servicesPage || !servicesPage.data.services) {
  throw new Error("Home page content is missing.");
}

const serviceItems = servicesPage.data.services as ServiceItem[];
const homeServices = [serviceItems[0], serviceItems[1], serviceItems[2], serviceItems[3]];
const homeData = home.data as HomeData;
---

<BaseLayout title="Home | Mercier Talent Solutions" description={site.description} image="/images/optimized/waiting-area-1400.jpg">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{homeData.eyebrow}</p>
        <h1>{homeData.title} <em>{homeData.titleAccent}</em></h1>
        <p class="lede">{homeData.lede}</p>
        <div class="button-row">
          <a class="button" href={homeData.primaryCta.href}>{homeData.primaryCta.label}</a>
          <a class="button secondary" href={homeData.secondaryCta.href}>{homeData.secondaryCta.label}</a>
        </div>
      </div>
      <div class="hero-panel media-frame">
        <ResponsiveImage
          src="/images/waiting-area.png"
          alt="A calm professional waiting area and office corridor"
          sizes="(min-width: 900px) 56vw, 100vw"
          eager
        />
        <div class="hero-art-circle-animation" aria-hidden="true">
          <svg viewBox="0 0 600 800" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
            <g class="floating-group">
              <g class="rings" fill="none" stroke="#E9E7E2" stroke-opacity=".32" stroke-width="1.2">
                <circle cx="430" cy="260" r="180"></circle>
                <circle cx="430" cy="260" r="260"></circle>
                <circle cx="430" cy="260" r="340"></circle>
              </g>
              <path
                class="draw"
                pathLength="1"
                d="M120 700 L300 460 L430 260"
                fill="none"
                stroke="#E9E7E2"
                stroke-opacity=".85"
                stroke-width="2"
              ></path>
              <circle class="dot dot-1" cx="120" cy="700" r="5" fill="#E9E7E2" fill-opacity=".6"></circle>
              <circle class="dot dot-2" cx="300" cy="460" r="5" fill="#E9E7E2" fill-opacity=".85"></circle>
              <circle class="dot dot-3" cx="430" cy="260" r="7" fill="#E9E7E2"></circle>
            </g>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <section class="section proof">
    <div class="container proof-grid">
      {homeData.proof.map((item) => (
        <article>
          <h2>{item.title}</h2>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="marquee-band" aria-label="Core focus areas">
    <div class="marquee-track">
      {[...homeData.marqueeItems, ...homeData.marqueeItems].map((item) => <span>{item}</span>)}
    </div>
  </section>

  <section class="section services-preview">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">What we do</p>
        <h2>How we work with firms</h2>
      </div>
      <div class="grid service-grid">
        {homeServices.map((service) => (
          <article class="card">
            <p class="eyebrow">{service.eyebrow}</p>
            <h3>{service.title}</h3>
            <p>{service.text}</p>
            <a class="button text" href="/services/">LEARN MORE</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section approach">
    <div class="container approach-grid">
      <div class="approach-copy">
        <div class="section-heading">
          <p class="eyebrow">{homeData.approach.eyebrow}</p>
          <h2>{homeData.approach.title}</h2>
          <p>{homeData.approach.text}</p>
        </div>
        <ul>
          {homeData.approach.items.map((item) => <li>{item}</li>)}
        </ul>
        <a class="button secondary approach-cta" href="/about/">Meet the team</a>
      </div>
      <div class="chart-wrapper approach-chart" data-approach-chart>
        <svg viewBox="0 0 900 800" preserveAspectRatio="none" role="img" aria-labelledby="approachChartDescription">
          <desc id="approachChartDescription">An animated line chart showing upward development over time.</desc>
          <line class="grid-line" x1="0" y1="200" x2="900" y2="200"></line>
          <line class="grid-line" x1="0" y1="400" x2="900" y2="400"></line>
          <line class="grid-line" x1="0" y1="600" x2="900" y2="600"></line>
          <polyline class="secondary-line" points="50,690 270,545 490,585 710,325 850,215"></polyline>
          <polyline class="main-line" points="50,615 270,455 490,475 710,220 850,105"></polyline>
          <circle class="data-point point-1" cx="50" cy="615" r="10"></circle>
          <circle class="data-point point-2" cx="270" cy="455" r="10"></circle>
          <circle class="data-point point-3" cx="490" cy="475" r="10"></circle>
          <circle class="data-point point-4" cx="710" cy="220" r="10"></circle>
          <circle class="data-point point-5" cx="850" cy="105" r="11"></circle>
        </svg>
      </div>
    </div>
  </section>

  <section class="section news-band">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">{homeData.news.eyebrow}</p>
        <h2>{homeData.news.title}</h2>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    height: 530px;
    min-height: 530px;
    padding: 0;
    background: var(--color-white);
  }

  .hero-grid {
    display: grid;
    height: 100%;
    grid-template-columns: minmax(340px, 360px) minmax(0, 1fr);
    gap: 48px;
    align-items: start;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    width: min(590px, calc(100vw - 80px));
  }

  .hero-copy::before {
    display: block;
    width: 92px;
    height: 3px;
    margin: 1.5rem 0 2.6rem;
    background: var(--color-blue-dark);
    content: "";
  }

  h1 {
    max-width: 820px;
    margin: 0.45rem 0 1.1rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: var(--page-title-size);
    font-weight: 700;
    line-height: 1.2;
  }

  h1 em {
    color: var(--color-blue);
    font-style: italic;
  }

  .lede {
    max-width: 680px;
    margin: 0 0 1.5rem;
    color: var(--color-muted);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
  }

  .hero-panel {
    position: relative;
    align-self: stretch;
    width: calc(100% + max(1rem, (100vw - var(--container)) / 2) + 4rem);
    height: 546px;
    min-height: 546px;
    margin-top: -17px;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    clip-path: polygon(17% 0, 100% 0, 100% 100%, 0 100%);
  }

  .hero-art-circle-animation {
    position: absolute;
    inset: 0;
    z-index: 2;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-art-circle-animation svg {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .draw {
    animation: drawline 2.2s 0.35s var(--ease-smooth) forwards;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .dot {
    opacity: 0;
    transform: scale(0);
    transform-box: fill-box;
    transform-origin: center;
    animation: dotPop 0.72s cubic-bezier(0.34, 1.36, 0.64, 1) forwards;
  }

  .dot-1 {
    animation-delay: 0.6s;
  }

  .dot-2 {
    animation-delay: 1.25s;
  }

  .dot-3 {
    animation-delay: 1.9s;
  }

  .rings {
    opacity: 0;
    transform: scale(0.92);
    transform-box: fill-box;
    transform-origin: center;
    animation: ringsIn 1.8s 1.45s var(--ease-smooth) forwards;
  }

  .floating-group {
    animation: floatGraphic 11s 3s ease-in-out infinite;
  }

  @keyframes drawline {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes dotPop {
    60% {
      opacity: 1;
      transform: scale(1.45);
    }

    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes ringsIn {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes floatGraphic {
    50% {
      transform: translateY(-6px);
    }
  }

  .proof {
    background: var(--color-white);
    padding: 0;
  }

  .proof-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    border: 1px solid var(--color-line);
    background: var(--color-white);
    min-height: 236px;
  }

  .proof article {
    background: var(--color-white);
    padding: clamp(1.55rem, 3vw, 2rem);
    text-align: left;
  }

  .proof article + article {
    border-left: 1px solid var(--color-line);
  }

  .proof h2 {
    margin: 0 0 0.6rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: clamp(1.65rem, 2.4vw, 2.25rem);
    font-weight: 700;
    line-height: 1.14;
  }

  .proof p {
    margin: 0;
    color: var(--color-muted);
  }

  .marquee-band {
    overflow: hidden;
    padding: 1.32rem 0;
    background: #d8d7d2;
    color: rgba(26, 43, 70, 0.58);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 42s linear infinite;
  }

  .marquee-track span {
    display: inline-flex;
    align-items: center;
    font-size: clamp(0.86rem, 1.3vw, 1.06rem);
    font-weight: 600;
  }

  .marquee-track span::after {
    margin: 0 0.9rem;
    color: rgba(69, 98, 142, 0.62);
    content: "◆";
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  .service-grid {
    margin-top: 34px;
  }

  .services-preview {
    padding: 387px 0 121px;
  }

  .services-preview .section-heading {
    max-width: 543px;
    gap: 49px;
  }

  .services-preview .section-heading h2 {
    width: min(436px, 100%);
    font-size: 20px;
    line-height: 1.3;
  }

  .services-preview .service-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 35px 24px;
  }

  .services-preview .card {
    min-height: 296px;
    padding: 40px 34px 28px;
  }

  .services-preview .card h3 {
    margin: 19px 0 14px;
    font-size: 16px;
    line-height: 1.5;
  }

  .services-preview .card p:not(.eyebrow) {
    max-width: 522px;
    font-size: 16px;
    line-height: 1.5;
  }

  .approach {
    min-height: 523px;
    padding: 0;
    background: var(--color-white);
    color: var(--color-text);
  }

  .approach-grid {
    display: grid;
    min-height: 523px;
    grid-template-columns: minmax(0, 671px) minmax(380px, 1fr);
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: stretch;
  }

  .approach-copy {
    display: grid;
    align-content: start;
    gap: 28px;
    padding-top: 48px;
  }

  .approach .section-heading {
    max-width: 588px;
    gap: 46px;
  }

  .approach .section-heading h2 {
    font-size: 19px;
    line-height: 1.3;
  }

  .approach .section-heading p:not(.eyebrow) {
    max-width: 588px;
    font-size: 16px;
    line-height: 1.5;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 12px;
  }

  li {
    border-top: 0;
    padding-top: 0;
    padding-left: 31px;
    color: var(--color-text);
    font-size: 15px;
    line-height: 1.5;
  }

  .approach-cta {
    justify-self: start;
    margin-top: 2px;
    border-color: var(--color-blue);
    color: var(--color-blue);
  }

  .chart-wrapper {
    display: flex;
    width: 100%;
    min-height: 523px;
    align-items: stretch;
    justify-content: stretch;
    overflow: hidden;
    background: #1b2b46;
  }

  .chart-wrapper svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .grid-line {
    stroke: #2b3e5d;
    stroke-width: 2;
    opacity: 0.9;
  }

  .secondary-line {
    fill: none;
    stroke: #36547f;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.85;
  }

  .main-line {
    fill: none;
    stroke: #f2f0eb;
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .data-point {
    fill: #f2f0eb;
    stroke: rgba(255, 255, 255, 0.35);
    stroke-width: 4;
    opacity: 0;
    transform: scale(0);
    transform-box: fill-box;
    transform-origin: center;
  }

  .secondary-line,
  .main-line {
    stroke-dasharray: 2000;
    stroke-dashoffset: 2000;
  }

  .chart-wrapper.animate .secondary-line {
    animation: drawSecondary 3.15s var(--ease-smooth) forwards;
  }

  .chart-wrapper.animate .main-line {
    animation: drawMain 3.95s var(--ease-smooth) forwards;
    animation-delay: 0.2s;
  }

  .chart-wrapper.animate .data-point {
    animation: revealPoint 0.68s var(--ease-soft) forwards;
  }

  .chart-wrapper.animate .point-1 {
    animation-delay: 0.45s;
  }

  .chart-wrapper.animate .point-2 {
    animation-delay: 1.1s;
  }

  .chart-wrapper.animate .point-3 {
    animation-delay: 1.75s;
  }

  .chart-wrapper.animate .point-4 {
    animation-delay: 2.4s;
  }

  .chart-wrapper.animate .point-5 {
    animation-delay: 3.05s;
  }

  @keyframes drawSecondary {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes drawMain {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes revealPoint {
    70% {
      opacity: 1;
      transform: scale(1.15);
    }

    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  .news-band {
    min-height: 2392px;
    padding: 46px 0 0;
    background: var(--color-white);
  }

  .news-band .section-heading {
    max-width: 1202px;
    gap: 24px;
  }

  .news-band .section-heading h2 {
    max-width: 585px;
    font-size: 20px;
    line-height: 1.3;
  }

  @media (max-width: 860px) {
    .hero-grid,
    .approach-grid,
    .proof-grid,
    .services-preview .service-grid {
      grid-template-columns: 1fr;
    }

    .hero {
      height: auto;
      min-height: 0;
      padding: clamp(3.75rem, 10vw, 5rem) 0 clamp(3rem, 8vw, 4rem);
    }

    .hero-copy::before {
      margin: 1.2rem 0 2rem;
    }

    .hero-panel {
      width: 100%;
      min-height: auto;
      aspect-ratio: 1.25;
      border-radius: var(--radius);
      clip-path: none;
      box-shadow: var(--shadow);
    }

    .hero-art-circle-animation {
      display: none;
    }

    .proof article {
      text-align: left;
    }

    .proof article + article {
      border-top: 1px solid var(--color-line);
      border-left: 0;
    }

    .chart-wrapper {
      min-height: 420px;
    }

    .services-preview {
      padding: clamp(4rem, 12vw, 6rem) 0;
    }

    .services-preview .section-heading,
    .approach .section-heading {
      gap: 0.72rem;
    }

    .approach {
      padding: clamp(4rem, 12vw, 6rem) 0;
    }

    .approach-grid {
      min-height: 0;
    }

    .approach-copy {
      padding-top: 0;
    }

    .news-band {
      min-height: 0;
      padding: clamp(4rem, 12vw, 6rem) 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .draw,
    .dot,
    .rings,
    .floating-group {
      animation: none;
    }

    .draw {
      stroke-dashoffset: 0;
    }

    .dot,
    .rings {
      opacity: 1;
      transform: none;
    }

    .secondary-line,
    .main-line {
      stroke-dashoffset: 0;
    }

    .data-point {
      opacity: 1;
      transform: scale(1);
    }

    .chart-wrapper.animate .secondary-line,
    .chart-wrapper.animate .main-line,
    .chart-wrapper.animate .data-point {
      animation: none;
    }
  }
</style>

<script>
  const chartWrapper = document.querySelector("[data-approach-chart]");

  if (chartWrapper) {
    const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
    let animationStarted = false;

    const startChartAnimation = () => {
      if (animationStarted) {
        return;
      }

      animationStarted = true;
      requestAnimationFrame(() => {
        chartWrapper.classList.add("animate");
      });
    };

    if (motionQuery.matches || !("IntersectionObserver" in window)) {
      startChartAnimation();
    } else {
      const chartObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              startChartAnimation();
              chartObserver.disconnect();
            }
          });
        },
        { threshold: 0.35 },
      );

      chartObserver.observe(chartWrapper);
    }
  }
</script>
