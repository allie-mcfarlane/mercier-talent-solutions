---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import { getCollection, getEntry } from "astro:content";
import { site } from "../data/site";

type HomeData = {
  eyebrow: string;
  title: string;
  titleAccent: string;
  lede: string;
  primaryCta: { label: string; href: string };
  secondaryCta: { label: string; href: string };
  proof: { title: string; text: string }[];
  marqueeItems: string[];
  approach: { eyebrow: string; title: string; text: string; items: string[] };
  news: { eyebrow: string; title: string };
};

type ServiceItem = {
  eyebrow: string;
  title: string;
  text: string;
};

const home = await getEntry("pages", "home");
const servicesPage = await getEntry("pages", "services");
if (!home || !servicesPage || !servicesPage.data.services) {
  throw new Error("Home page content is missing.");
}

const serviceItems = servicesPage.data.services as ServiceItem[];
const homeServices = [serviceItems[0], serviceItems[1], serviceItems[2], serviceItems[3]];
const homeData = home.data as HomeData;
const recentPosts = (await getCollection("posts"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 8);
const dateFormat = { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" } as const;
const stats = [
  { value: "15", suffix: "+", text: "Years of developing lawyers in-house and as a consultant for global firms" },
  { value: "20", suffix: "+", text: "Coaching, assessment & training offerings" },
  { value: "15", suffix: "+", text: "Signature training programs for legal teams" },
];
---

<BaseLayout title="Home | Mercier Talent Solutions" description={site.description} image="/images/optimized/waiting-area-1400.jpg">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <a class="eyebrow eyebrow-link" href="/services/">{homeData.eyebrow}</a>
        <h1>{homeData.title} <em>{homeData.titleAccent}</em></h1>
        <p class="lede">{homeData.lede}</p>
        <div class="button-row">
          <a class="button" href={homeData.primaryCta.href}>{homeData.primaryCta.label}</a>
          <a class="button secondary" href={homeData.secondaryCta.href}>{homeData.secondaryCta.label}</a>
        </div>
      </div>
      <div class="hero-panel media-frame">
        <ResponsiveImage
          src="/images/waiting-area.png"
          alt="A calm professional waiting area and office corridor"
          sizes="(min-width: 900px) 60vw, 100vw"
          eager
        />
        <div class="hero-art-circle-animation" aria-hidden="true">
          <svg viewBox="0 0 600 800" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
            <g class="floating-group">
              <g class="rings" fill="none" stroke="#E9E7E2" stroke-opacity=".32" stroke-width="1.2">
                <circle cx="430" cy="260" r="180"></circle>
                <circle cx="430" cy="260" r="260"></circle>
                <circle cx="430" cy="260" r="340"></circle>
              </g>
              <path class="draw" pathLength="1" d="M120 700 L300 460 L430 260" fill="none" stroke="#E9E7E2" stroke-opacity=".85" stroke-width="2"></path>
              <circle class="dot dot-1" cx="120" cy="700" r="5" fill="#E9E7E2" fill-opacity=".6"></circle>
              <circle class="dot dot-2" cx="300" cy="460" r="5" fill="#E9E7E2" fill-opacity=".85"></circle>
              <circle class="dot dot-3" cx="430" cy="260" r="7" fill="#E9E7E2"></circle>
            </g>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <section class="section proof">
    <div class="container proof-grid">
      {homeData.proof.map((item) => (
        <article>
          <h2>{item.title}</h2>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="marquee-band" aria-label="Core focus areas">
    <div class="marquee-track">
      {[...homeData.marqueeItems, ...homeData.marqueeItems].map((item) => <span>{item}</span>)}
    </div>
  </section>

  <section class="section stats-band">
    <div class="container stats-grid">
      {stats.map((item) => (
        <article class="stat">
          <div class="number-row" aria-label={`${item.value}${item.suffix}`}>
            <span class="stat-number" data-count-target={item.value}>{item.value}</span>
            <span class="suffix" aria-hidden="true">{item.suffix}</span>
          </div>
          <p class="description">{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section services-preview">
    <div class="container">
      <div class="section-heading">
        <a class="eyebrow eyebrow-link" href="/services/">What we do</a>
        <h2>How we work with firms</h2>
      </div>
      <div class="grid service-grid">
        {homeServices.map((service) => (
          <article class="card">
            <p class="eyebrow">{service.eyebrow}</p>
            <h3>{service.title}</h3>
            <p>{service.text}</p>
            <a class="button text" href="/services/">LEARN MORE</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section approach">
    <div class="container approach-grid">
      <div class="approach-copy">
        <div class="section-heading">
          <a class="eyebrow eyebrow-link" href="/about/">{homeData.approach.eyebrow}</a>
          <h2>{homeData.approach.title}</h2>
          <p>{homeData.approach.text}</p>
        </div>
        <ul>
          {homeData.approach.items.map((item) => <li>{item}</li>)}
        </ul>
        <a class="button secondary approach-cta" href="/about/">Meet the team</a>
      </div>
      <div class="chart-wrapper approach-chart" data-approach-chart>
        <svg viewBox="0 0 900 800" preserveAspectRatio="none" role="img" aria-labelledby="approachChartDescription">
          <desc id="approachChartDescription">An animated line chart showing upward development over time.</desc>
          <line class="grid-line" x1="0" y1="200" x2="900" y2="200"></line>
          <line class="grid-line" x1="0" y1="400" x2="900" y2="400"></line>
          <line class="grid-line" x1="0" y1="600" x2="900" y2="600"></line>
          <polyline class="secondary-line" points="50,690 270,545 490,585 710,325 850,215"></polyline>
          <polyline class="main-line" points="50,615 270,455 490,475 710,220 850,105"></polyline>
          <circle class="data-point point-1" cx="50" cy="615" r="10"></circle>
          <circle class="data-point point-2" cx="270" cy="455" r="10"></circle>
          <circle class="data-point point-3" cx="490" cy="475" r="10"></circle>
          <circle class="data-point point-4" cx="710" cy="220" r="10"></circle>
          <circle class="data-point point-5" cx="850" cy="105" r="11"></circle>
        </svg>
      </div>
    </div>
  </section>

  <section class="section news-band">
    <div class="container">
      <div class="news-heading-row">
        <div class="section-heading">
          <a class="eyebrow eyebrow-link" href="/news/">{homeData.news.eyebrow}</a>
          <h2>{homeData.news.title}</h2>
        </div>
        <div class="news-controls" aria-label="News carousel controls">
          <button type="button" class="news-control" data-news-prev aria-label="Previous articles">←</button>
          <button type="button" class="news-control" data-news-next aria-label="Next articles">→</button>
        </div>
      </div>
      <div class="news-list" data-news-carousel>
        {recentPosts.map((post) => (
          <a class="card news-card" href={`/post/${post.slug}/`}>
            <span class="pill">{post.data.category}</span>
            <h3>{post.data.title}</h3>
            <p>{post.data.excerpt}</p>
            <span class="meta-row news-author">
              <img src={post.data.image ?? "/images/julia-mercier.jpg"} alt="" loading="lazy" />
              <span>{post.data.author} · {post.data.pubDate.toLocaleDateString("en-US", dateFormat)}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .eyebrow-link {
    width: fit-content;
    text-decoration: none;
  }

  .eyebrow-link:hover,
  .eyebrow-link:focus-visible {
    color: var(--color-blue-dark);
  }

  .section-heading {
    gap: 1rem;
  }

  .hero {
    position: relative;
    --hero-scroll: 0;
    overflow: hidden;
    height: clamp(525px, 31vw, 590px);
    min-height: 525px;
    padding: 0;
    background: var(--color-white);
    isolation: isolate;
  }

  .hero-grid {
    display: grid;
    height: 100%;
    width: 100%;
    max-width: none;
    grid-template-columns: minmax(450px, 39%) minmax(0, 61%);
    gap: 0;
    align-items: stretch;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    width: calc(100% - var(--page-gutter));
    max-width: 610px;
    margin-left: var(--page-gutter);
    padding-top: clamp(1.15rem, 1.8vw, 1.75rem);
    padding-right: clamp(1.5rem, 2.4vw, 2.6rem);
    transform: translate3d(0, calc(var(--hero-scroll) * 12px), 0);
    transition: transform 80ms linear;
    will-change: transform;
  }

  .hero .eyebrow {
    margin-top: 0;
    font-size: 15px;
    letter-spacing: 5.4px;
    white-space: nowrap;
  }

  h1::before {
    display: block;
    width: 82px;
    height: 2px;
    margin: 1.25rem 0 1.25rem;
    background: var(--color-blue-dark);
    content: "";
  }

  h1 {
    max-width: 585px;
    margin: 0 0 1.15rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: clamp(2.8rem, 3.15vw, 4.05rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.08;
  }

  h1 em {
    color: var(--color-blue);
    font-style: italic;
  }

  .lede {
    max-width: 540px;
    margin: 0 0 1.35rem;
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.58;
  }

  .hero .button {
    min-width: 158px;
    min-height: 42px;
    padding: 0.62rem 1.2rem;
    font-size: 0.88rem;
    font-weight: 500;
  }

  .hero .button-row {
    gap: 0.85rem 1rem;
  }

  .hero-panel {
    position: relative;
    align-self: stretch;
    width: 100%;
    height: calc(100% + 14px);
    min-height: calc(100% + 14px);
    margin-top: -14px;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    clip-path: polygon(9% 0, 100% 0, 100% 100%, 0 100%);
    transform: translate3d(0, calc(var(--hero-scroll) * -8px), 0);
    transition: transform 80ms linear;
    will-change: transform;
  }

  .hero-panel img {
    transform: scale(calc(1.015 + (var(--hero-scroll) * 0.03)));
    transform-origin: center;
  }

  .hero-art-circle-animation {
    position: absolute;
    inset: 0;
    z-index: 2;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-art-circle-animation svg {
    position: absolute;
    top: -3%;
    right: -3%;
    display: block;
    width: 92%;
    height: 106%;
    transform: translate3d(calc(var(--hero-scroll) * -8px), calc(var(--hero-scroll) * -8px), 0)
      scale(calc(1.015 + (var(--hero-scroll) * 0.03)));
    transform-origin: center;
    transition: transform 80ms linear;
    will-change: transform;
  }

  .draw {
    animation: drawline 2.2s 0.35s var(--ease-smooth) forwards;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .dot {
    opacity: 0;
    transform: scale(0);
    transform-box: fill-box;
    transform-origin: center;
    animation: dotPop 0.72s cubic-bezier(0.34, 1.36, 0.64, 1) forwards;
  }

  .dot-1 { animation-delay: 0.6s; }
  .dot-2 { animation-delay: 1.25s; }
  .dot-3 { animation-delay: 1.9s; }

  .rings {
    opacity: 0;
    transform: scale(0.92);
    transform-box: fill-box;
    transform-origin: center;
    animation: ringsIn 1.8s 1.45s var(--ease-smooth) forwards;
  }

  .floating-group { animation: floatGraphic 11s 3s ease-in-out infinite; }

  @keyframes drawline { to { stroke-dashoffset: 0; } }
  @keyframes dotPop {
    60% { opacity: 1; transform: scale(1.35); }
    100% { opacity: 1; transform: scale(1); }
  }
  @keyframes ringsIn { to { opacity: 1; transform: scale(1); } }
  @keyframes floatGraphic { 50% { transform: translateY(-5px); } }

  .proof {
    background: var(--color-blue-dark);
    padding: 0;
  }

  .proof-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    min-height: 210px;
    background: var(--color-blue-dark);
  }

  .proof article {
    display: grid;
    align-content: center;
    padding: clamp(1.7rem, 2.6vw, 2.25rem);
    text-align: center;
  }

  .proof article + article { border-left: 1px solid rgba(255, 255, 255, 0.1); }

  .proof h2 {
    margin: 0 0 0.75rem;
    color: var(--color-white);
    font-size: 19px;
    line-height: 1.35;
  }

  .proof p {
    max-width: 400px;
    margin: 0 auto;
    color: rgba(255, 255, 255, 0.84);
    font-size: 16.5px;
    line-height: 1.55;
  }

  .marquee-band {
    overflow: hidden;
    padding: 1.05rem 0;
    background: #d8d7d2;
    color: rgba(26, 43, 70, 0.58);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 42s linear infinite;
  }

  .marquee-track span {
    display: inline-flex;
    align-items: center;
    font-size: clamp(0.82rem, 1vw, 1rem);
    font-weight: 600;
  }

  .marquee-track span::after {
    margin: 0 0.9rem;
    color: rgba(69, 98, 142, 0.62);
    content: "◆";
  }

  @keyframes marquee { to { transform: translateX(-50%); } }

  .stats-band {
    padding: clamp(3.6rem, 4.8vw, 4.6rem) 0;
    background: var(--color-white);
  }

  .stats-grid {
    display: grid;
    min-height: 180px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: 100%;
    background: var(--color-white);
  }

  .stat {
    display: flex;
    min-width: 0;
    min-height: 180px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 28px 30px;
    text-align: center;
  }

  .stat + .stat { border-left: 0; }

  .number-row {
    display: flex;
    width: 100%;
    align-items: baseline;
    justify-content: center;
    margin-bottom: 12px;
    line-height: 1;
  }

  .stat-number {
    color: #172641;
    font-family: var(--font-heading);
    font-size: clamp(52px, 4vw, 62px);
    font-weight: 700;
    letter-spacing: -2px;
  }

  .suffix {
    margin-left: 5px;
    color: var(--color-blue);
    font-family: var(--font-heading);
    font-size: clamp(36px, 3vw, 43px);
    font-weight: 500;
  }

  .description {
    width: 100%;
    max-width: 320px;
    margin: 0;
    color: var(--color-ink);
    font-size: 16.5px;
    line-height: 1.5;
  }

  .services-preview {
    padding: clamp(4.5rem, 6vw, 6rem) 0 clamp(5rem, 7vw, 7rem);
  }

  .services-preview .section-heading,
  .approach .section-heading,
  .news-band .section-heading {
    gap: 1rem;
  }

  .services-preview .section-heading .eyebrow,
  .approach .section-heading .eyebrow,
  .news-band .section-heading .eyebrow {
    font-size: 15px;
    letter-spacing: 6px;
  }

  .services-preview .section-heading h2,
  .approach .section-heading h2,
  .news-band .section-heading h2 {
    margin: 0;
    font-size: clamp(1.45rem, 1.6vw, 1.8rem);
    line-height: 1.25;
  }

  .service-grid { margin-top: clamp(2rem, 3vw, 2.75rem); }

  .services-preview .service-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 1.5vw, 1.4rem);
  }

  .services-preview .card {
    min-height: 286px;
    border-radius: 2px;
    padding: clamp(1.8rem, 2vw, 2.15rem) clamp(1.4rem, 1.8vw, 1.8rem);
    box-shadow: none;
  }

  .services-preview .card .eyebrow {
    font-size: 12.5px;
    letter-spacing: 3px;
  }

  .services-preview .card h3 {
    margin: 0.9rem 0 0.9rem;
    font-size: 17px;
    line-height: 1.4;
  }

  .services-preview .card p:not(.eyebrow) {
    font-size: 16.5px;
    line-height: 1.55;
  }

  .services-preview .card .button.text { margin-top: 1.15rem; }

  .approach {
    padding: clamp(4.5rem, 6vw, 6rem) 0;
    background: var(--color-white);
  }

  .approach-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(360px, 430px);
    gap: clamp(3rem, 6vw, 7rem);
    align-items: center;
  }

  .approach-copy {
    display: grid;
    max-width: 680px;
    align-content: center;
    gap: 1.75rem;
  }

  .approach .section-heading p:not(.eyebrow) {
    max-width: 640px;
    color: var(--color-ink);
    font-size: 16.5px;
    line-height: 1.58;
  }

  ul {
    display: grid;
    gap: 11px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    position: relative;
    padding-left: 29px;
    color: var(--color-ink);
    font-size: 16px;
    line-height: 1.5;
  }

  .approach li::before {
    position: absolute;
    top: 0.45em;
    left: 3px;
    width: 10px;
    height: 6px;
    border-bottom: 2px solid var(--color-blue);
    border-left: 2px solid var(--color-blue);
    content: "";
    transform: rotate(-45deg);
  }

  .approach-cta {
    justify-self: start;
    min-width: 158px;
    min-height: 42px;
    padding: 0.62rem 1.2rem;
    font-size: 0.88rem;
    font-weight: 500;
  }

  .chart-wrapper {
    display: flex;
    width: min(100%, 430px);
    aspect-ratio: 1;
    align-items: stretch;
    justify-content: stretch;
    justify-self: center;
    overflow: hidden;
    background: #1b2b46;
  }

  .chart-wrapper svg { display: block; width: 100%; height: 100%; }
  .grid-line { stroke: #2b3e5d; stroke-width: 2; opacity: 0.9; }
  .secondary-line { fill: none; stroke: #36547f; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; opacity: 0.85; }
  .main-line { fill: none; stroke: #f2f0eb; stroke-width: 4; stroke-linecap: round; stroke-linejoin: round; }
  .data-point { fill: #f2f0eb; stroke: rgba(255, 255, 255, 0.35); stroke-width: 4; opacity: 0; transform: scale(0); transform-box: fill-box; transform-origin: center; }
  .secondary-line, .main-line { stroke-dasharray: 2000; stroke-dashoffset: 2000; }
  .chart-wrapper.animate .secondary-line { animation: drawSecondary 3.15s var(--ease-smooth) forwards; }
  .chart-wrapper.animate .main-line { animation: drawMain 3.95s var(--ease-smooth) forwards; animation-delay: 0.2s; }
  .chart-wrapper.animate .data-point { animation: revealPoint 0.68s var(--ease-soft) forwards; }
  .chart-wrapper.animate .point-1 { animation-delay: 0.45s; }
  .chart-wrapper.animate .point-2 { animation-delay: 1.1s; }
  .chart-wrapper.animate .point-3 { animation-delay: 1.75s; }
  .chart-wrapper.animate .point-4 { animation-delay: 2.4s; }
  .chart-wrapper.animate .point-5 { animation-delay: 3.05s; }
  @keyframes drawSecondary { to { stroke-dashoffset: 0; } }
  @keyframes drawMain { to { stroke-dashoffset: 0; } }
  @keyframes revealPoint { 70% { opacity: 1; transform: scale(1.15); } 100% { opacity: 1; transform: scale(1); } }

  .news-band {
    padding: clamp(4.5rem, 6vw, 6rem) 0 clamp(5rem, 6.5vw, 6.5rem);
    overflow: hidden;
    background: #f1f1ee;
  }

  .news-heading-row {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }

  .news-band .section-heading h2 { max-width: 620px; }

  .news-controls {
    display: flex;
    gap: 0.65rem;
    flex: 0 0 auto;
  }

  .news-control {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border: 1px solid rgba(69, 98, 142, 0.3);
    background: transparent;
    color: var(--color-blue-dark);
    font-size: 1.15rem;
    cursor: pointer;
    transition: background 220ms var(--ease-smooth), color 220ms var(--ease-smooth), border-color 220ms var(--ease-smooth);
  }

  .news-control:hover,
  .news-control:focus-visible {
    border-color: var(--color-blue-dark);
    background: var(--color-blue-dark);
    color: var(--color-white);
  }

  .news-list {
    display: flex;
    gap: clamp(1rem, 1.5vw, 1.4rem);
    margin-top: clamp(2.2rem, 3.5vw, 3rem);
    overflow-x: auto;
    padding-bottom: 0.4rem;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .news-list::-webkit-scrollbar { display: none; }

  .news-card {
    display: grid;
    flex: 0 0 clamp(320px, 34vw, 460px);
    min-height: 330px;
    align-content: start;
    gap: 14px;
    border-radius: 2px;
    padding: clamp(1.8rem, 2.2vw, 2.25rem);
    scroll-snap-align: start;
    text-decoration: none;
    box-shadow: none;
  }

  .news-card:first-child {
    flex-basis: clamp(390px, 48vw, 650px);
  }

  .news-card .pill {
    border-color: rgba(69, 98, 142, 0.28);
    color: var(--color-blue);
    font-size: 11px;
  }

  .news-card h3 {
    margin: 0.35rem 0 0;
    font-size: clamp(1.3rem, 1.45vw, 1.65rem);
    line-height: 1.25;
  }

  .news-card:first-child h3 {
    font-size: clamp(1.7rem, 2vw, 2.35rem);
    line-height: 1.15;
  }

  .news-card p {
    color: var(--color-ink);
    font-size: 16.5px;
