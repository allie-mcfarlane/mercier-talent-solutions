---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import { getEntry } from "astro:content";

type ServiceItem = {
  eyebrow: string;
  number: string;
  title: string;
  text: string;
  summary: string;
  detail: string;
  image: string;
  imageAlt: string;
  highlights?: { title: string; text: string }[];
};

type ServicesData = {
  eyebrow: string;
  title: string;
  titleAccent: string;
  lede: string;
  heroImage: string;
  heroImageAlt: string;
  focusIntro: string;
  focusAreas: { title: string; text: string }[];
  services: ServiceItem[];
  training: {
    eyebrow: string;
    title: string;
    groups: { group: string; items: { title: string; text: string }[] }[];
  };
  consulting: { eyebrow: string; items: ({ title: string; text: string } | string)[] };
};

const servicesPage = await getEntry("pages", "services");
if (!servicesPage || !servicesPage.data.services || !servicesPage.data.focusAreas || !servicesPage.data.training || !servicesPage.data.consulting) {
  throw new Error("Services page content is missing.");
}

const servicesData = servicesPage.data as ServicesData;
const [coaching, assessments, trainingService, consultingService] = servicesData.services;
const slugify = (value: string) => value.toLowerCase().replaceAll(" ", "-");
---

<BaseLayout title="Services | Mercier Talent Solutions" description={servicesData.lede} image="/images/optimized/services-hero-1400.jpg">
  <section class="services-hero">
    <div class="container services-hero-grid">
      <div class="section-heading hero-copy">
        <p class="eyebrow">{servicesData.eyebrow}</p>
        <h1><span>{servicesData.title}</span> <em>{servicesData.titleAccent}</em></h1>
        <p>{servicesData.lede}</p>
      </div>
      <div class="media-frame hero-image">
        <ResponsiveImage
          src={servicesData.heroImage}
          alt={servicesData.heroImageAlt}
          sizes="(min-width: 900px) 42vw, 100vw"
          eager
        />
      </div>
      <div class="hero-rings" aria-hidden="true">
        <span></span>
        <span></span>
      </div>
    </div>
  </section>

  <nav class="service-strip" aria-label="Service sections">
    <div class="container service-strip-inner">
      {servicesData.services.map((service) => <a href={`#${slugify(service.title)}`}>{service.title}</a>)}
    </div>
  </nav>

  <section class="section service-section coaching-section" id={slugify(coaching.title)}>
    <div class="container service-intro-grid">
      <div class="service-lead">
        <p class="service-number">{coaching.number}</p>
        <h2>{coaching.title}</h2>
        <p>{coaching.summary}</p>
        <div class="media-frame service-image">
          <ResponsiveImage src={coaching.image} alt={coaching.imageAlt} sizes="(min-width: 900px) 36vw, 100vw" />
        </div>
      </div>
      <div class="focus-panel">
        <p>{servicesData.focusIntro}</p>
        <div class="focus-list">
          {servicesData.focusAreas.map(({ title, text }) => (
            <article>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section service-section split-section shaded" id={slugify(assessments.title)}>
    <div class="container split-grid">
      <div class="media-frame service-image tall-image">
        <ResponsiveImage src={assessments.image} alt={assessments.imageAlt} sizes="(min-width: 900px) 38vw, 100vw" />
      </div>
      <div class="service-copy">
        <p class="service-number">{assessments.number}</p>
        <h2>{assessments.title}</h2>
        <p class="summary">{assessments.summary}</p>
        <p>{assessments.detail}</p>
        {assessments.highlights && (
          <div class="accordion-list">
            {assessments.highlights.map(({ title, text }, index) => (
              <details open={index === 0}>
                <summary>
                  <span>{title}</span>
                  <b aria-hidden="true"></b>
                </summary>
                <p>{text}</p>
              </details>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="section service-section training-section" id={slugify(trainingService.title)}>
    <div class="container training-grid">
      <div class="service-copy">
        <p class="service-number">{trainingService.number}</p>
        <h2>{trainingService.title}</h2>
        <p class="summary">{trainingService.summary}</p>
        <p>{trainingService.detail}</p>
      </div>
      <div class="media-frame service-image training-image">
        <ResponsiveImage src={trainingService.image} alt={trainingService.imageAlt} sizes="(min-width: 900px) 42vw, 100vw" />
      </div>
    </div>
    <div class="container program-groups">
      {servicesData.training.groups.map((group) => (
        <article>
          <h3>{group.group}</h3>
          <div class="program-list">
            {group.items.map(({ title }) => (
              <div>
                <span>{title}</span>
              </div>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section service-section consulting-section shaded" id={slugify(consultingService.title)}>
    <div class="container consulting-heading">
      <p class="service-number">{consultingService.number}</p>
      <h2>{consultingService.title}</h2>
      <p>{consultingService.detail}</p>
    </div>
    <div class="container consulting-grid">
      <div class="media-frame service-image">
        <ResponsiveImage src={consultingService.image} alt={consultingService.imageAlt} sizes="(min-width: 900px) 42vw, 100vw" />
      </div>
      <div class="consulting-list">
        {servicesData.consulting.items.map((item) => (
          <article>
            <h3>{typeof item === "string" ? item : item.title}</h3>
            {typeof item !== "string" && <p>{item.text}</p>}
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .services-hero {
    position: relative;
    overflow: hidden;
    background: #e7e6e0;
  }

  .services-hero-grid {
    position: relative;
    display: grid;
    min-height: clamp(500px, 45vw, 600px);
    grid-template-columns: minmax(360px, 0.85fr) minmax(420px, 0.9fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
    padding-block: clamp(3.35rem, 5.5vw, 5rem);
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    max-width: 760px;
  }

  h1 {
    display: grid;
    gap: 0.15em;
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: var(--page-title-size);
    font-weight: 700;
    line-height: 1.02;
  }

  h1 em {
    color: var(--color-blue);
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 700;
  }

  .hero-image {
    position: relative;
    z-index: 1;
    aspect-ratio: 1.28;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  .hero-image::after {
    position: absolute;
    inset: 18px;
    border: 1px solid rgba(255, 255, 255, 0.74);
    content: "";
    pointer-events: none;
  }

  .hero-rings {
    position: absolute;
    right: min(-18vw, -120px);
    bottom: -32%;
    z-index: 0;
    width: min(57vw, 740px);
    aspect-ratio: 1;
    pointer-events: none;
  }

  .hero-rings span {
    position: absolute;
    inset: 0;
    border: 1px solid rgba(69, 98, 142, 0.28);
    border-radius: 50%;
  }

  .hero-rings span + span {
    inset: 15%;
  }

  .service-strip {
    background: var(--color-blue-dark);
  }

  .service-strip-inner {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .service-strip a {
    display: flex;
    min-height: 86px;
    align-items: center;
    justify-content: center;
    border-left: 1px solid rgba(255, 255, 255, 0.18);
    color: var(--color-white);
    font-family: var(--font-label);
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.5px;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
  }

  .service-strip a:last-child {
    border-right: 1px solid rgba(255, 255, 255, 0.18);
  }

  .service-section {
    overflow: hidden;
    background: var(--color-white);
  }

  .service-section.shaded {
    background: #ececec;
  }

  .service-intro-grid,
  .split-grid,
  .training-grid,
  .consulting-grid {
    display: grid;
    grid-template-columns: minmax(320px, 0.82fr) minmax(420px, 1fr);
    gap: clamp(3rem, 7vw, 7.5rem);
    align-items: center;
  }

  .service-lead,
  .service-copy,
  .focus-panel,
  .consulting-heading,
  .consulting-list {
    max-width: 760px;
  }

  .service-lead {
    display: grid;
    gap: clamp(1.3rem, 2.4vw, 2.15rem);
  }

  .service-number {
    margin: 0;
    color: var(--color-blue);
    font-family: var(--font-heading);
    font-size: clamp(3rem, 7vw, 5.8rem);
    font-weight: 700;
    line-height: 0.85;
  }

  h2,
  h3 {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-weight: 700;
    line-height: 1.1;
  }

  h2 {
    max-width: 720px;
    font-size: clamp(2.15rem, 4.15vw, 4.05rem);
  }

  h3 {
    font-size: clamp(1.15rem, 1.8vw, 1.55rem);
  }

  p {
    margin: 0;
    color: var(--color-ink);
    font-size: var(--paragraph-size);
    line-height: 1.58;
  }

  .summary {
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-weight: 700;
  }

  .service-copy {
    display: grid;
    gap: clamp(1.1rem, 2vw, 1.75rem);
  }

  .service-image {
    width: 100%;
    aspect-ratio: 1.35;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  .tall-image,
  .training-image {
    aspect-ratio: 1.28;
  }

  .focus-panel {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .focus-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    border-top: 1px solid var(--color-line);
    border-left: 1px solid var(--color-line);
  }

  .focus-list article {
    display: grid;
    min-height: 148px;
    align-content: start;
    gap: 0.55rem;
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    padding: clamp(1.1rem, 2vw, 1.55rem);
    background: rgba(255, 255, 255, 0.48);
  }

  .focus-list h3,
  .accordion-list summary,
  .program-groups h3,
  .consulting-list h3 {
    font-size: 16px;
    text-transform: none;
  }

  .accordion-list {
    display: grid;
    margin-top: 0.5rem;
    border-top: 1px solid var(--color-line);
  }

  .accordion-list details {
    border-bottom: 1px solid var(--color-line);
    padding: 1.05rem 0;
  }

  .accordion-list summary {
    display: flex;
    cursor: pointer;
    list-style: none;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-weight: 700;
  }

  .accordion-list summary::-webkit-details-marker {
    display: none;
  }

  .accordion-list b::before {
    color: var(--color-blue);
    content: "+";
  }

  .accordion-list details[open] b::before {
    content: "-";
  }

  .accordion-list p {
    margin-top: 0.8rem;
  }

  .training-section {
    display: grid;
    gap: clamp(3.5rem, 6vw, 5.5rem);
  }

  .program-groups {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--color-line);
  }

  .program-groups article {
    display: grid;
    grid-template-columns: minmax(220px, 0.58fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    border-bottom: 1px solid var(--color-line);
    padding: clamp(1.45rem, 3vw, 2.05rem) 0;
  }

  .program-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem clamp(1.25rem, 3vw, 2.35rem);
  }

  .program-list div {
    position: relative;
    padding-left: 1.35rem;
  }

  .program-list div::before {
    position: absolute;
    top: 0.62em;
    left: 0;
    width: 6px;
    height: 6px;
    background: var(--color-blue);
    content: "";
    transform: rotate(45deg);
  }

  .program-list span {
    color: var(--color-ink);
    font-size: var(--paragraph-size);
    line-height: 1.45;
  }

  .consulting-heading {
    display: grid;
    gap: clamp(1.2rem, 2.5vw, 2rem);
    margin-bottom: clamp(3rem, 5vw, 4.5rem);
  }

  .consulting-list {
    display: grid;
    border-top: 1px solid var(--color-line);
  }

  .consulting-list article {
    display: grid;
    grid-template-columns: minmax(190px, 0.5fr) minmax(0, 1fr);
    gap: clamp(1.2rem, 3vw, 2rem);
    border-bottom: 1px solid var(--color-line);
    padding: 1.35rem 0;
  }

  @media (max-width: 980px) {
    .services-hero-grid,
    .service-intro-grid,
    .split-grid,
    .training-grid,
    .consulting-grid,
    .program-groups article,
    .consulting-list article {
      grid-template-columns: 1fr;
    }

    .service-strip-inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .services-hero-grid {
      min-height: auto;
    }

    .hero-image {
      aspect-ratio: 1.45;
    }

    .split-grid .media-frame {
      order: 2;
    }
  }

  @media (max-width: 640px) {
    .focus-list,
    .program-list,
    .service-strip-inner {
      grid-template-columns: 1fr;
    }

    .service-strip a,
    .service-strip a:last-child {
      min-height: 62px;
      border-right: 0;
      border-left: 0;
      border-top: 1px solid rgba(255, 255, 255, 0.18);
    }
  }
</style>
