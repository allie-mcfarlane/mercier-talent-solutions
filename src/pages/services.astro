---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import { getEntry } from "astro:content";

type ServiceItem = {
  eyebrow: string;
  number: string;
  title: string;
  text: string;
  summary: string;
  detail: string;
  image: string;
  imageAlt: string;
  highlights?: { title: string; text: string }[];
};

type ServicesData = {
  eyebrow: string;
  title: string;
  titleAccent: string;
  lede: string;
  heroImage: string;
  heroImageAlt: string;
  focusIntro: string;
  focusAreas: {
    title: string;
    text: string;
  }[];
  services: ServiceItem[];
  training: {
    eyebrow: string;
    title: string;
    groups: {
      group: string;
      items: {
        title: string;
        text: string;
      }[];
    }[];
  };
  consulting: {
    eyebrow: string;
    items: ({ title: string; text: string } | string)[];
  };
};

const servicesPage = await getEntry("pages", "services");

if (
  !servicesPage ||
  !servicesPage.data.services ||
  !servicesPage.data.focusAreas ||
  !servicesPage.data.training ||
  !servicesPage.data.consulting
) {
  throw new Error("Services page content is missing.");
}

const servicesData = servicesPage.data as ServicesData;

const [
  coaching,
  assessments,
  trainingService,
  consultingService,
] = servicesData.services;

const slugify = (value: string) =>
  value.toLowerCase().replaceAll(" ", "-");
---

<BaseLayout
  title="Services | Mercier Talent Solutions"
  description={servicesData.lede}
  image="/images/optimized/services-hero-1400.jpg"
>
  <!-- HERO -->
  <section class="services-hero">
    <div class="container services-hero-grid">
      <div class="section-heading hero-copy" data-reveal>
        <p class="eyebrow">{servicesData.eyebrow}</p>

        <h1>
          <span>{servicesData.title}</span>
          <em>{servicesData.titleAccent}</em>
        </h1>

        <p>{servicesData.lede}</p>
      </div>

      <div
        class="media-frame hero-image motion-image"
        data-reveal
        data-parallax
      >
        <ResponsiveImage
          src={servicesData.heroImage}
          alt={servicesData.heroImageAlt}
          sizes="(min-width: 900px) 42vw, 100vw"
          eager
        />
      </div>
    </div>
  </section>

  <!-- SERVICE NAVIGATION -->
  <nav class="service-strip" aria-label="Service sections">
    <div class="container service-strip-inner">
      {
        servicesData.services.map((service) => (
          <a href={`#${slugify(service.title)}`}>
            {service.title}
          </a>
        ))
      }
    </div>
  </nav>

  <!-- 01 EXECUTIVE COACHING -->
  <section
    class="section service-section coaching-section"
    id={slugify(coaching.title)}
  >
    <div class="container section-heading-anchor" data-reveal>
      <div class="service-heading-block">
        <p
          class="service-number"
          data-number={coaching.number}
        >
          {coaching.number}
        </p>

        <h2>{coaching.title}</h2>
      </div>
    </div>

    <div class="container coaching-layout">
      <div class="coaching-copy-stack" data-reveal>
        <p class="service-summary">
          {coaching.summary}
        </p>

        <p class="service-detail-copy">
          {servicesData.focusIntro}
        </p>
      </div>

      <div
        class="media-frame service-image coaching-image motion-image"
        data-reveal
        data-parallax
      >
        <!-- 01 intentionally uses the former Consulting image -->
        <ResponsiveImage
          src={consultingService.image}
          alt={consultingService.imageAlt}
          sizes="(min-width: 1500px) 42vw, (min-width: 981px) 46vw, 100vw"
        />
      </div>

      <div
        class="coaching-focus"
        data-reveal
        data-stagger-group
      >
        <div class="focus-list">
          {
            servicesData.focusAreas.map(({ title, text }) => (
              <article>
                <h3>{title}</h3>
                <p>{text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- 02 ASSESSMENTS -->
  <section
    class="section service-section split-section shaded"
    id={slugify(assessments.title)}
  >
    <div class="container section-heading-anchor" data-reveal>
      <div class="service-heading-block">
        <p
          class="service-number"
          data-number={assessments.number}
        >
          {assessments.number}
        </p>

        <h2>{assessments.title}</h2>
      </div>
    </div>

    <div class="container assessment-layout">
      <p
        class="assessment-intro service-detail-copy"
        data-reveal
      >
        {assessments.detail}
      </p>

      <div
        class="media-frame service-image assessment-image motion-image"
        data-reveal
        data-parallax
      >
        <ResponsiveImage
          src="/images/assessments.png"
          alt={assessments.imageAlt}
          sizes="(min-width: 981px) 40vw, 100vw"
        />
      </div>

      {
        assessments.highlights && (
          <div
            class="assessment-accordion"
            data-reveal
          >
            <div class="accordion-list">
              {assessments.highlights.map(
                ({ title, text }, index) => (
                  <details open={index === 0}>
                    <summary>
                      <span>{title}</span>
                      <b aria-hidden="true"></b>
                    </summary>

                    <p>{text}</p>
                  </details>
                ),
              )}
            </div>
          </div>
        )
      }
    </div>
  </section>

  <!-- 03 TRAINING -->
  <section
    class="section service-section training-section"
    id={slugify(trainingService.title)}
  >
    <div class="container training-top-layout">
      <div
        class="training-text-column"
        data-reveal
      >
        <div class="service-heading-block">
          <p
            class="service-number"
            data-number={trainingService.number}
          >
            {trainingService.number}
          </p>

          <h2>{trainingService.title}</h2>
        </div>

        <div class="training-copy">
          <p class="service-summary">
            {trainingService.summary} {trainingService.detail}
          </p>
        </div>
      </div>

      <div
        class="media-frame service-image training-image motion-image"
        data-reveal
        data-parallax
      >
        <ResponsiveImage
          src={trainingService.image}
          alt={trainingService.imageAlt}
          sizes="(min-width: 1500px) 28vw, (min-width: 981px) 32vw, 100vw"
        />
      </div>
    </div>

    <div
      class="container program-groups"
      data-reveal
      data-stagger-group
    >
      {
        servicesData.training.groups.map((group) => (
          <article>
            <h3>{group.group}</h3>

            <div class="program-list">
              {group.items.map(({ title, text }) => (
                <div class="program-item">
                  <span>{title}</span>
                  <p>{text}</p>
                </div>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- 04 CONSULTING -->
  <section
    class="section service-section consulting-section shaded"
    id={slugify(consultingService.title)}
  >
    <div class="container section-heading-anchor" data-reveal>
      <div class="service-heading-block">
        <p
          class="service-number"
          data-number={consultingService.number}
        >
          {consultingService.number}
        </p>

        <h2>{consultingService.title}</h2>
      </div>
    </div>

    <div class="container consulting-feature">
      <p
        class="consulting-intro service-detail-copy"
        data-reveal
      >
        {consultingService.detail}
      </p>

      <div
        class="media-frame service-image consulting-image motion-image"
        data-reveal
        data-parallax
      >
        <!-- 04 intentionally uses the former Coaching image -->
        <ResponsiveImage
          src={coaching.image}
          alt={coaching.imageAlt}
          sizes="(min-width: 981px) 46vw, 100vw"
        />
      </div>

      <div
        class="consulting-list"
        data-reveal
        data-stagger-group
      >
        {
          servicesData.consulting.items.map((item) => (
            <article>
              <h3>
                {typeof item === "string" ? item : item.title}
              </h3>

              {typeof item !== "string" && (
                <p>{item.text}</p>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  document
    .querySelectorAll(".accordion-list summary")
    .forEach((summary) => {
      summary.addEventListener("click", () => {
        const scrollLeft = window.scrollX;
        const scrollTop = window.scrollY;

        const restoreScroll = () =>
          window.scrollTo(scrollLeft, scrollTop);

        requestAnimationFrame(restoreScroll);
        setTimeout(restoreScroll, 0);
        setTimeout(restoreScroll, 80);
      });
    });

  const revealItems = Array.from(
    document.querySelectorAll(
      "[data-reveal], [data-stagger-group]",
    ),
  );

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  );

  revealItems.forEach((item, index) => {
    item.style.setProperty(
      "--service-reveal-delay",
      `${Math.min(index % 2, 1) * 90}ms`,
    );
  });

  if (
    reduceMotion.matches ||
    !("IntersectionObserver" in window)
  ) {
    revealItems.forEach((item) =>
      item.classList.add("is-visible"),
    );
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      },
      {
        rootMargin: "0px 0px -10% 0px",
        threshold: 0.12,
      },
    );

    revealItems.forEach((item) =>
      observer.observe(item),
    );
  }

  const parallaxItems = Array.from(
    document.querySelectorAll("[data-parallax]"),
  );

  const serviceStrip =
    document.querySelector(".service-strip");

  if (!reduceMotion.matches) {
    let ticking = false;

    const updateScrollMotion = () => {
      const viewportCenter =
        window.innerHeight / 2;

      parallaxItems.forEach((item) => {
        const rect =
          item.getBoundingClientRect();

        const itemCenter =
          rect.top + rect.height / 2;

        const distance =
          itemCenter - viewportCenter;

        const offset = Math.max(
          -14,
          Math.min(14, distance * -0.025),
        );

        item.style.setProperty(
          "--parallax-y",
          `${offset}px`,
        );
      });

      if (serviceStrip) {
        serviceStrip.classList.toggle(
          "is-scrolled",
          window.scrollY > 120,
        );
      }

      ticking = false;
    };

    const onScroll = () => {
      if (ticking) return;

      ticking = true;

      requestAnimationFrame(
        updateScrollMotion,
      );
    };

    window.addEventListener(
      "scroll",
      onScroll,
      { passive: true },
    );

    window.addEventListener(
      "resize",
      onScroll,
    );

    updateScrollMotion();
  }
</script>

<style>
  /* ---------------------------------
     HERO
  ---------------------------------- */

  .services-hero {
    position: relative;
    overflow: hidden;
    background: #e7e6e0;
  }

  .services-hero-grid {
    position: relative;
    display: grid;
    max-width: none;
    min-height: clamp(340px, 28vw, 460px);
    grid-template-columns:
      minmax(320px, 0.82fr)
      minmax(360px, 0.92fr);
    gap: clamp(2rem, 3.6vw, 4.5rem);
    align-items: center;
    padding-block:
      clamp(2.35rem, 3.4vw, 3.8rem);
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    max-width: 760px;
  }

  .hero-copy .eyebrow {
    margin-bottom: 1.8rem;
  }

  h1 {
    display: grid;
    gap: 0.15em;
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: var(--page-title-size);
    font-weight: 700;
    line-height: 1.02;
  }

  h1 em {
    color: var(--color-blue);
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 700;
  }

  .hero-copy > p:last-child {
    margin-top: 1.5rem;
    color: var(--color-ink);
    font-size: var(--paragraph-size);
    line-height: 1.58;
  }

  .hero-image {
    position: relative;
    z-index: 1;
    width: min(100%, 560px);
    justify-self: center;
    aspect-ratio: 1.28;
    overflow: hidden;
    border: 1px solid
      rgba(255, 255, 255, 0.92);
    outline: 1px solid
      rgba(255, 255, 255, 0.58);
    outline-offset: -12px;
    background: #fff;
  }


  /* ---------------------------------
     SERVICE NAV
  ---------------------------------- */

  .service-strip {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--color-blue-dark);
    transition:
      box-shadow 320ms var(--ease-soft),
      background-color 320ms
        var(--ease-soft);
  }

  .service-strip.is-scrolled {
    box-shadow:
      0 10px 30px rgba(23, 37, 62, 0.16);
  }

  .service-strip-inner {
    display: grid;
    grid-template-columns:
      repeat(4, minmax(0, 1fr));
  }

  .service-strip a {
    position: relative;
    display: flex;
    min-height: 86px;
    overflow: hidden;
    align-items: center;
    justify-content: center;
    border-left: 1px solid
      rgba(255, 255, 255, 0.18);
    color: var(--color-white);
    font-family: var(--font-label);
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.5px;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background-color 260ms
        var(--ease-soft),
      color 260ms var(--ease-soft);
  }

  .service-strip a:last-child {
    border-right: 1px solid
      rgba(255, 255, 255, 0.18);
  }

  .service-strip a:hover,
  .service-strip a:focus-visible {
    background:
      rgba(255, 255, 255, 0.08);
  }

  .service-strip a::after {
    position: absolute;
    bottom: 17px;
    left: 50%;
    width: 0;
    height: 1px;
    background:
      rgba(255, 255, 255, 0.72);
    content: "";
    transform: translateX(-50%);
    transition:
      width 320ms var(--ease-soft);
  }

  .service-strip a:hover::after,
  .service-strip a:focus-visible::after {
    width: 34%;
  }


  /* ---------------------------------
     SHARED SERVICE STYLING
  ---------------------------------- */

  .service-section {
    overflow: hidden;
    background: var(--color-white);
    padding-block:
      clamp(3.15rem, 4.5vw, 4.75rem);
  }

  .service-section.shaded {
    background: #ececec;
  }

  .section-heading-anchor {
    display: block;
    margin-bottom:
      clamp(0.95rem, 1.35vw, 1.35rem);
  }

  .service-heading-block {
    display: grid;
    min-height: 0;
    align-content: start;
    gap: 0.72rem;
  }

  .service-number {
    position: static;
    width: fit-content;
    margin: 0;
    color: #8498ba;
    font-family: var(--font-serif);
    font-size:
      clamp(3.55rem, 4.4vw, 4.8rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.88;
    text-shadow: none;
    -webkit-text-stroke: 0;
  }

  .service-number::after {
    display: none;
    content: none;
  }

  h2,
  h3 {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-weight: 700;
    line-height: 1.1;
  }

  .service-heading-block h2 {
    margin: 0;
    font-size: 20px;
    line-height: 1.2;
  }

  p {
    margin: 0;
    color: var(--color-ink);
    font-size: var(--paragraph-size);
    line-height: 1.58;
  }

  .service-summary,
  .service-detail-copy {
    margin: 0;
    color: var(--color-ink);
    font-size: var(--paragraph-size);
    line-height: 1.55;
  }


  /* ---------------------------------
     IMAGE TREATMENT
  ---------------------------------- */

  .service-image {
    position: relative;
    overflow: hidden;
    border: 1px solid
      rgba(255, 255, 255, 0.95);
    outline: 1px solid
      rgba(255, 255, 255, 0.62);
    outline-offset: -11px;
    background: #fff;
  }

  .motion-image {
    --parallax-y: 0px;
  }

  .motion-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform:
      translate3d(
        0,
        var(--parallax-y),
        0
      )
      scale(1.035);
    transition:
      transform 220ms linear,
      filter 700ms var(--ease-soft);
    will-change: transform;
  }

  .motion-image:hover :global(img) {
    transform:
      translate3d(
        0,
        var(--parallax-y),
        0
      )
      scale(1.055);
  }


  /* ---------------------------------
     01 EXECUTIVE COACHING
  ---------------------------------- */

  .coaching-section {
    padding-top:
      clamp(3rem, 4.2vw, 4.25rem);
  }

  .coaching-layout {
    display: grid;
    grid-template-columns:
      minmax(280px, 0.68fr)
      minmax(430px, 1.12fr);
    grid-template-areas:
      "copy image"
      "focus focus";
    gap:
      clamp(1.5rem, 2.4vw, 2.5rem)
      clamp(3rem, 5vw, 6rem);
    align-items: start;
  }

  .coaching-copy-stack {
    grid-area: copy;
    display: grid;
    max-width: none;
    gap: 1.15rem;
  }

  .coaching-copy-stack
    .service-summary,
  .coaching-copy-stack
    .service-detail-copy {
    max-width: 660px;
  }

  .coaching-image {
    grid-area: image;
    width: min(100%, 760px);
    max-width: 760px;
    justify-self: end;
    aspect-ratio: 1.58;
  }

  .coaching-focus {
    grid-area: focus;
    width: 100%;
    margin-top:
      clamp(0.2rem, 0.6vw, 0.6rem);
  }

  .focus-list {
    display: grid;
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
    width: 100%;
    border-top: 1px solid
      var(--color-line);
    border-left: 1px solid
      var(--color-line);
  }

  .focus-list article {
    display: grid;
    min-height: 138px;
    align-content: start;
    gap: 0.55rem;
    border-right: 1px solid
      var(--color-line);
    border-bottom: 1px solid
      var(--color-line);
    padding:
      clamp(1.05rem, 1.55vw, 1.35rem);
    background:
      rgba(255, 255, 255, 0.48);
    transition:
      background-color 260ms
        var(--ease-soft),
      transform 260ms var(--ease-soft);
  }

  .focus-list article:hover {
    background: var(--color-white);
    transform: translateY(-3px);
  }

  .focus-list h3 {
    font-size: 16px;
  }


  /* ---------------------------------
     02 ASSESSMENTS
  ---------------------------------- */

  .assessment-layout {
    display: grid;
    grid-template-columns:
      minmax(360px, 0.9fr)
      minmax(0, 1.1fr);
    grid-template-areas:
      "intro intro"
      "image accordion";
    column-gap:
      clamp(2.8rem, 4.5vw, 5.2rem);
    row-gap:
      clamp(1.35rem, 2.1vw, 2rem);
    align-items: start;
  }

  .assessment-intro {
    grid-area: intro;
    max-width: 1100px;
  }

  .assessment-image {
    grid-area: image;
    width: min(100%, 620px);
    justify-self: start;
    aspect-ratio: 1.45;
  }

  .assessment-accordion {
    grid-area: accordion;
    min-width: 0;
  }

  .accordion-list {
    display: grid;
    margin: 0;
    border-top: 1px solid
      var(--color-line);
  }

  .accordion-list details {
    border-bottom: 1px solid
      var(--color-line);
    padding: 1.05rem 0;
    transition:
      background-color 260ms
        var(--ease-soft);
  }

  .accordion-list details:hover {
    background:
      rgba(255, 255, 255, 0.34);
  }

  .accordion-list summary {
    display: flex;
    cursor: pointer;
    list-style: none;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 700;
  }

  .accordion-list
    summary::-webkit-details-marker {
    display: none;
  }

  .accordion-list b::before {
    color: var(--color-blue);
    content: "+";
  }

  .accordion-list
    details[open]
    b::before {
    content: "-";
  }

  .accordion-list p {
    margin-top: 0.8rem;
  }


  /* ---------------------------------
     03 TRAINING
  ---------------------------------- */

  .training-section {
    display: grid;
    gap: 0;
  }

  .training-top-layout {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      minmax(320px, 0.46fr);
    gap:
      clamp(2.3rem, 4vw, 4.6rem);
    align-items: start;
  }

  .training-text-column {
    display: grid;
    max-width: 980px;
    align-content: start;
    gap:
      clamp(1.05rem, 1.45vw, 1.4rem);
  }

  .training-copy {
    margin: 0;
    padding: 0;
    max-width: none;
  }

  .training-copy .service-summary {
    max-width: 980px;
    margin: 0;
    line-height: 1.55;
  }

  .training-image {
    width:
      clamp(320px, 24vw, 520px);
    max-width: 520px;
    justify-self: end;
    align-self: start;
    aspect-ratio: 1.18;
    margin: 0;
  }

  .program-groups {
    display: grid;
    gap: 0;
    max-width: none;
    margin-top:
      clamp(2.4rem, 3.4vw, 3.4rem);
    border-top: 1px solid
      var(--color-line);
  }

  .program-groups article {
    display: grid;
    grid-template-columns:
      minmax(220px, 0.58fr)
      minmax(0, 1fr);
    gap:
      clamp(1.5rem, 4vw, 4rem);
    border-bottom: 1px solid
      var(--color-line);
    padding:
      clamp(1.1rem, 2.2vw, 1.55rem)
      0;
  }

  .program-groups h3 {
    font-size: 16px;
  }

  .program-list {
    display: grid;
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
    gap:
      0.75rem
