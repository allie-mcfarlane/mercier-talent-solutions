---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import { getEntry } from "astro:content";

type ServiceItem = {
  eyebrow: string;
  number: string;
  title: string;
  text: string;
  summary: string;
  detail: string;
  image: string;
  imageAlt: string;
  highlights?: { title: string; text: string }[];
};

type ServicesData = {
  eyebrow: string;
  title: string;
  titleAccent: string;
  lede: string;
  heroImage: string;
  heroImageAlt: string;
  focusIntro: string;
  focusAreas: { title: string; text: string }[];
  services: ServiceItem[];
  training: {
    eyebrow: string;
    title: string;
    groups: { group: string; items: { title: string; text: string }[] }[];
  };
  consulting: { eyebrow: string; items: string[] };
};

const servicesPage = await getEntry("pages", "services");
if (!servicesPage || !servicesPage.data.services || !servicesPage.data.focusAreas || !servicesPage.data.training || !servicesPage.data.consulting) {
  throw new Error("Services page content is missing.");
}

const servicesData = servicesPage.data as ServicesData;
---

<BaseLayout title="Services | Mercier Talent Solutions" description={servicesData.lede} image="/images/optimized/services-hero-1400.jpg">
  <section class="section services-hero">
    <div class="container hero-grid">
      <div class="section-heading">
        <p class="eyebrow">{servicesData.eyebrow}</p>
        <h1>{servicesData.title} <em>{servicesData.titleAccent}</em></h1>
        <p>{servicesData.lede}</p>
      </div>
      <div class="media-frame hero-image">
        <ResponsiveImage
          src={servicesData.heroImage}
          alt={servicesData.heroImageAlt}
          sizes="(min-width: 900px) 42vw, 100vw"
          eager
        />
      </div>
    </div>
  </section>

  <section class="section focus-section">
    <div class="container focus-grid">
      <p>{servicesData.focusIntro}</p>
      <div class="focus-list">
        {servicesData.focusAreas.map(({ title, text }) => (
          <article>
            <h2>{title}</h2>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container service-stack">
      {servicesData.services.map((service) => (
        <article class="service-detail" id={service.title.toLowerCase().replaceAll(" ", "-")}>
          <div>
            <span class="service-number">{service.number}</span>
            <h2>{service.title}</h2>
            <p class="summary">{service.summary}</p>
            <p>{service.detail}</p>
            {service.highlights && (
              <div class="service-highlights">
                {service.highlights.map(({ title, text }) => (
                  <article>
                    <h3>{title}</h3>
                    <p>{text}</p>
                  </article>
                ))}
              </div>
            )}
          </div>
          <div class="media-frame service-image">
            <ResponsiveImage src={service.image} alt={service.imageAlt} sizes="(min-width: 900px) 42vw, 100vw" />
          </div>
        </article>
      ))}

      <section class="training">
        <p class="eyebrow">{servicesData.training.eyebrow}</p>
        <h2>{servicesData.training.title}</h2>
        <div class="program-groups">
          {servicesData.training.groups.map((group) => (
            <article>
              <h3>{group.group}</h3>
              <div class="program-list">
                {group.items.map(({ title, text }) => (
                  <div>
                    <h4>{title}</h4>
                    <p>{text}</p>
                  </div>
                ))}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="consulting-list">
        <p class="eyebrow">{servicesData.consulting.eyebrow}</p>
        <div class="grid">
          {servicesData.consulting.items.map((item) => (
            <article class="card"><h3>{item}</h3></article>
          ))}
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .services-hero {
    background: var(--color-white);
  }

  .hero-grid,
  .focus-grid,
  .service-detail {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.86fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  h1 {
    margin: 0.4rem 0 0;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: var(--page-title-size);
    font-weight: 700;
    line-height: 1;
  }

  .service-grid {
    margin-top: 2rem;
  }

  .hero-image {
    aspect-ratio: 1.22;
  }

  .focus-section {
    background: var(--color-blue-dark);
    color: var(--color-white);
  }

  .focus-section p {
    color: rgba(255, 255, 255, 0.82);
    font-size: 1.08rem;
  }

  .focus-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .focus-list article {
    border-top: 1px solid rgba(255, 255, 255, 0.25);
    padding-top: 1rem;
  }

  h2,
  h3,
  h4 {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-weight: 700;
    line-height: 1.08;
  }

  .focus-list h2,
  .training h2 {
    color: var(--color-white);
  }

  .focus-list h2 {
    font-size: 1.5rem;
  }

  .service-stack {
    display: grid;
    gap: clamp(3rem, 8vw, 6rem);
  }

  .service-detail:nth-child(even) .service-image {
    order: -1;
  }

  .service-number {
    display: block;
    color: var(--color-blue);
    font-family: var(--font-heading);
    font-size: clamp(3rem, 8vw, 6rem);
    line-height: 0.9;
  }

  .service-detail h2 {
    margin: 0.4rem 0 0.75rem;
    font-size: clamp(2rem, 5vw, 4rem);
  }

  .summary {
    color: var(--color-blue-dark);
    font-family: var(--font-heading);
    font-size: 1.18rem;
    font-weight: 700;
  }

  .service-image {
    aspect-ratio: 1.28;
  }

  .service-highlights {
    display: grid;
    gap: 0.8rem;
    margin-top: 1.2rem;
  }

  .service-highlights article {
    border-top: 1px solid var(--color-line);
    padding-top: 0.9rem;
  }

  .service-highlights h3 {
    margin-bottom: 0.3rem;
    font-size: 1rem;
    font-weight: 800;
  }

  .service-highlights p {
    margin: 0;
  }

  .training {
    margin-inline: calc(50% - 50vw);
    padding: clamp(3rem, 7vw, 6rem) max(1rem, calc((100vw - var(--container)) / 2));
    background: var(--color-blue-dark);
    color: var(--color-white);
  }

  .training > h2 {
    max-width: 860px;
    margin: 0.4rem 0 2rem;
    font-size: clamp(2rem, 4vw, 4rem);
  }

  .program-groups {
    display: grid;
    gap: 1.2rem;
  }

  .program-groups article {
    border-top: 1px solid rgba(255, 255, 255, 0.24);
    padding-top: 1.2rem;
  }

  .program-groups h3 {
    color: var(--color-white);
    font-size: clamp(1.4rem, 3vw, 2.2rem);
  }

  .program-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .program-list h4 {
    color: var(--color-white);
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 800;
  }

  .program-list p {
    color: rgba(255, 255, 255, 0.78);
  }

  .consulting-list h3 {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 800;
  }

  @media (max-width: 860px) {
    .hero-grid,
    .focus-grid,
    .service-detail,
    .program-list {
      grid-template-columns: 1fr;
    }

    .service-detail:nth-child(even) .service-image {
      order: 0;
    }
  }

  @media (max-width: 640px) {
    .focus-list {
      grid-template-columns: 1fr;
    }
  }
</style>
