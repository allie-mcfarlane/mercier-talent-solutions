---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Turnstile from "../../components/Turnstile.astro";
import { getEntry } from "astro:content";

const fallbackApplicationForm = {
  eyebrow: "Apply",
  title: "Submit your application",
  intro: "Tell us a little about your background, experience and availability, then attach your resume or professional biography. Additional materials are optional.",
  submitLabel: "Submit application",
  fields: [
    { id: "name", type: "text", label: "Name", required: true },
    { id: "email", type: "email", label: "Email", required: true },
    { id: "resume", type: "file", label: "Resume or Professional Biography", required: true, help: "Attach a PDF or Word document." },
  ],
};

export async function getStaticPaths() {
  const careersPage = await getEntry("pages", "careers");
  const roles = careersPage?.data.roles ?? [];
  const applicationForm = careersPage?.data.applicationForm ?? fallbackApplicationForm;

  return roles.map((role) => ({
    params: { slug: role.slug },
    props: { role, applicationForm },
  }));
}

const { role, applicationForm: suppliedApplicationForm } = Astro.props;
const applicationForm = suppliedApplicationForm ?? fallbackApplicationForm;
const description = role.summary || `Career opportunity: ${role.title} at Mercier Talent Solutions.`;
const descriptionMarkup = (role.description ?? []).join("\n\n");
const formEndpoint = "/api/careers";
const documentAccept = ".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document";

const safeFieldId = (value: unknown) => String(value ?? "")
  .toLowerCase()
  .replace(/[^a-z0-9-]/g, "-")
  .replace(/-+/g, "-")
  .replace(/^-|-$/g, "")
  .slice(0, 50);
const fieldName = (id: unknown) => `field_${safeFieldId(id)}`;
const applicationSchema = JSON.stringify({
  fields: (applicationForm.fields ?? []).map((field: Record<string, unknown>) => ({
    id: safeFieldId(field.id),
    type: String(field.type ?? "text"),
    label: String(field.label ?? "Field").slice(0, 120),
    required: Boolean(field.required),
  })),
});

const escapeHtml = (value: unknown = "") => String(value ?? "")
  .replaceAll("&", "&amp;")
  .replaceAll("<", "&lt;")
  .replaceAll(">", "&gt;")
  .replaceAll('"', "&quot;")
  .replaceAll("'", "&#039;");

const safeUrl = (value: unknown = "") => {
  const url = String(value ?? "").trim();
  return /^(https?:\/\/|mailto:|tel:|\/(?!\/)|#)/i.test(url) ? url : "";
};

const inlineMarkupToHtml = (value: unknown = "", allowLinks = true) => {
  let raw = String(value ?? "");
  const links: { label: string; href: string }[] = [];

  if (allowLinks) {
    raw = raw.replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_match, label, href) => {
      const safe = safeUrl(href);
      if (!safe) return label;
      const token = `@@MTSLINK${links.length}@@`;
      links.push({ label, href: safe });
      return token;
    });
  }

  let html = escapeHtml(raw);
  html = html.replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>");

  (["navy", "blue", "gray"] as const).forEach((name) => {
    const pattern = new RegExp(`\\[\\[${name}\\]\\]([\\s\\S]*?)\\[\\[\\/${name}\\]\\]`, "g");
    html = html.replace(pattern, `<span class="role-text-${name}">$1</span>`);
  });

  links.forEach((link, index) => {
    const label = inlineMarkupToHtml(link.label, false);
    html = html.replace(
      `@@MTSLINK${index}@@`,
      `<a href="${escapeHtml(link.href)}">${label}</a>`,
    );
  });

  return html;
};

const renderDescription = (markup: string) => {
  const chunks = markup
    .replace(/\r/g, "")
    .split(/\n{2,}/)
    .map((item) => item.trim())
    .filter(Boolean);

  if (!chunks.length) return "";

  return chunks.map((chunk) => {
    const lines = chunk.split("\n").map((line) => line.trimEnd());

    if (lines.every((line) => /^-\s+/.test(line))) {
      return `<ul>${lines
        .map((line) => `<li>${inlineMarkupToHtml(line.replace(/^-\s+/, ""))}</li>`)
        .join("")}</ul>`;
    }

    if (lines.every((line) => /^\d+\.\s+/.test(line))) {
      return `<ol>${lines
        .map((line) => `<li>${inlineMarkupToHtml(line.replace(/^\d+\.\s+/, ""))}</li>`)
        .join("")}</ol>`;
    }

    if (lines.length === 1 && /^###\s+/.test(lines[0])) {
      return `<h3>${inlineMarkupToHtml(lines[0].replace(/^###\s+/, ""))}</h3>`;
    }

    if (lines.length === 1 && /^##\s+/.test(lines[0])) {
      return `<h2>${inlineMarkupToHtml(lines[0].replace(/^##\s+/, ""))}</h2>`;
    }

    return `<p>${lines.map((line) => inlineMarkupToHtml(line)).join("<br>")}</p>`;
  }).join("");
};

const roleDescriptionHtml = renderDescription(descriptionMarkup);
---

<BaseLayout title={`${role.title} | Careers | Mercier Talent Solutions`} description={description}>
  <article class="role-page">
    <header class="role-hero">
      <div class="container role-hero-inner">
        <a class="back-link" href="/careers/">← Careers</a>
        <h1>{role.title}</h1>
        {(role.location || role.employmentType) && (
          <p class="role-meta">
            {[role.location, role.employmentType].filter(Boolean).join(" · ")}
          </p>
        )}
      </div>
    </header>

    <section class="role-content-section">
      <div class="container role-content">
        {role.summary && <p class="role-summary">{role.summary}</p>}
        {roleDescriptionHtml && <div class="role-rich-text" set:html={roleDescriptionHtml}></div>}

        <section class="application-section" aria-labelledby="application-heading">
          <div class="application-heading">
            {applicationForm.eyebrow && <p class="eyebrow">{applicationForm.eyebrow}</p>}
            <h2 id="application-heading">{applicationForm.title}</h2>
            {applicationForm.intro && <p>{applicationForm.intro}</p>}
          </div>

          <form
            class="application-form"
            action={formEndpoint}
            method="POST"
            enctype="multipart/form-data"
            data-configurable-careers-form
          >
            <input type="hidden" name="form_name" value="Career Application" />
            <input type="hidden" name="position" value={role.title} />
            <input type="hidden" name="return_to" value={`/careers/${role.slug}/`} />
            <input type="hidden" name="application_schema" value={applicationSchema} />
            <input class="honeypot" type="text" name="_honey" tabindex="-1" autocomplete="off" />

            <div class="form-grid">
              {(applicationForm.fields ?? []).map((field: Record<string, any>) => (
                <label class:list={["full", "form-field", field.type === "file" && "file-field"]}>
                  <span class="field-label">{field.label}{field.required ? "*" : ""}</span>
                  {field.type === "textarea" ? (
                    <textarea name={fieldName(field.id)} rows="5" required={Boolean(field.required)}></textarea>
                  ) : field.type === "file" ? (
                    <input
                      type="file"
                      name={fieldName(field.id)}
                      accept={documentAccept}
                      required={Boolean(field.required)}
                    />
                  ) : (
                    <input
                      type={field.type === "email" ? "email" : "text"}
                      name={fieldName(field.id)}
                      autocomplete={field.type === "email" ? "email" : field.id === "name" ? "name" : field.id === "location" ? "address-level2" : "off"}
                      required={Boolean(field.required)}
                    />
                  )}
                  {field.help && <span class="field-note">{field.help}</span>}
                </label>
              ))}

              <div class="full turnstile-wrap">
                <Turnstile
                  action="career"
                  endpoint={formEndpoint}
                  successMessage="Thank you. Your application has been sent."
                />
              </div>

              <button class="button submit-button full" type="submit">{applicationForm.submitLabel || "Submit application"}</button>
            </div>
          </form>
        </section>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .role-page {
    width: 100%;
    overflow-x: hidden;
  }

  .role-hero {
    border-bottom: 1px solid rgba(221, 220, 215, 0.9);
    background: linear-gradient(140deg, #fafaf8 0%, #f0f0ec 100%);
  }

  .role-hero-inner {
    max-width: 1380px;
    padding-block: clamp(4rem, 7vw, 6.5rem);
  }

  .role-content {
    max-width: 1120px;
  }

  .back-link {
    display: inline-block;
    margin-bottom: clamp(1.8rem, 3vw, 2.4rem);
    color: #66707c;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
  }

  .back-link:hover,
  .back-link:focus-visible {
    color: var(--color-blue-dark);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .eyebrow {
    margin: 0;
    color: var(--color-blue);
    font-family: var(--font-label);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 4.5px;
    text-transform: uppercase;
  }

  .role-hero h1 {
    max-width: 1120px;
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 3.6vw, 3.9rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.06;
  }

  .role-meta {
    margin: 1.5rem 0 0;
    color: #66707c;
    font-size: 14px;
    font-weight: 600;
  }

  .role-content-section {
    background: #fff;
    padding: clamp(3.6rem, 6vw, 5.5rem) 0 clamp(5.5rem, 9vw, 9rem);
  }

  .role-summary,
  .role-rich-text {
    max-width: 860px;
  }

  .role-summary {
    margin: 0 0 clamp(2rem, 4vw, 3rem);
    color: var(--color-blue-dark);
    font-family: var(--font-heading);
    font-size: clamp(1.45rem, 2.3vw, 2.05rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.45;
  }

  .role-rich-text {
    color: #111;
    font-size: 16.5px;
    line-height: 1.45;
  }

  .role-rich-text :global(p) {
    margin: 0 0 1rem;
    color: inherit;
    font-size: inherit;
    line-height: inherit;
  }

  .role-rich-text :global(h2),
  .role-rich-text :global(h3) {
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-weight: 700;
    line-height: 1.18;
  }

  .role-rich-text :global(h2) {
    margin: 2.2rem 0 0.8rem;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    letter-spacing: -0.035em;
  }

  .role-rich-text :global(h2:first-child),
  .role-rich-text :global(h3:first-child) {
    margin-top: 0;
  }

  .role-rich-text :global(h3) {
    margin: 1.75rem 0 0.65rem;
    font-size: clamp(1.4rem, 2.2vw, 1.9rem);
  }

  .role-rich-text :global(ul),
  .role-rich-text :global(ol) {
    display: grid;
    gap: 0.35rem;
    margin: 0 0 1rem;
    padding-left: 1.3rem;
    color: inherit;
  }

  .role-rich-text :global(li) {
    margin: 0;
    font-size: inherit;
    line-height: inherit;
  }

  .role-rich-text :global(a) {
    color: var(--color-blue-dark);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .role-rich-text :global(a:hover),
  .role-rich-text :global(a:focus-visible) {
    color: var(--color-blue);
  }

  .role-rich-text :global(strong) {
    font-weight: 700;
  }

  .role-rich-text :global(.role-text-navy) {
    color: #17253e;
  }

  .role-rich-text :global(.role-text-blue) {
    color: #45628e;
  }

  .role-rich-text :global(.role-text-gray) {
    color: #66707c;
  }

  .application-section {
    display: grid;
    grid-template-columns: minmax(260px, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(3rem, 7vw, 7rem);
    margin-top: clamp(4.5rem, 8vw, 7rem);
    padding-top: clamp(3.5rem, 6vw, 5rem);
    border-top: 1px solid var(--color-line);
    align-items: start;
  }

  .application-heading .eyebrow {
    margin-bottom: 1.55rem;
  }

  .application-heading h2 {
    margin: 0 0 1.25rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: clamp(2rem, 3.2vw, 3.2rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.08;
  }

  .application-heading > p:last-child {
    max-width: 430px;
    margin: 0;
    color: #66707c;
    font-size: 15px;
    line-height: 1.7;
  }

  .application-form {
    padding-left: clamp(2rem, 4vw, 4rem);
    border-left: 1px solid var(--color-line);
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.625rem 1.75rem;
  }

  .full {
    grid-column: 1 / -1;
  }

  label {
    display: grid;
    gap: 0.625rem;
    color: var(--color-blue);
    font-family: var(--font-label);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.2;
  }

  .field-label {
    display: block;
  }

  input,
  textarea {
    width: 100%;
    border: 0;
    border-bottom: 1px solid #bdb8ae;
    border-radius: 0;
    background: transparent;
    padding: 0.75rem 0 0.8125rem;
    color: #000;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.45;
    transition:
      border-color 220ms ease,
      background 220ms ease;
  }

  input:focus,
  textarea:focus {
    border-color: var(--color-blue);
    outline: none;
    background: rgba(232, 237, 244, 0.22);
  }

  textarea {
    min-height: 135px;
    resize: vertical;
  }

  .form-field textarea {
    min-height: 112px;
  }

  input[type="file"] {
    padding: 0.75rem 0 0.95rem;
    cursor: pointer;
  }

  input[type="file"]::file-selector-button {
    margin-right: 0.9rem;
    border: 1px solid var(--color-blue-dark);
    border-radius: 0;
    background: transparent;
    padding: 0.65rem 0.85rem;
    color: var(--color-blue-dark);
    font-family: var(--font-label);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    cursor: pointer;
  }

  .field-note {
    color: #66707c;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.5;
    text-transform: none;
  }

  .turnstile-wrap {
    min-width: 0;
  }

  .turnstile-wrap :global(.form-note) {
    margin: 0;
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.5;
  }

  .turnstile-wrap :global(.turnstile-result) {
    margin-top: 0.9rem;
  }

  .submit-button {
    width: max-content;
    min-width: 184px;
    min-height: 45px;
    border: 1px solid var(--color-blue-dark);
    background: var(--color-blue-dark);
    color: var(--color-white);
    cursor: pointer;
    transition:
      transform 250ms var(--ease-smooth),
      background 250ms var(--ease-smooth),
      border-color 250ms var(--ease-smooth);
  }

  .submit-button:hover,
  .submit-button:focus-visible {
    transform: translateY(-2px);
    border-color: var(--color-blue);
    background: var(--color-blue);
  }

  .honeypot {
    display: none;
  }

  @media (max-width: 900px) {
    .application-section {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .application-form {
      padding-left: 0;
      border-left: 0;
    }
  }

  @media (max-width: 760px) {
    .role-hero-inner {
      padding-block: 3.25rem 3.75rem;
    }

    .back-link {
      margin-bottom: 1.75rem;
    }

    .role-hero h1 {
      font-size: clamp(2rem, 8vw, 2.75rem);
      line-height: 1.06;
    }

    .role-content-section {
      padding-top: 3rem;
      padding-bottom: 4.5rem;
    }

    .role-rich-text {
      font-size: 16px;
      line-height: 1.45;
    }

    .role-rich-text :global(h2) {
      font-size: clamp(1.45rem, 7vw, 1.9rem);
    }

    .role-rich-text :global(h3) {
      font-size: clamp(1.2rem, 5.5vw, 1.45rem);
    }

    .application-section {
      margin-top: 3.75rem;
      padding-top: 3rem;
    }

    .application-heading .eyebrow {
      margin-bottom: 1.25rem;
    }

    .form-grid {
      grid-template-columns: 1fr;
      gap: 1.35rem;
    }

    .submit-button {
      width: max-content;
      min-width: 0;
      padding-inline: 1.15rem;
    }
  }
</style>