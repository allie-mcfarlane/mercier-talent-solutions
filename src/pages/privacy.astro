---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout title="Privacy Policy | Mercier Talent Solutions">
  <section class="section">
    <div class="container policy">
      <p class="eyebrow">Privacy Policy</p>
      <h1>Privacy <em>Policy</em></h1>
      <p class="updated">Last updated: August 2026</p>

      <p>
        Mercier Talent Solutions respects the privacy of visitors, clients, and prospective clients. This
        policy explains the kinds of information the website may collect, how that information may be used,
        and how visitors may contact us about privacy requests.
      </p>

      <h2>Information We May Collect</h2>
      <p>
        We may collect information that visitors choose to provide through the contact form, such as name,
        email address, message details, and the area of service interest selected by the visitor.
      </p>
      <p>
        The website may also collect limited technical information, such as browser type, device information,
        general usage information, and security information needed to protect the site from spam or abuse.
      </p>

      <h2>How We May Use Information</h2>
      <p>
        We may use information to respond to inquiries, provide requested information, operate and protect
        the website, improve the website, and maintain business records.
      </p>

      <h2>Targeted Advertising</h2>
      <p>
        This website is being built so visitors have a visible way to opt out of data collection or use for
        targeted advertising. Visit <a href="/privacy-choices/">Privacy Choices</a> to submit an opt-out
        request.
      </p>

      <h2>Large Language Model Training</h2>
      <p>
        This policy must disclose whether Mercier Talent Solutions collects, uses, or sells personal data
        for the purpose of training large language models. This statement should be finalized by the site
        owner before launch.
      </p>

      <h2>Privacy Requests And Appeals</h2>
      <p>
        Visitors may submit privacy requests, including appeal requests, through the
        <a href="/data-requests/">Data Requests & Appeals</a> page or by emailing
        <a href={`mailto:${site.privacyEmail}`}>{site.privacyEmail}</a>.
      </p>
      <p>
        Website privacy forms are sent to Mercier Talent Solutions by a third-party form service. The form
        service may process the information needed to deliver the request email.
      </p>

      <h2>Contact</h2>
      <p>
        Questions about this policy may be sent to
        <a href={`mailto:${site.privacyEmail}`}>{site.privacyEmail}</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .policy {
    max-width: 860px;
  }

  h1 {
    margin: 0.4rem 0 0.45rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: var(--page-title-size);
    font-weight: 700;
    line-height: 1;
  }

  .updated {
    color: var(--color-blue);
    font-weight: 800;
  }

  h2 {
    margin: 2rem 0 0.55rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 700;
  }

  p {
    color: var(--color-muted);
    font-size: 1.08rem;
  }
</style>
