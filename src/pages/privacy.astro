---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEntry } from "astro:content";

type PrivacyData = {
  eyebrow: string;
  title: string;
  titleAccent: string;
  updated: string;
};

const privacy = await getEntry("pages", "privacy");
if (!privacy) {
  throw new Error("Privacy policy content is missing.");
}

const privacyData = privacy.data as PrivacyData;
const { Content } = await privacy.render();
const description = "Mercier Talent Solutions privacy policy for visitors, clients, and prospective clients.";
---

<BaseLayout title="Privacy Policy | Mercier Talent Solutions" description={description}>
  <section class="section">
    <div class="container policy">
      <p class="eyebrow">{privacyData.eyebrow}</p>
      <h1>{privacyData.title} <em>{privacyData.titleAccent}</em></h1>
      <p class="updated">{privacyData.updated}</p>
      <Content />
    </div>
  </section>
</BaseLayout>

<style>
  .policy {
    max-width: 860px;
  }

  h1 {
    margin: 0.4rem 0 0.45rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: var(--page-title-size);
    font-weight: 700;
    line-height: 1;
  }

  .updated {
    color: var(--color-blue);
    font-weight: 800;
  }

  .policy :global(h2) {
    margin: 2rem 0 0.55rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 700;
  }

  .policy :global(p) {
    color: var(--color-muted);
    font-size: 1.08rem;
  }

  .policy :global(a) {
    color: var(--color-blue-dark);
    font-weight: 800;
  }
</style>
