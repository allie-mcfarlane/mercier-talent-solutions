---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEntry } from "astro:content";

type PrivacyChoicesData = {
  eyebrow: string;
  title: string;
  titleAccent: string;
};

const page = await getEntry("pages", "privacy-choices");
if (!page) {
  throw new Error("Privacy choices content is missing.");
}

const pageData = page.data as PrivacyChoicesData;
const { Content } = await page.render();
const description = "Privacy choices and privacy request information for Mercier Talent Solutions.";
---

<BaseLayout title="Privacy Choices | Mercier Talent Solutions" description={description}>
  <section class="section">
    <div class="container privacy-grid">
      <div>
        <p class="eyebrow">{pageData.eyebrow}</p>
        <h1>{pageData.title} <em>{pageData.titleAccent}</em></h1>
        <div class="intro"><Content /></div>
      </div>
      <div class="privacy-info">
        <p class="eyebrow">PRIVACY REQUESTS</p>
        <p>For privacy questions or requests, use our Data Requests & Appeals page.</p>
        <a class="button" href="/data-requests/">Data Requests & Appeals</a>
        <a class="policy-link" href="/privacy/">Privacy Policy</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .privacy-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(360px, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    max-width: var(--content-wide);
    margin-inline: auto;
  }

  h1 {
    margin: 0.4rem 0 1.2rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: var(--page-title-size);
    font-weight: 700;
    line-height: 1;
  }

  .intro :global(p),
  .privacy-info p {
    color: var(--color-muted);
    font-size: var(--paragraph-size);
  }

  .intro :global(a),
  .policy-link {
    color: var(--color-blue-dark);
    font-weight: 800;
  }

  .privacy-info {
    display: grid;
    align-content: start;
    gap: 1rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-white);
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .privacy-info .eyebrow,
  .privacy-info p {
    margin: 0;
  }

  .privacy-info .button {
    justify-self: start;
  }

  .policy-link {
    justify-self: start;
  }

  @media (max-width: 800px) {
    .privacy-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
