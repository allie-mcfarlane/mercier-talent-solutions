---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const formEndpoint = `https://formsubmit.co/${site.privacyEmail}`;
---

<BaseLayout title="Privacy Choices | Mercier Talent Solutions">
  <section class="section">
    <div class="container privacy-grid">
      <div>
        <p class="eyebrow">Privacy Choices</p>
        <h1>Opt out of targeted advertising data use</h1>
        <p>
          Use this page to opt out of data collection or use for targeted advertising purposes. This page is
          included so visitors have a clear, visible privacy choice.
        </p>
        <p>
          This form sends opt-out requests to <a href={`mailto:${site.privacyEmail}`}>{site.privacyEmail}</a>.
          Visitors may also email that address directly.
        </p>
      </div>
      <form action={formEndpoint} method="POST">
        <input type="hidden" name="_subject" value="Privacy Opt-Out Request" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="form_name" value="Privacy Choices Opt-Out" />
        <input class="honeypot" type="text" name="_honey" tabindex="-1" autocomplete="off" />
        <label>
          EMAIL
          <input type="email" name="email" required />
        </label>
        <label>
          REQUEST TYPE
          <select name="request_type" required>
            <option value="">Select one</option>
            <option>Opt out of targeted advertising data use</option>
            <option>Opt out of sale of personal data, if applicable</option>
            <option>Other privacy choice</option>
          </select>
        </label>
        <label>
          MESSAGE
          <textarea name="message" rows="6"></textarea>
        </label>
        <button class="button" type="submit">Submit Request</button>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .privacy-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(300px, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
  }

  h1 {
    margin: 0.4rem 0 1.2rem;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: clamp(2.6rem, 6vw, 5.4rem);
    font-weight: 500;
    line-height: 1;
  }

  p {
    color: var(--color-muted);
    font-size: 1.08rem;
  }

  form {
    display: grid;
    gap: 1rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-white);
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  label {
    display: grid;
    gap: 0.35rem;
    color: var(--color-blue-dark);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0;
  }

  input,
  select,
  textarea {
    width: 100%;
    border: 1px solid var(--color-line);
    border-radius: 6px;
    padding: 0.85rem;
    font: inherit;
  }

  button {
    border: 0;
    cursor: pointer;
  }

  .honeypot {
    display: none;
  }

  @media (max-width: 800px) {
    .privacy-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
