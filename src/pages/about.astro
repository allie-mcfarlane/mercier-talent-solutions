---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import { getEntry } from "astro:content";

type TeamMember = {
  eyebrow: string;
  name: string;
  image: string;
  imageAlt: string;
  paragraphs: string[];
  email: string;
  phone: string;
  linkedin: string;
  credentialsEyebrow: string;
  credentials: string;
};

type AboutData = {
  eyebrow: string;
  title: string;
  titleAccent: string;
  lede: string;
  firm: { eyebrow: string; title: string; text: string };
  team: TeamMember[];
};

const about = await getEntry("pages", "about");
if (!about || !about.data.firm || !about.data.team) {
  throw new Error("About page content is missing.");
}

const aboutData = about.data as AboutData;
---

<BaseLayout
  title="About | Mercier Talent Solutions"
  description={aboutData.lede}
  image="/images/optimized/julia-mercier-1400.jpg"
>
  <section class="section about-hero">
    <div class="container about-hero-inner">
      <div>
        <p class="eyebrow">{aboutData.eyebrow}</p>
        <h1>{aboutData.title} <em>{aboutData.titleAccent}</em></h1>
        <p>{aboutData.lede}</p>
      </div>
      <div class="about-rings" aria-hidden="true">
        <span></span>
        <span></span>
      </div>
    </div>
  </section>

  <section class="section firm-band">
    <div class="container">
      <div class="firm-card">
        <p class="eyebrow">{aboutData.firm.eyebrow}</p>
        <h2>{aboutData.firm.title}</h2>
        <p>{aboutData.firm.text}</p>
      </div>
    </div>
  </section>

  <section class="section team-band">
    <div class="container team-list">
      {aboutData.team.map((person, index) => (
        <article class={`team-card ${index % 2 === 1 ? "alternate" : ""}`}>
          <div class="media-frame portrait">
            <ResponsiveImage src={person.image} alt={person.imageAlt} sizes="(min-width: 900px) 38vw, 100vw" />
          </div>
          <div>
            <p class="eyebrow">{person.eyebrow}</p>
            <h2>{person.name}</h2>
            {person.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            <div class="meta-row">
              <a href={`mailto:${person.email}`}>{person.email}</a>
              <a href={`tel:${person.phone.replaceAll(/[^\d+]/g, "")}`}>{person.phone}</a>
              <a href={person.linkedin}>LinkedIn</a>
            </div>
            <div class="credentials">
              <p class="eyebrow">{person.credentialsEyebrow}</p>
              <p>{person.credentials}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero {
    position: relative;
    min-height: 576px;
    overflow: hidden;
    background: var(--color-blue-dark);
    color: var(--color-white);
  }

  .about-hero-inner {
    position: relative;
    display: grid;
    min-height: 456px;
    align-items: center;
  }

  .about-hero .eyebrow {
    display: inline-flex;
    gap: 14px;
    align-items: center;
    color: rgba(255, 255, 255, 0.72);
  }

  .about-hero .eyebrow::before {
    display: inline-block;
    width: 16px;
    height: 1px;
    background: rgba(255, 255, 255, 0.62);
    content: "";
  }

  .about-rings {
    position: absolute;
    right: -200px;
    bottom: -280px;
    width: 720px;
    height: 520px;
    pointer-events: none;
  }

  .about-rings span {
    position: absolute;
    border: 1px solid rgba(233, 231, 226, 0.22);
    border-radius: 50%;
  }

  .about-rings span:first-child {
    inset: 20px 70px 70px 20px;
  }

  .about-rings span:last-child {
    inset: 130px 0 0 170px;
  }

  .firm-band {
    background: var(--color-white);
  }

  .team-card {
    display: grid;
    grid-template-columns: minmax(220px, 256px) minmax(0, 1fr);
    gap: clamp(1.75rem, 4vw, 3.25rem);
    align-items: start;
  }

  .firm-card {
    max-width: 760px;
    border-top: 1px solid var(--color-line);
    padding-top: 1.65rem;
  }

  h1 {
    margin: 0.4rem 0 1.4rem;
    max-width: 850px;
    color: var(--color-white);
    font-family: var(--font-heading);
    font-size: var(--page-title-size);
    font-weight: 700;
    line-height: 1;
  }

  .about-hero h1 em {
    color: var(--color-blue);
  }

  p:not(.eyebrow) {
    color: var(--color-ink);
    font-size: 1rem;
    line-height: 1.55;
  }

  .about-hero p:not(.eyebrow) {
    max-width: 760px;
    color: rgba(255, 255, 255, 0.78);
    font-size: 16px;
    line-height: 1.55;
  }

  h2 {
    margin: 0.35rem 0 0.9rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3.5vw, 3rem);
    font-weight: 700;
    line-height: 1.05;
  }

  .team-band {
    background: var(--color-paper);
  }

  .team-list {
    display: grid;
    gap: clamp(2.25rem, 4.5vw, 3.65rem);
  }

  .team-card.alternate .portrait {
    order: 2;
  }

  .portrait {
    width: min(100%, 256px);
    aspect-ratio: 256 / 314;
    justify-self: start;
    border-radius: 0;
  }

  .credentials {
    margin-top: 1.2rem;
    border-top: 1px solid var(--color-line);
    padding-top: 0.95rem;
  }

  a {
    color: var(--color-blue-dark);
  }

  @media (max-width: 820px) {
    .team-card {
      grid-template-columns: 1fr;
    }

    .team-card.alternate .portrait {
      order: 0;
    }
  }
</style>
