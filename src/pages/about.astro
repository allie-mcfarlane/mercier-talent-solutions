---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import { getEntry } from "astro:content";

type TeamMember = {
  eyebrow: string;
  name: string;
  image: string;
  imageAlt: string;
  paragraphs: string[];
  email: string;
  phone: string;
  linkedin: string;
  credentialsEyebrow: string;
  credentials: string;
};

type AboutData = {
  eyebrow: string;
  title: string;
  titleAccent: string;
  lede: string;
  firm: { eyebrow: string; title: string; text: string };
  team: TeamMember[];
};

const about = await getEntry("pages", "about");
if (!about || !about.data.firm || !about.data.team) {
  throw new Error("About page content is missing.");
}

const aboutData = about.data as AboutData;
const credentialItems = (credentials: string) => credentials.split(" · ").map((credential) => credential.trim()).filter(Boolean);
---

<BaseLayout
  title="About | Mercier Talent Solutions"
  description={aboutData.lede}
  image="/images/optimized/julia-mercier-headshot-1400.jpg"
>
  <section class="section about-hero">
    <div class="container about-hero-inner">
      <div>
        <p class="eyebrow">{aboutData.eyebrow}</p>
        <h1>{aboutData.title} <em>{aboutData.titleAccent}</em></h1>
        <p>{aboutData.lede}</p>
      </div>
      <div class="about-rings" aria-hidden="true">
        <span></span>
        <span></span>
      </div>
    </div>
  </section>

  <section class="section firm-band">
    <div class="container">
      <div class="firm-card">
        <div>
          <p class="eyebrow">{aboutData.firm.eyebrow}</p>
          <h2>{aboutData.firm.title}</h2>
        </div>
        <p>{aboutData.firm.text}</p>
      </div>
    </div>
  </section>

  <section class="section team-band">
    <div class="container team-list">
      {aboutData.team.map((person, index) => (
        <article class={`team-card person-${index + 1}`}>
          <div class="media-frame portrait">
            <ResponsiveImage src={person.image} alt={person.imageAlt} sizes="(min-width: 900px) 38vw, 100vw" />
          </div>
          <div class="team-copy">
            <p class="eyebrow">{person.eyebrow}</p>
            <h2>{person.name}</h2>
            {person.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            <div class="meta-row">
              <a href={`mailto:${person.email}`}>{person.email}</a>
              <a href={`tel:${person.phone.replaceAll(/[^\d+]/g, "")}`}>{person.phone}</a>
              <a href={person.linkedin}>LinkedIn</a>
            </div>
            <div class="credentials">
              <p class="eyebrow">{person.credentialsEyebrow}</p>
              <div class="credential-list">
                {credentialItems(person.credentials).map((credential) => <span>{credential}</span>)}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero {
    position: relative;
    min-height: 576px;
    overflow: hidden;
    background: var(--color-blue-dark);
    color: var(--color-white);
  }

  .about-hero-inner {
    position: relative;
    display: grid;
    min-height: 456px;
    align-items: center;
  }

  .about-hero .eyebrow {
    display: inline-flex;
    gap: 14px;
    align-items: center;
    color: rgba(255, 255, 255, 0.72);
  }

  .about-hero .eyebrow::before {
    display: inline-block;
    width: 16px;
    height: 1px;
    background: rgba(255, 255, 255, 0.62);
    content: "";
  }

  .about-rings {
    position: absolute;
    right: -200px;
    bottom: -280px;
    width: 720px;
    height: 520px;
    pointer-events: none;
  }

  .about-rings span {
    position: absolute;
    border: 1px solid rgba(233, 231, 226, 0.22);
    border-radius: 50%;
  }

  .about-rings span:first-child {
    inset: 20px 70px 70px 20px;
  }

  .about-rings span:last-child {
    inset: 130px 0 0 170px;
  }

  .firm-band {
    background: var(--color-white);
  }

  .team-card {
    display: grid;
    grid-template-columns: minmax(220px, 286px) minmax(0, 1fr);
    gap: clamp(2.4rem, 5vw, 4.75rem);
    align-items: start;
  }

  .firm-card {
    display: grid;
    grid-template-columns: minmax(260px, 0.45fr) minmax(320px, 0.55fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
    border-top: 1px solid var(--color-line);
    padding-top: clamp(1.5rem, 2.4vw, 2.1rem);
  }

  h1 {
    margin: 2.4rem 0 1.5rem;
    max-width: 850px;
    color: var(--color-white);
    font-family: var(--font-heading);
    font-size: var(--page-title-size);
    font-weight: 700;
    line-height: 1;
  }

  .about-hero h1 em {
    color: var(--color-blue);
  }

  p:not(.eyebrow) {
    color: var(--color-ink);
    font-size: 1rem;
    line-height: 1.6;
  }

  .about-hero p:not(.eyebrow) {
    max-width: 760px;
    color: rgba(255, 255, 255, 0.78);
    font-size: 16px;
    line-height: 1.55;
  }

  h2 {
    margin: 0.35rem 0 0.9rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3.5vw, 3rem);
    font-weight: 700;
    line-height: 1.05;
  }

  .team-band {
    background: var(--color-paper);
  }

  .team-list {
    display: grid;
    gap: clamp(3.25rem, 6vw, 5.25rem);
  }

  .portrait {
    width: min(100%, 286px);
    aspect-ratio: 1729 / 1764;
    justify-self: start;
    border-radius: 0;
  }

  .person-1 .portrait {
    aspect-ratio: 1 / 1.08;
  }

  .person-2 .portrait {
    aspect-ratio: 1111 / 1416;
  }

  .portrait :global(img) {
    object-position: center;
  }

  .person-1 .portrait :global(img) {
    object-position: center 34%;
  }

  .firm-card[data-reveal],
  .team-card[data-reveal] {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 760ms var(--ease-soft), transform 760ms var(--ease-soft);
  }

  .firm-card[data-reveal].is-visible,
  .team-card[data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .credentials {
    margin-top: 1.55rem;
    border-top: 1px solid var(--color-line);
    padding-top: 1.15rem;
  }

  .credential-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 0.8rem;
    margin-top: 1.1rem;
  }

  .credential-list span {
    border: 1px solid var(--color-line);
    padding: 0.65rem 1rem;
    background: var(--color-white);
    color: var(--color-ink);
    font-size: 0.92rem;
    line-height: 1.25;
  }

  a {
    color: var(--color-blue-dark);
  }

  @media (max-width: 820px) {
    .firm-card,
    .team-card {
      grid-template-columns: 1fr;
    }
  }
</style>
