---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import { getEntry } from "astro:content";

type TeamMember = {
  eyebrow: string;
  name: string;
  image: string;
  imageAlt: string;
  paragraphs: string[];
  email: string;
  phone: string;
  linkedin: string;
  credentialsEyebrow: string;
  credentials: string;
};

type AboutData = {
  eyebrow: string;
  title: string;
  titleAccent: string;
  lede: string;
  firm: { eyebrow: string; title: string; text: string };
  team: TeamMember[];
};

const about = await getEntry("pages", "about");
if (!about || !about.data.firm || !about.data.team) {
  throw new Error("About page content is missing.");
}

const aboutData = about.data as AboutData;
---

<BaseLayout title="About | Mercier Talent Solutions" image="/images/optimized/julia-mercier-1400.jpg">
  <section class="section about-hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">{aboutData.eyebrow}</p>
        <h1>{aboutData.title} <em>{aboutData.titleAccent}</em></h1>
        <p>{aboutData.lede}</p>
      </div>
      <div class="firm-card">
        <p class="eyebrow">{aboutData.firm.eyebrow}</p>
        <h2>{aboutData.firm.title}</h2>
        <p>{aboutData.firm.text}</p>
      </div>
    </div>
  </section>

  <section class="section team-band">
    <div class="container team-list">
      {aboutData.team.map((person, index) => (
        <article class={`team-card ${index % 2 === 1 ? "alternate" : ""}`}>
          <div class="media-frame portrait">
            <ResponsiveImage src={person.image} alt={person.imageAlt} sizes="(min-width: 900px) 38vw, 100vw" />
          </div>
          <div>
            <p class="eyebrow">{person.eyebrow}</p>
            <h2>{person.name}</h2>
            {person.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            <div class="meta-row">
              <a href={`mailto:${person.email}`}>{person.email}</a>
              <a href={`tel:${person.phone.replaceAll(/[^\d+]/g, "")}`}>{person.phone}</a>
              <a href={person.linkedin}>LinkedIn</a>
            </div>
            <div class="credentials">
              <p class="eyebrow">{person.credentialsEyebrow}</p>
              <p>{person.credentials}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero {
    background: var(--color-white);
  }

  .hero-grid,
  .team-card {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(320px, 1.1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .firm-card {
    border-top: 1px solid var(--color-line);
    padding-top: 1.4rem;
  }

  h1 {
    margin: 0.4rem 0 1.4rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: var(--page-title-size);
    font-weight: 700;
    line-height: 1;
  }

  p:not(.eyebrow) {
    color: var(--color-muted);
    font-size: 1.12rem;
  }

  h2 {
    margin: 0.35rem 0 0.9rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: clamp(1.9rem, 4vw, 3.4rem);
    font-weight: 700;
    line-height: 1.05;
  }

  .team-band {
    background: var(--color-paper);
  }

  .team-list {
    display: grid;
    gap: clamp(2.5rem, 7vw, 6rem);
  }

  .team-card.alternate .portrait {
    order: 2;
  }

  .portrait {
    aspect-ratio: 0.82;
  }

  .credentials {
    margin-top: 1.4rem;
    border-top: 1px solid var(--color-line);
    padding-top: 1rem;
  }

  a {
    color: var(--color-blue-dark);
  }

  @media (max-width: 820px) {
    .hero-grid,
    .team-card {
      grid-template-columns: 1fr;
    }

    .team-card.alternate .portrait {
      order: 0;
    }
  }
</style>
