---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import { getEntry } from "astro:content";

type TeamMember = {
  eyebrow: string;
  name: string;
  image: string;
  imageAlt: string;
  paragraphs: string[];
  email: string;
  phone: string;
  linkedin: string;
  credentialsEyebrow: string;
  credentials: string;
};

type AboutData = {
  eyebrow: string;
  title: string;
  titleAccent: string;
  lede: string;
  firm: { eyebrow: string; title: string; text: string };
  team: TeamMember[];
};

const about = await getEntry("pages", "about");
if (!about || !about.data.firm || !about.data.team) {
  throw new Error("About page content is missing.");
}

const aboutData = about.data as AboutData;
const credentialItems = (credentials: string) => credentials.split(" · ").map((credential) => credential.trim()).filter(Boolean);
---

<BaseLayout
  title="About | Mercier Talent Solutions"
  description={aboutData.lede}
  image="/images/optimized/julia-mercier-headshot-1400.jpg"
>
  <section class="section about-hero">
    <div class="container about-hero-inner">
      <div class="about-hero-copy">
        <p class="eyebrow">{aboutData.eyebrow}</p>
        <h1>{aboutData.title} <em>{aboutData.titleAccent}</em></h1>
        <p>{aboutData.lede}</p>
      </div>
      <div class="about-rings" aria-hidden="true">
        <span></span>
        <span></span>
      </div>
    </div>
  </section>

  <section class="section firm-band">
    <div class="container">
      <div class="firm-card">
        <div class="firm-kicker">
          <p class="eyebrow">{aboutData.firm.eyebrow}</p>
          <h2>{aboutData.firm.title}</h2>
        </div>
        <p class="firm-text">{aboutData.firm.text}</p>
      </div>
    </div>
  </section>

  <section class="section team-band">
    <div class="container team-list">
      {aboutData.team.map((person, index) => (
        <article class={`team-card person-${index + 1}`}>
          <div class="media-frame portrait">
            <ResponsiveImage src={person.image} alt={person.imageAlt} sizes="(min-width: 900px) 38vw, 100vw" />
          </div>
          <div class="team-copy">
            <p class="eyebrow">{person.eyebrow}</p>
            <h2>{person.name}</h2>
            {person.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            <div class="meta-row">
              <a href={`mailto:${person.email}`}>{person.email}</a>
              <a href={`tel:${person.phone.replaceAll(/[^\d+]/g, "")}`}>{person.phone}</a>
              <a href={person.linkedin}>LinkedIn</a>
            </div>
            <div class="credentials">
              <p class="eyebrow">{person.credentialsEyebrow}</p>
              <div class="credential-list">
                {credentialItems(person.credentials).map((credential) => <span>{credential}</span>)}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero {
    position: relative;
    min-height: clamp(500px, 55vw, 620px);
    overflow: hidden;
    padding: 0;
    background: var(--color-blue-dark);
    color: var(--color-white);
  }

  .about-hero-inner {
    position: relative;
    display: grid;
    min-height: clamp(420px, 48vw, 520px);
    align-items: center;
  }

  .about-hero-copy {
    max-width: 860px;
    padding-top: clamp(1.25rem, 4vw, 3.75rem);
  }

  .about-hero .eyebrow {
    color: rgba(255, 255, 255, 0.72);
  }

  .about-hero .eyebrow::before {
    background: rgba(255, 255, 255, 0.62);
  }

  .about-rings {
    position: absolute;
    right: -200px;
    bottom: -280px;
    width: 720px;
    height: 520px;
    pointer-events: none;
  }

  .about-rings span {
    position: absolute;
    border: 1px solid rgba(233, 231, 226, 0.22);
    border-radius: 50%;
  }

  .about-rings span:first-child {
    inset: 20px 70px 70px 20px;
  }

  .about-rings span:last-child {
    inset: 130px 0 0 170px;
  }

  .firm-band {
    background: var(--color-white);
    padding: clamp(5.25rem, 8vw, 7.5rem) 0;
  }

  .team-card {
    display: grid;
    grid-template-columns: minmax(220px, 286px) minmax(0, 780px);
    gap: clamp(3.75rem, 6.4vw, 6.5rem);
    align-items: start;
  }

  .firm-card {
    display: grid;
    grid-template-columns: minmax(260px, 0.45fr) minmax(320px, 0.55fr);
    gap: clamp(3rem, 6vw, 6.25rem);
    align-items: center;
    max-width: 1120px;
    min-height: clamp(260px, 26vw, 320px);
    margin-inline: auto;
  }

  .firm-kicker {
    display: grid;
    align-content: center;
    max-width: 470px;
    min-height: 100%;
  }

  .firm-text {
    max-width: 640px;
  }

  h1 {
    margin: 2.4rem 0 1.5rem;
    max-width: 850px;
    color: var(--color-white);
    font-family: var(--font-heading);
    font-size: var(--page-title-size);
    font-weight: 700;
    line-height: 1;
  }

  .about-hero h1 em {
    color: var(--color-blue);
  }

  p:not(.eyebrow) {
    color: var(--color-ink);
    font-size: var(--paragraph-size);
    line-height: 1.6;
  }

  .about-hero p:not(.eyebrow) {
    max-width: 760px;
    color: rgba(255, 255, 255, 0.78);
    font-size: var(--paragraph-size);
    line-height: 1.55;
  }

  h2 {
    margin: 0.55rem 0 1.25rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3.5vw, 3rem);
    font-weight: 700;
    line-height: 1.12;
  }

  .team-band {
    background: var(--color-paper);
    padding: clamp(5.6rem, 8.4vw, 8rem) 0 clamp(7rem, 10vw, 9.8rem);
  }

  .team-list {
    display: grid;
    gap: clamp(6.5rem, 9vw, 9rem);
  }

  .firm-card .eyebrow {
    letter-spacing: 6px;
  }

  .firm-card .eyebrow::before {
    background: var(--color-blue);
  }

  .firm-card .eyebrow + h2 {
    margin-top: var(--heading-label-gap);
  }

  .firm-card h2 {
    max-width: 440px;
    font-size: clamp(2rem, 3vw, 2.55rem);
    line-height: 1.16;
  }

  .team-copy > .eyebrow {
    letter-spacing: 6px;
  }

  .team-copy > .eyebrow::before,
  .credentials .eyebrow::before {
    content: none;
  }

  .team-copy > .eyebrow + h2 {
    margin-top: var(--heading-label-gap);
  }

  .team-copy > h2 {
    margin-bottom: var(--heading-label-gap);
  }

  .team-copy > p:not(.eyebrow) {
    margin: 0 0 1.45rem;
  }

  .team-copy > p:not(.eyebrow):last-of-type {
    margin-bottom: 1.7rem;
  }

  .team-copy .meta-row {
    margin-top: 0.25rem;
    margin-bottom: 2.15rem;
  }

  .portrait {
    width: min(100%, 286px);
    aspect-ratio: 1729 / 1764;
    justify-self: start;
    border-radius: 0;
    box-shadow: 0 24px 70px rgba(23, 37, 62, 0.1);
  }

  .person-1 .portrait {
    aspect-ratio: 1111 / 1416;
  }

  .person-2 .portrait {
    aspect-ratio: 1111 / 1416;
  }

  .portrait :global(img) {
    object-position: center;
  }

  .person-1 .portrait :global(img) {
    object-position: center 34%;
  }

  .firm-card[data-reveal],
  .team-card[data-reveal] {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 900ms var(--ease-soft), transform 900ms var(--ease-soft);
  }

  .firm-card[data-reveal].is-visible,
  .team-card[data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .firm-card[data-reveal] .firm-kicker,
  .firm-card[data-reveal] .firm-text,
  .team-card[data-reveal] .portrait,
  .team-card[data-reveal] .team-copy {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 860ms var(--ease-soft), transform 860ms var(--ease-soft);
  }

  .firm-card[data-reveal] .firm-text,
  .team-card[data-reveal] .team-copy {
    transition-delay: 120ms;
  }

  .firm-card[data-reveal].is-visible .firm-kicker,
  .firm-card[data-reveal].is-visible .firm-text,
  .team-card[data-reveal].is-visible .portrait,
  .team-card[data-reveal].is-visible .team-copy {
    opacity: 1;
    transform: translateY(0);
  }

  .credentials {
    margin-top: 1.85rem;
    border-top: 1px solid var(--color-line);
    padding-top: 1.35rem;
  }

  .credential-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 0.8rem;
    margin-top: 1.35rem;
  }

  .credential-list span {
    border: 1px solid var(--color-line);
    padding: 0.65rem 1rem;
    background: var(--color-white);
    color: var(--color-ink);
    font-size: 0.92rem;
    line-height: 1.25;
  }

  a {
    color: var(--color-blue-dark);
  }

  @media (max-width: 820px) {
    .firm-card,
    .team-card {
      grid-template-columns: 1fr;
    }

    .about-hero {
      min-height: 520px;
    }

    .team-card {
      gap: 2rem;
    }

    .portrait {
      width: min(100%, 320px);
    }
  }

  .about-hero-copy {
    animation: aboutHeroIn 900ms var(--ease-soft) both;
  }

  .about-rings {
    animation: ringsFloat 12s ease-in-out infinite;
  }

  .about-rings span {
    animation: ringsBreathe 8s ease-in-out infinite;
  }

  .about-rings span:last-child {
    animation-delay: 1.3s;
  }

  @media (prefers-reduced-motion: reduce) {
    .about-hero-copy,
    .about-rings,
    .about-rings span {
      animation: none;
    }

    .firm-card[data-reveal],
    .team-card[data-reveal],
    .firm-card[data-reveal] .firm-kicker,
    .firm-card[data-reveal] .firm-text,
    .team-card[data-reveal] .portrait,
    .team-card[data-reveal] .team-copy {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  @keyframes aboutHeroIn {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes ringsFloat {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }

    50% {
      transform: translate3d(-18px, -12px, 0);
    }
  }

  @keyframes ringsBreathe {
    0%,
    100% {
      opacity: 0.75;
      transform: scale(1);
    }

    50% {
      opacity: 1;
      transform: scale(1.025);
    }
  }
</style>
