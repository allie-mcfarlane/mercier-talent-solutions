---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, getEntry } from "astro:content";

type WhitePapersPageData = {
  eyebrow: string;
  title: string;
  titleAccent: string;
  lede: string;
};

const whitePapersPage = await getEntry("pages", "whitepapers");
if (!whitePapersPage) {
  throw new Error("White papers page content is missing.");
}

const whitePapersPageData = whitePapersPage.data as WhitePapersPageData;
const papers = (await getCollection("white-papers")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="White Papers | Mercier Talent Solutions">
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">{whitePapersPageData.eyebrow}</p>
        <h1>{whitePapersPageData.title} <em>{whitePapersPageData.titleAccent}</em></h1>
        <p>{whitePapersPageData.lede}</p>
      </div>
      <div class="papers">
        {papers.map((paper) => (
          <article class="card paper">
            <p class="eyebrow">WHITE PAPER No. {paper.data.number}</p>
            <h2>{paper.data.title}</h2>
            <p class="subtitle">{paper.data.description}</p>
            <p>{paper.body}</p>
            <div class="paper-actions">
              {paper.data.document && <a class="button" href={paper.data.document}>Download the Paper</a>}
              <span class="meta-row">{paper.data.date.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  h1 {
    margin: 0.4rem 0 0;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: var(--page-title-size);
    font-weight: 700;
    line-height: 1;
  }

  .papers {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }

  .paper {
    display: grid;
    gap: 0.8rem;
  }

  h2 {
    margin: 0.4rem 0 0.6rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: clamp(1.7rem, 3vw, 2.7rem);
    font-weight: 700;
  }

  .subtitle {
    color: var(--color-blue-dark);
    font-family: var(--font-heading);
    font-weight: 800;
  }

  .paper-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    margin-top: 0.4rem;
  }

  @media (max-width: 760px) {
    .papers {
      grid-template-columns: 1fr;
    }
  }
</style>
