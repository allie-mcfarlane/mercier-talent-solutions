---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, getEntry } from "astro:content";

type WhitePapersPageData = {
  eyebrow: string;
  title: string;
  titleAccent: string;
  lede: string;
};

const whitePapersPage = await getEntry("pages", "whitepapers");
if (!whitePapersPage) {
  throw new Error("White papers page content is missing.");
}

const whitePapersPageData = whitePapersPage.data as WhitePapersPageData;
const papers = (await getCollection("white-papers")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const dateFormat = { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" } as const;
---

<BaseLayout title="White Papers | Mercier Talent Solutions" description={whitePapersPageData.lede}>
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <h1>{whitePapersPageData.title} <em>{whitePapersPageData.titleAccent}</em></h1>
        <p>{whitePapersPageData.lede}</p>
      </div>
      <div class="papers">
        {papers.map((paper) => (
          <article class="paper">
            <div class="paper-title-panel">
              <p>MERCIER TALENT SOLUTIONS</p>
              <p>WHITE PAPER No. {paper.data.number}</p>
              <h2>{paper.data.title}</h2>
            </div>
            <div class="paper-content-panel">
              <p class="paper-date">{paper.data.date.toLocaleDateString("en-US", dateFormat)}</p>
              <p class="subtitle">{paper.data.description}</p>
              <p>{paper.body}</p>
              {paper.data.document && <a class="button" href={paper.data.document}>Download the Paper</a>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  h1 {
    margin: 0 0 1.4rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: var(--page-title-size);
    font-weight: 700;
    line-height: 1;
  }

  .papers {
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 1.75rem);
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  .paper {
    display: grid;
    grid-template-columns: minmax(220px, 0.36fr) minmax(0, 0.64fr);
    min-height: 300px;
    overflow: hidden;
    border: 1px solid var(--color-line);
    background: var(--color-white);
  }

  .paper-title-panel {
    display: grid;
    align-content: space-between;
    min-height: 300px;
    padding: clamp(1.35rem, 3vw, 2.35rem);
    background: var(--color-blue-dark);
    color: var(--color-white);
  }

  .paper-title-panel p {
    margin: 0;
    color: rgba(255, 255, 255, 0.78);
    font-family: var(--font-label);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .paper-title-panel h2 {
    max-width: 280px;
    margin: 2rem 0 0;
    color: var(--color-white);
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 700;
    line-height: 1.08;
  }

  .paper-content-panel {
    display: grid;
    align-content: center;
    gap: 1.15rem;
    padding: clamp(1.55rem, 4vw, 3.15rem);
  }

  .paper-content-panel p {
    max-width: 720px;
    margin: 0;
  }

  .subtitle {
    color: var(--color-blue-dark);
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 800;
  }

  .paper-date {
    color: var(--color-blue-dark);
    font-family: var(--font-label);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.5px;
  }

  .paper-content-panel .button {
    width: fit-content;
  }

  @media (max-width: 760px) {
    .paper {
      grid-template-columns: 1fr;
    }

    .paper-title-panel {
      min-height: 220px;
    }
  }
</style>
