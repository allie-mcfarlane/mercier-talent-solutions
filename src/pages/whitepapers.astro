---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, getEntry } from "astro:content";

type WhitePapersPageData = {
  eyebrow: string;
  title: string;
  titleAccent: string;
  lede: string;
};

const whitePapersPage = await getEntry("pages", "whitepapers");

if (!whitePapersPage) {
  throw new Error("White papers page content is missing.");
}

const whitePapersPageData = whitePapersPage.data as WhitePapersPageData;

const papers = (await getCollection("white-papers")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const dateFormat = {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
} as const;
---

<BaseLayout
  title="White Papers | Mercier Talent Solutions"
  description={whitePapersPageData.lede}
>
  <section class="wp-hero">
    <div class="container wp-hero-grid">
      <div class="wp-hero-copy">
        <p class="eyebrow">{whitePapersPageData.eyebrow}</p>
        <div class="hero-rule" aria-hidden="true"></div>

        <h1>
          <span>{whitePapersPageData.title}</span>
          <em>{whitePapersPageData.titleAccent}</em>
        </h1>

        <p class="wp-lede">{whitePapersPageData.lede}</p>
      </div>

      <div class="hero-art" aria-hidden="true">
        <span class="r1"></span>
        <span class="r2"></span>
        <span class="r3"></span>
      </div>
    </div>
  </section>

  <section class="papers-section">
    <div class="container paper-list">
      {
        papers.map((paper, index) => (
          <article
            class={`paper-row ${index % 2 === 1 ? "paper-row-reverse" : ""}`}
            data-wp-reveal
          >
            <div class="paper-cover">
              <div class="cover-inner">
                <div class="cover-meta">
                  <span>Mercier Talent Solutions</span>
                  <span>White Paper No. {paper.data.number}</span>
                </div>

                <h2>{paper.data.title}</h2>

                <div class="cover-orbits" aria-hidden="true">
                  <span class="a"></span>
                  <span class="b"></span>
                </div>
              </div>
            </div>

            <div class="paper-content">
              <time datetime={paper.data.date.toISOString()}>
                {paper.data.date.toLocaleDateString("en-US", dateFormat)}
              </time>

              <h3>{paper.data.title}</h3>

              <p class="paper-subtitle">{paper.data.description}</p>

              <p class="paper-body">{paper.body}</p>

              {
                paper.data.document && (
                  <a
                    class="paper-action"
                    href={paper.data.document}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Download the Paper
                    <span aria-hidden="true">→</span>
                  </a>
                )
              }
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<script is:inline>
  const wpReduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  const wpRevealItems = document.querySelectorAll(
    "[data-wp-reveal]",
  );

  if (
    !wpReduceMotion &&
    "IntersectionObserver" in window
  ) {
    const wpObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          wpObserver.unobserve(entry.target);
        });
      },
      {
        threshold: 0.12,
        rootMargin: "0px 0px -8% 0px",
      },
    );

    wpRevealItems.forEach((item) =>
      wpObserver.observe(item),
    );
  } else {
    wpRevealItems.forEach((item) =>
      item.classList.add("is-visible"),
    );
  }

  if (!wpReduceMotion) {
    const art = document.querySelector(".hero-art");
    let ticking = false;

    const updateArt = () => {
      if (art) {
        const rect = art.getBoundingClientRect();
        const delta =
          (rect.top + rect.height / 2 -
            window.innerHeight / 2) /
          window.innerHeight;
        const offset = Math.max(
          -10,
          Math.min(10, delta * -10),
        );
        art.style.transform =
          `translate3d(${offset * -0.5}px, ${offset}px, 0)`;
      }

      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(updateArt);
      },
      { passive: true },
    );

    window.addEventListener("resize", updateArt);
    updateArt();
  }
</script>

<style>
  .wp-hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid rgba(221, 220, 215, 0.9);
    background:
      linear-gradient(
        140deg,
        #fafaf8 0%,
        #f0f0ec 100%
      );
  }

  .wp-hero-grid {
    position: relative;
    display: grid;
    min-height: clamp(500px, 42vw, 650px);
    grid-template-columns:
      minmax(0, 1.15fr)
      minmax(250px, 0.55fr);
    gap: clamp(3.25rem, 7vw, 7.4rem);
    align-items: center;
    max-width: 1700px;
    padding-block: clamp(4.75rem, 8vw, 7.6rem);
  }

  .wp-hero-copy {
    position: relative;
    z-index: 2;
    max-width: 1080px;
  }

  .wp-hero .eyebrow {
    color: var(--color-blue);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 5.5px;
  }

  .hero-rule {
    width: 82px;
    height: 2px;
    margin: 1.9rem 0;
    background: var(--color-blue-dark);
  }

  .wp-hero h1 {
    max-width: 1120px;
    margin: 0 0 2rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: clamp(3.125rem, 4.7vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.045;
  }

  .wp-hero h1 span {
    display: inline;
  }

  .wp-hero h1 span::after {
    content: " ";
  }

  .wp-hero h1 em {
    color: var(--color-blue);
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 700;
  }

  .wp-lede {
    max-width: 820px;
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(17px, 1.18vw, 20px);
    line-height: 1.68;
  }

  .hero-art {
    position: relative;
    width: min(27vw, 420px);
    justify-self: end;
    aspect-ratio: 1;
    will-change: transform;
  }

  .hero-art span {
    position: absolute;
    border: 1px solid rgba(69, 98, 142, 0.22);
    border-radius: 50%;
  }

  .hero-art .r1 {
    inset: 0;
  }

  .hero-art .r2 {
    inset: 18% -7% -7% 18%;
    border-color: rgba(26, 43, 70, 0.13);
  }

  .hero-art .r3 {
    inset: 39% 3% 3% 39%;
    border-color: rgba(69, 98, 142, 0.33);
  }

  .hero-art::before {
    position: absolute;
    top: 51%;
    left: -24%;
    width: 74%;
    height: 1px;
    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(69, 98, 142, 0.42)
      );
    content: "";
  }

  .papers-section {
    padding:
      clamp(5.1rem, 8vw, 8rem)
      0
      clamp(6.25rem, 9vw, 9.4rem);
    background: var(--color-white);
  }

  .paper-list {
    display: grid;
    max-width: 1500px;
  }

  .paper-row {
    display: grid;
    grid-template-columns:
      minmax(300px, 430px)
      minmax(0, 1fr);
    gap: clamp(3.4rem, 7vw, 7.4rem);
    align-items: center;
    padding: clamp(3.9rem, 6vw, 6rem) 0;
    border-top: 1px solid var(--color-line);
  }

  .paper-row:last-child {
    border-bottom: 1px solid var(--color-line);
  }

  .paper-row-reverse {
    grid-template-columns:
      minmax(0, 1fr)
      minmax(300px, 430px);
  }

  .paper-row-reverse .paper-cover {
    order: 2;
  }

  .paper-row-reverse .paper-content {
    order: 1;
  }

  .paper-cover {
    position: relative;
    width: min(100%, 430px);
    overflow: hidden;
    aspect-ratio: 0.82;
    background:
      linear-gradient(
        150deg,
        #17263f 0%,
        #1a2b46 72%,
        #213a5a 100%
      );
    color: var(--color-white);
    box-shadow:
      0 26px 70px rgba(23, 37, 62, 0.12);
    transition:
      transform 650ms var(--ease-soft),
      box-shadow 650ms var(--ease-soft);
  }

  .paper-cover:hover {
    transform: translateY(-5px);
    box-shadow:
      0 34px 90px rgba(23, 37, 62, 0.17);
  }

  .cover-inner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(1.75rem, 3vw, 2.75rem);
  }

  .cover-meta {
    display: flex;
    justify-content: space-between;
    gap: 1.25rem;
    color: rgba(255, 255, 255, 0.74);
    font-family: var(--font-label);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 2.8px;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .paper-cover h2 {
    position: relative;
    z-index: 2;
    max-width: 90%;
    margin: 0;
    color: var(--color-white);
    font-family: var(--font-heading);
    font-size: clamp(1.7rem, 2.3vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  .cover-orbits {
    position: absolute;
    right: -18%;
    bottom: -15%;
    width: 78%;
    aspect-ratio: 1;
  }

  .cover-orbits span {
    position: absolute;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 50%;
  }

  .cover-orbits .a {
    inset: 0;
  }

  .cover-orbits .b {
    inset: 30% -18% -18% 30%;
    border-color: rgba(69, 98, 142, 0.7);
  }

  .paper-content {
    max-width: 820px;
  }

  .paper-content time {
    display: block;
    margin: 0 0 1.1rem;
    color: var(--color-blue);
    font-family: var(--font-label);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 4.2px;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .paper-content h3 {
    margin: 0 0 1.1rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: clamp(2rem, 3vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.08;
  }

  .paper-subtitle {
    margin: 0 0 1.4rem;
    color: var(--color-blue-dark);
    font-family: var(--font-serif);
    font-size: clamp(17px, 1.25vw, 20px);
    font-weight: 700;
    line-height: 1.5;
  }

  .paper-body {
    max-width: 800px;
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(16px, 1.05vw, 18px);
    line-height: 1.72;
  }

  .paper-action {
    display: inline-flex;
    width: max-content;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.9rem;
    border-bottom: 1px solid var(--color-blue-dark);
    padding: 0 0 0.55rem;
    color: var(--color-blue-dark);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition:
      gap 300ms var(--ease-soft),
      color 220ms ease,
      border-color 220ms ease;
  }

  .paper-action:hover,
  .paper-action:focus-visible {
    gap: 1rem;
    border-color: var(--color-blue);
    color: var(--color-blue);
  }

  [data-wp-reveal] {
    opacity: 0;
    transform: translateY(34px);
    transition:
      opacity 850ms var(--ease-soft),
      transform 950ms var(--ease-soft);
  }

  [data-wp-reveal].is-visible {
    opacity: 1;
    transform: none;
  }

  @media (min-width: 1800px) {
    .wp-hero-grid {
      max-width: 1700px;
    }

    .paper-list {
      max-width: 1500px;
    }
  }

  @media (max-width: 1080px) {
    .wp-hero-grid {
      min-height: 0;
      grid-template-columns: 1fr;
      padding-block: 4.4rem 5rem;
    }

    .hero-art {
      position: absolute;
      right: -125px;
      bottom: -135px;
      width: 360px;
      opacity: 0.4;
    }

    .paper-row,
    .paper-row-reverse {
      grid-template-columns: 1fr;
      gap: 2.8rem;
    }

    .paper-row-reverse .paper-cover,
    .paper-row-reverse .paper-content {
      order: initial;
    }

    .paper-cover {
      width: min(100%, 430px);
    }
  }

  @media (max-width: 700px) {
    .wp-hero-grid {
      padding-block: 3.6rem 4rem;
    }

    .wp-hero h1 {
      font-size: clamp(2.65rem, 12vw, 3.65rem);
    }

    .wp-lede {
      font-size: 16px;
      line-height: 1.62;
    }

    .hero-art {
      right: -190px;
      bottom: -170px;
      width: 340px;
    }

    .papers-section {
      padding: 4rem 0 5rem;
    }

    .paper-row {
      padding: 3.5rem 0;
    }

    .cover-meta {
      display: grid;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-wp-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .paper-cover,
    .hero-art {
      transform: none !important;
      transition: none !important;
    }
  }
</style>
