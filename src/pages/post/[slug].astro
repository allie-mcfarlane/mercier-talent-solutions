---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const titleMatch = post.data.title.trim().match(/^(.*\S)\s+(\S+)$/);
const titleStart = titleMatch?.[1] ?? "";
const titleEnd = titleMatch?.[2] ?? post.data.title;
---

<BaseLayout title={`${post.data.title} | Mercier Talent Solutions`} description={post.data.seoDescription ?? post.data.excerpt}>
  <article class="section">
    <div class="container article-shell">
      <a class="back-link" href="/news/">Back to News & Insights</a>
      <header>
        <span class="pill">{post.data.category}</span>
        <h1>{titleStart && `${titleStart} `}<em>{titleEnd}</em></h1>
        <p class="dek">{post.data.excerpt}</p>
        <div class="meta-row">
          <span>Julia Mercier</span>
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}
          </time>
        </div>
      </header>
      <div class="article-body">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .article-shell {
    max-width: 880px;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 2rem;
    color: var(--color-blue-dark);
    font-weight: 800;
    text-decoration: none;
  }

  h1 {
    margin: 0.5rem 0 1rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: var(--page-title-size);
    font-weight: 700;
    line-height: 1;
  }

  .dek {
    color: var(--color-muted);
    font-size: clamp(1.08rem, 2vw, 1.28rem);
  }

  .article-body {
    margin-top: 2.5rem;
    border-top: 1px solid var(--color-line);
    padding-top: 2rem;
    color: var(--color-text);
    font-size: 1.08rem;
  }

  .article-body :global(p) {
    margin: 0 0 1.1rem;
  }

  .article-body :global(h2),
  .article-body :global(h3),
  .article-body :global(h4) {
    margin: 2rem 0 0.8rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-weight: 700;
    line-height: 1.08;
  }

  .article-body :global(h2) {
    font-size: clamp(1.9rem, 4vw, 3rem);
  }

  .article-body :global(h3) {
    font-size: clamp(1.45rem, 3vw, 2rem);
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    display: grid;
    gap: 0.55rem;
    margin: 0 0 1.3rem;
    padding-left: 1.2rem;
  }

  .article-body :global(li) {
    padding-left: 0.25rem;
  }

  .article-body :global(blockquote) {
    margin: 1.6rem 0;
    border-left: 3px solid var(--color-blue);
    padding: 0.2rem 0 0.2rem 1.2rem;
    color: var(--color-blue-dark);
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 2.2vw, 1.65rem);
    line-height: 1.35;
  }

  .article-body :global(a) {
    color: var(--color-blue-dark);
    font-weight: 700;
  }
</style>
