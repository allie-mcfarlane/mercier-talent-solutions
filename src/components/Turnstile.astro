---
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const {
  action = "contact",
  endpoint = "/api/contact",
  successMessage = "Thank you. Your message has been sent.",
} = Astro.props;
---

{
  siteKey ? (
    <>
      <div
        class="cf-turnstile"
        data-sitekey={siteKey}
        data-action={action}
        data-mts-turnstile
        data-mts-endpoint={endpoint}
        data-mts-success={successMessage}
      ></div>
      <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
      <script is:inline>
        (() => {
          const widgets = document.querySelectorAll("[data-mts-turnstile]");

          const ensureHidden = (form, name, value = "") => {
            let input = form.querySelector(`[name="${name}"]`);
            if (!input) {
              input = document.createElement("input");
              input.type = "hidden";
              input.name = name;
              form.appendChild(input);
            }
            input.value = value;
            return input;
          };

          widgets.forEach((widget) => {
            const form = widget.closest("form");
            if (!form) return;

            const endpoint = widget.getAttribute("data-mts-endpoint") || "/api/contact";
            const formAction = widget.getAttribute("data-action") || "contact";
            form.setAttribute("action", endpoint);
            form.setAttribute("method", "POST");

            let startedAt = form.querySelector('[name="form_started_at"]');
            if (!startedAt) {
              startedAt = document.createElement("input");
              startedAt.type = "hidden";
              startedAt.name = "form_started_at";
              form.appendChild(startedAt);
            }
            startedAt.value = String(Date.now());

            if (!form.querySelector('[name="company_website"]')) {
              const honeypot = document.createElement("input");
              honeypot.type = "text";
              honeypot.name = "company_website";
              honeypot.tabIndex = -1;
              honeypot.autocomplete = "off";
              honeypot.setAttribute("aria-hidden", "true");
              honeypot.className = "honeypot";
              honeypot.style.position = "absolute";
              honeypot.style.left = "-10000px";
              honeypot.style.top = "auto";
              honeypot.style.width = "1px";
              honeypot.style.height = "1px";
              honeypot.style.margin = "0";
              honeypot.style.padding = "0";
              honeypot.style.border = "0";
              honeypot.style.opacity = "0";
              honeypot.style.pointerEvents = "none";
              form.appendChild(honeypot);
            }

            if (formAction === "career") {
              const position = form.querySelector('[name="position"]')?.value || "Career Application";
              const formUrl = `${window.location.origin}${window.location.pathname}`;
              const successUrl = `${formUrl}?sent=1`;
              ensureHidden(form, "_subject", `Career Application - ${position}`);
              ensureHidden(form, "_template", "table");
              ensureHidden(form, "_captcha", "false");
              ensureHidden(form, "_cc", "julia@merciertalentsolutions.com");
              ensureHidden(form, "_url", formUrl);
              ensureHidden(form, "_next", successUrl);
              ensureHidden(form, "_replyto", "");

              form.addEventListener("submit", () => {
                const emailInput = form.querySelector('input[type="email"]');
                const currentFormUrl = `${window.location.origin}${window.location.pathname}`;
                ensureHidden(form, "_replyto", emailInput?.value?.trim() || "");
                ensureHidden(form, "_url", currentFormUrl);
                ensureHidden(form, "_next", `${currentFormUrl}?sent=1`);
              });
            }
          });

          const params = new URLSearchParams(window.location.search);
          const sent = params.get("sent") === "1";
          const error = params.get("error");
          const target = widgets[0];

          if (target && (sent || error)) {
            const note = document.createElement("p");
            note.className = "form-note turnstile-result";
            const targetAction = target.getAttribute("data-action") || "contact";

            if (sent) {
              note.textContent = target.getAttribute("data-mts-success") || "Thank you. Your message has been sent.";
              note.setAttribute("role", "status");
            } else if (error === "verification") {
              note.textContent = "Please complete the security check and try again.";
              note.setAttribute("role", "alert");
            } else if (error === "application") {
              note.textContent = "Please complete the required application fields and try again.";
              note.setAttribute("role", "alert");
            } else if (error === "attachment") {
              note.textContent = "Please check your file attachments. Use PDF, DOC, or DOCX files with a combined size under 10 MB.";
              note.setAttribute("role", "alert");
            } else if (error === "details") {
              note.textContent = "Please choose what you're interested in or add a short message before submitting.";
              note.setAttribute("role", "alert");
            } else if (error === "resume") {
              note.textContent = "Please attach a PDF, DOC, or DOCX resume under 10 MB and try again.";
              note.setAttribute("role", "alert");
            } else {
              note.textContent = targetAction === "career"
                ? "We couldn't send your application. Please try again or email us directly."
                : "We couldn't send your message. Please try again or email us directly.";
              note.setAttribute("role", "alert");
            }

            target.insertAdjacentElement("afterend", note);

            params.delete("sent");
            params.delete("error");
            const query = params.toString();
            const cleanUrl = `${window.location.pathname}${query ? `?${query}` : ""}${window.location.hash}`;
            window.history.replaceState({}, "", cleanUrl);
          }
        })();
      </script>
    </>
  ) : (
    <p class="form-note">Anti-spam protection is ready to activate once the Cloudflare Turnstile site key is added.</p>
  )
}
