---
import { site } from "../data/site";
---

<header class="site-header">
  <div class="header-inner">
    <a
      class="brand"
      href="/"
      aria-label="Mercier Talent Solutions home"
    >
      <img
        src="/images/mercier-logo-color.png"
        alt="Mercier Talent Solutions"
      />
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <span></span>
      <span></span>
      <span></span>
      <span class="menu-label">Menu</span>
    </button>

    <nav
      class="nav"
      id="site-nav"
      aria-label="Site navigation"
    >
      {
        site.nav.map((item) => (
          <a href={item.href}>
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    border-bottom: 1px solid rgba(221, 220, 215, 0.72);
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(16px);
  }

  /*
   * Full-width header.
   * No centered/max-width container buffer.
   */
  .header-inner {
    display: flex;
    width: calc(100% - (var(--page-gutter) * 2));
    max-width: none;
    min-height: 78px;
    margin-inline: auto;
    padding: 0;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1.5rem, 3vw, 3rem);
  }

  /*
   * Logo
   */
  .brand {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    color: var(--color-ink);
    text-decoration: none;
  }

  .brand img {
    display: block;
    width: clamp(168px, 12vw, 184px);
    max-width: none;
    height: auto;
    image-rendering: auto;
  }

  /*
   * Desktop navigation
   */
  .nav {
    display: flex;
    align-items: center;
    gap: clamp(1.45rem, 2.55vw, 2.55rem);
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .nav a {
    position: relative;
    padding: 0.25rem 0 0.35rem;
    color: inherit;
    text-decoration: none;
    transition: color 220ms var(--ease-soft);
  }

  /*
   * Animated underline
   */
  .nav a::after {
    position: absolute;
    right: 50%;
    bottom: 0;
    left: 50%;
    height: 1px;
    background: var(--color-blue);
    content: "";
    transition:
      left 240ms var(--ease-soft),
      right 240ms var(--ease-soft);
  }

  .nav a:hover,
  .nav a:focus-visible {
    color: var(--color-blue-dark);
  }

  .nav a:hover::after,
  .nav a:focus-visible::after {
    right: 0;
    left: 0;
  }

  /*
   * Mobile menu button
   */
  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid var(--color-line);
    border-radius: 0;
    background: var(--color-white);
    color: var(--color-blue-dark);
    cursor: pointer;
  }

  .menu-toggle span:not(.menu-label) {
    display: block;
    grid-area: 1 / 1;
    width: 18px;
    height: 2px;
    border-radius: 999px;
    background: currentColor;
    transition:
      transform 180ms ease,
      opacity 180ms ease;
  }

  .menu-toggle span:nth-child(1) {
    transform: translateY(-6px);
  }

  .menu-toggle span:nth-child(3) {
    transform: translateY(6px);
  }

  .menu-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /*
   * Tablet/mobile navigation
   */
  @media (max-width: 860px) {
    .header-inner {
      min-height: 70px;
      align-items: center;
    }

    .brand img {
      width: min(170px, 52vw);
    }

    .menu-toggle {
      display: grid;
    }

    .site-header[data-menu-open="true"]
      .menu-toggle
      span:nth-child(1) {
      transform: rotate(45deg);
    }

    .site-header[data-menu-open="true"]
      .menu-toggle
      span:nth-child(2) {
      opacity: 0;
    }

    .site-header[data-menu-open="true"]
      .menu-toggle
      span:nth-child(3) {
      transform: rotate(-45deg);
    }

    .nav {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      display: grid;
      gap: 0;
      border-top: 1px solid var(--color-line);
      border-bottom: 1px solid var(--color-line);
      background: rgba(245, 245, 243, 0.98);
      box-shadow: 0 18px 32px rgba(23, 37, 62, 0.1);
      font-size: 1rem;
      font-weight: 600;
      letter-spacing: 0;
      opacity: 0;
      pointer-events: none;
      transform: translateY(-10px);
      transition:
        opacity 180ms ease,
        transform 180ms ease;
    }

    .nav a {
      padding: 0.95rem calc(var(--page-gutter) + 1rem);
      border-bottom: 1px solid rgba(221, 220, 215, 0.7);
    }

    .nav a::after {
      display: none;
    }

    .nav a:last-child {
      border-bottom: 0;
    }

    .site-header[data-menu-open="true"] .nav {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }
  }
</style>

<script>
  const header =
    document.querySelector(".site-header");

  const menuToggle =
    header?.querySelector(".menu-toggle");

  const nav =
    header?.querySelector(".nav");

  if (header && menuToggle && nav) {
    const closeMenu = () => {
      header.removeAttribute("data-menu-open");

      menuToggle.setAttribute(
        "aria-expanded",
        "false",
      );
    };

    menuToggle.addEventListener(
      "click",
      () => {
        const isOpen =
          header.getAttribute(
            "data-menu-open",
          ) === "true";

        header.toggleAttribute(
          "data-menu-open",
          !isOpen,
        );

        menuToggle.setAttribute(
          "aria-expanded",
          String(!isOpen),
        );
      },
    );

    nav.addEventListener(
      "click",
      (event) => {
        if (
          event.target instanceof
          HTMLAnchorElement
        ) {
          closeMenu();
        }
      },
    );

    document.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "Escape") {
          closeMenu();
        }
      },
    );
  }
</script>
