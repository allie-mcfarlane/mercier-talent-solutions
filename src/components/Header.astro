---
import { site } from "../data/site";
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Mercier Talent Solutions home">
      <img src="/images/mercier-logo-color.png" alt="Mercier Talent Solutions" />
    </a>
    <nav class="nav" aria-label="Site navigation">
      {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid rgba(221, 220, 215, 0.82);
    background: rgba(245, 245, 243, 0.92);
    backdrop-filter: blur(16px);
  }

  .header-inner {
    display: flex;
    min-height: 78px;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    color: var(--color-ink);
    font-weight: 800;
    text-decoration: none;
  }

  .brand img {
    width: min(220px, 54vw);
    height: auto;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.45rem);
    color: var(--color-ink);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .nav a {
    text-decoration: none;
  }

  .nav a:hover,
  .nav a:focus-visible {
    color: var(--color-blue);
  }

  @media (max-width: 860px) {
    .header-inner {
      min-height: auto;
      align-items: flex-start;
      flex-direction: column;
      padding-block: 1rem;
    }

    .nav {
      width: 100%;
      flex-wrap: wrap;
      gap: 0.65rem 1rem;
      padding-bottom: 0.15rem;
      white-space: normal;
    }
  }

  @media (max-width: 520px) {
    .nav {
      font-size: 0.84rem;
    }
  }
</style>
