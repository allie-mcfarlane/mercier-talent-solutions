---
import { existsSync } from "node:fs";
import { join } from "node:path";

interface Props {
  src: string;
  alt: string;
  class?: string;
  sizes?: string;
  eager?: boolean;
}

const {
  src,
  alt,
  class: className,
  sizes = "(min-width: 900px) 50vw, 100vw",
  eager = false,
} = Astro.props;

const optimizedBase = src.replace(/^\/images\//, "/images/optimized/").replace(/\.[^.]+$/, "");
const optimized900 = `${optimizedBase}-900.jpg`;
const optimized1400 = `${optimizedBase}-1400.jpg`;
const publicPath = (webPath: string) => join(process.cwd(), "public", webPath.replace(/^\//, ""));
const has900 = existsSync(publicPath(optimized900));
const has1400 = existsSync(publicPath(optimized1400));
const fallbackSrc = has1400 ? optimized1400 : src;
const srcset = has900 && has1400 ? `${optimized900} 900w, ${optimized1400} 1400w` : undefined;
---

<img
  src={fallbackSrc}
  srcset={srcset}
  sizes={sizes}
  alt={alt}
  class={className}
  loading={eager ? "eager" : "lazy"}
  decoding="async"
  fetchpriority={eager ? "high" : "auto"}
/>
