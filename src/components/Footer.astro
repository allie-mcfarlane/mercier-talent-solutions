---
import { site } from "../data/site";

const serviceLinks = [
  { label: "Executive Coaching", href: "/services/#executive-coaching" },
  { label: "Assessments", href: "/services/#assessments" },
  { label: "Training", href: "/services/#training" },
  { label: "Consulting", href: "/services/#consulting" },
];
---

<footer class="site-footer">
  <div class="container footer-cta">
    <h2>Let's do our best work <em>together</em></h2>
  </div>

  <div class="container footer-grid" aria-label="Footer navigation">
    <a class="footer-brand" href="/" aria-label="Mercier Talent Solutions home">
      <img src="/images/mercier-logo-white.png" alt="Mercier Talent Solutions" />
    </a>
    <nav>
      <h3>Firm</h3>
      <a href="/about/">About</a>
      <a href="/whitepapers/">White Papers</a>
      <a href="/news/">News & Insights</a>
    </nav>
    <nav>
      <h3>Services</h3>
      {serviceLinks.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="contact">
      <h3>Contact</h3>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={`tel:${site.phone.replaceAll(/[^\d+]/g, "")}`}>{site.phone}</a>
      <a href={site.linkedIn}>LinkedIn</a>
    </div>
  </div>
  <div class="container privacy-links" aria-label="Privacy links">
    {site.privacyNav.map((item) => <a href={item.href}>{item.label}</a>)}
  </div>
  <div class="container copyright">©2026 Mercier Talent Solutions LLC. All rights reserved</div>
</footer>

<style>
  .site-footer {
    min-height: 412px;
    background: var(--color-blue-dark);
    color: var(--color-white);
    padding: 98px 0 1.25rem;
  }

  .footer-cta {
    display: grid;
    max-width: none;
    margin-bottom: 21px;
    padding-left: 386px;
  }

  .footer-cta h2 {
    max-width: 558px;
    margin: 0;
    color: var(--color-white);
    font-size: 35px;
    font-weight: 400;
    line-height: 1.3;
  }

  .footer-cta h2 em {
    color: var(--color-blue);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 250px 200px 170px 1fr;
    gap: 59px;
    align-items: start;
    border-top: 0;
    padding-top: 0;
  }

  .footer-brand {
    width: fit-content;
  }

  img {
    width: min(210px, 64vw);
    height: auto;
  }

  nav,
  .contact {
    display: grid;
    gap: 0.28rem;
    padding-top: 24px;
    font-size: 12px;
    line-height: 1.5;
  }

  h3 {
    margin: 0 0 0.25rem;
    color: var(--color-white);
    font-family: var(--font-label);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover,
  a:focus-visible {
    text-decoration: underline;
  }

  .copyright {
    margin-top: 22px;
    color: rgba(255, 255, 255, 0.58);
    font-size: 12px;
  }

  .privacy-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    justify-content: center;
    margin-top: 2rem;
    color: rgba(255, 255, 255, 0.76);
    font-size: 12px;
    text-align: center;
  }

  @media (max-width: 840px) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 620px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-cta .button {
      width: fit-content;
    }

    .footer-cta {
      padding-left: 0;
    }
  }
</style>
