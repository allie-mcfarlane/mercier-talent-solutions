---
import { site } from "../data/site";

const serviceLinks = [
  { label: "Executive Coaching", href: "/services/#executive-coaching" },
  { label: "Assessments", href: "/services/#assessments" },
  { label: "Training", href: "/services/#training" },
  { label: "Consulting", href: "/services/#consulting" },
];
---

<footer class="site-footer">
  <div class="container footer-grid" aria-label="Footer navigation">
    <a class="footer-brand" href="/" aria-label="Mercier Talent Solutions home">
      <img src="/images/mercier-logo-white.png" alt="Mercier Talent Solutions" />
    </a>
    <h2 class="footer-cta">Let's do our best work <em>together</em></h2>
    <nav>
      <h3>Firm</h3>
      <a href="/about/">About</a>
      <a href="/whitepapers/">White Papers</a>
      <a href="/news/">News & Insights</a>
    </nav>
    <nav>
      <h3>Services</h3>
      {serviceLinks.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="contact">
      <h3>Contact</h3>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={`tel:${site.phone.replaceAll(/[^\d+]/g, "")}`}>{site.phone}</a>
      <a href={site.linkedIn}>LinkedIn</a>
    </div>
  </div>
  <div class="container privacy-links" aria-label="Privacy links">
    {site.privacyNav.map((item) => <a href={item.href}>{item.label}</a>)}
  </div>
  <div class="container copyright">©2026 Mercier Talent Solutions LLC. All rights reserved</div>
</footer>

<style>
  .site-footer {
    min-height: 292px;
    background: var(--color-blue-dark);
    color: var(--color-white);
    padding: 56px 0 0.85rem;
  }

  .footer-cta {
    grid-column: 2;
    max-width: 360px;
    margin: 0;
    color: var(--color-white);
    font-family: var(--font-heading);
    font-size: clamp(1.65rem, 2vw, 2.2rem);
    font-weight: 400;
    line-height: 1.18;
    text-align: left;
  }

  .footer-cta em {
    color: var(--color-blue);
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 700;
  }

  .footer-grid {
    display: grid;
    grid-template-columns:
      minmax(170px, 260px)
      minmax(260px, 360px)
      minmax(110px, 130px)
      minmax(130px, 150px)
      minmax(190px, 220px);
    gap: clamp(1.7rem, 4vw, 4.25rem);
    align-items: start;
    border-top: 0;
    justify-content: center;
    max-width: var(--container);
    padding-top: 0;
  }

  .footer-brand {
    grid-column: 1;
    width: fit-content;
    justify-self: start;
  }

  img {
    width: min(172px, 58vw);
    height: auto;
  }

  nav,
  .contact {
    display: grid;
    gap: 0.28rem;
    padding-top: 5px;
    font-size: 12px;
    line-height: 1.5;
  }

  h3 {
    margin: 0 0 0.25rem;
    color: var(--color-white);
    font-family: var(--font-label);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  nav a,
  .contact a {
    white-space: nowrap;
  }

  a:hover,
  a:focus-visible {
    text-decoration: underline;
  }

  .copyright {
    width: fit-content;
    max-width: calc(100% - 2rem);
    margin-top: 10px;
    color: rgba(255, 255, 255, 0.58);
    font-size: 12px;
    text-align: center;
  }

  .privacy-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    justify-content: center;
    width: fit-content;
    max-width: calc(100% - 2rem);
    margin-top: 1.1rem;
    color: rgba(255, 255, 255, 0.76);
    font-size: 12px;
    text-align: center;
  }

  @media (max-width: 840px) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer-brand {
      grid-column: 1 / -1;
    }

    .footer-cta {
      grid-column: 1 / -1;
      max-width: 100%;
    }

    .footer-grid nav:first-of-type {
      grid-column: auto;
    }

    nav a,
    .contact a {
      white-space: normal;
    }
  }

  @media (max-width: 620px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-cta {
      text-align: left;
    }
  }
</style>
