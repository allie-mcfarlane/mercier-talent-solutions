---
import { site } from "../data/site";

const serviceLinks = [
  { label: "Executive Coaching", href: "/services/#executive-coaching" },
  { label: "Assessments", href: "/services/#assessments" },
  { label: "Training", href: "/services/#training" },
  { label: "Consulting", href: "/services/#consulting" },
];
---

<footer class="site-footer">
  <div class="container footer-cta">
    <p class="eyebrow">Contact us</p>
    <h2>Let's do our best work <em>together</em></h2>
    <a class="button" href="/contactus/">Contact Us</a>
  </div>

  <div class="container footer-grid" aria-label="Footer navigation">
    <a class="footer-brand" href="/" aria-label="Mercier Talent Solutions home">
      <img src="/images/mercier-logo-white.png" alt="Mercier Talent Solutions" />
    </a>
    <nav>
      <h3>Firm</h3>
      <a href="/about/">About</a>
      <a href="/whitepapers/">White Papers</a>
      <a href="/news/">News & Insights</a>
    </nav>
    <nav>
      <h3>Services</h3>
      {serviceLinks.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="contact">
      <h3>Contact</h3>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={`tel:${site.phone.replaceAll(/[^\d+]/g, "")}`}>{site.phone}</a>
      <a href={site.linkedIn}>LinkedIn</a>
    </div>
  </div>
  <div class="container privacy-links" aria-label="Privacy links">
    {site.privacyNav.map((item) => <a href={item.href}>{item.label}</a>)}
  </div>
  <div class="container copyright">©2026 Mercier Talent Solutions LLC. All rights reserved</div>
</footer>

<style>
  .site-footer {
    background: var(--color-blue-dark);
    color: var(--color-white);
    padding: clamp(3rem, 7vw, 6rem) 0 1.25rem;
  }

  .footer-cta {
    display: grid;
    gap: 1rem;
    max-width: 920px;
    margin-bottom: clamp(3rem, 7vw, 5.5rem);
  }

  .footer-cta .eyebrow {
    color: rgba(255, 255, 255, 0.68);
  }

  .footer-cta h2 {
    max-width: 820px;
    margin: 0;
    color: var(--color-white);
    font-size: clamp(2.4rem, 6vw, 5.6rem);
    line-height: 0.98;
  }

  .footer-cta .button {
    width: fit-content;
    border-color: var(--color-white);
    background: var(--color-white);
    color: var(--color-blue-dark);
  }

  .footer-cta .button:hover,
  .footer-cta .button:focus-visible {
    border-color: var(--color-blue);
    background: var(--color-blue);
    color: var(--color-white);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(190px, 1.25fr) repeat(3, minmax(150px, 1fr));
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    padding-top: clamp(1.6rem, 4vw, 2.5rem);
  }

  .footer-brand {
    width: fit-content;
  }

  img {
    width: min(210px, 64vw);
    height: auto;
  }

  nav,
  .contact {
    display: grid;
    gap: 0.5rem;
  }

  h3 {
    margin: 0 0 0.25rem;
    color: var(--color-white);
    font-family: var(--font-label);
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover,
  a:focus-visible {
    text-decoration: underline;
  }

  .copyright {
    margin-top: 1.4rem;
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.85rem;
  }

  .privacy-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin-top: 2.8rem;
    color: rgba(255, 255, 255, 0.76);
    font-size: 0.9rem;
  }

  @media (max-width: 840px) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 620px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-cta .button {
      width: fit-content;
    }
  }
</style>
