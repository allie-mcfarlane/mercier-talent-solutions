---
import { site } from "../data/site";

const serviceLinks = [
  {
    label: "Executive Coaching",
    href: "/services/#executive-coaching",
  },
  {
    label: "Assessments",
    href: "/services/#assessments",
  },
  {
    label: "Training",
    href: "/services/#training",
  },
  {
    label: "Consulting",
    href: "/services/#consulting",
  },
];
---

<footer class="site-footer">
  <a class="footer-logo-left" href="/" aria-label="Mercier Talent Solutions home">
    <img src="/images/mercier-logo-white.png" alt="Mercier Talent Solutions" />
  </a>

  <div class="container footer-center">
    <h2 class="footer-cta">Let's do our best work <em>together</em></h2>

    <div class="footer-columns" aria-label="Footer navigation">
      <nav>
        <h3>Firm</h3>
        <a href="/about/">About</a>
        <a href="/services/">Services</a>
        <a href="/whitepapers/">White Papers</a>
        <a href="/news/">News &amp; Insights</a>
      </nav>

      <nav>
        <h3>Services</h3>
        {serviceLinks.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>

      <div class="footer-contact">
        <h3>Contact</h3>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={`tel:${site.phone.replaceAll(/[^\d+]/g, "")}`}>{site.phone}</a>
        <a href={site.linkedIn}>LinkedIn</a>
      </div>
    </div>

    <nav class="privacy-links" aria-label="Privacy links">
      {site.privacyNav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <p class="copyright">©2026 Mercier Talent Solutions LLC. All rights reserved</p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background: var(--color-blue-dark);
    color: var(--color-white);
    padding: 3.3rem 0 1.35rem;
  }

  .footer-center {
    display: grid;
    justify-items: center;
    width: min(100%, 840px);
    margin-inline: auto;
    text-align: center;
  }

  .footer-cta {
    width: 100%;
    margin: 0 0 2rem;
    color: var(--color-white) !important;
    font-family: var(--font-heading);
    font-size: clamp(2rem, 2.5vw, 2.55rem);
    font-weight: 700;
    line-height: 1.14;
    text-align: center;
  }

  .footer-cta em {
    color: var(--color-blue);
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 700;
  }

  .footer-columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: 100%;
    gap: 2.4rem;
    align-items: start;
    margin-bottom: 2rem;
    text-align: center;
  }

  .footer-columns nav,
  .footer-contact {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    font-size: 13px;
    line-height: 1.5;
    text-align: center;
  }

  .footer-columns h3 {
    margin: 0 0 0.55rem;
    color: var(--color-white);
    font-family: var(--font-label);
    font-size: 12.5px;
    font-weight: 700;
    text-align: center;
    text-transform: uppercase;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover,
  a:focus-visible {
    text-decoration: underline;
  }

  .privacy-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.55rem 1.2rem;
    width: 100%;
    margin: 0 0 0.75rem;
    color: rgba(255, 255, 255, 0.76);
    font-size: 12.5px;
    text-align: center;
  }

  .copyright {
    width: 100%;
    margin: 0;
    color: rgba(255, 255, 255, 0.58);
    font-size: 12.5px;
    line-height: 1.5;
    text-align: center;
  }

  .footer-logo-left {
    position: absolute;
    top: 50%;
    left: var(--page-gutter);
    width: fit-content;
    transform: translateY(-50%);
  }

  .footer-logo-left img {
    display: block;
    width: min(182px, 15vw);
    height: auto;
  }

  @media (max-width: 980px) {
    .footer-logo-left {
      position: static;
      display: block;
      width: fit-content;
      margin: 0 0 1.75rem var(--page-gutter);
      transform: none;
    }

    .footer-logo-left img {
      width: min(165px, 42vw);
    }
  }

  @media (max-width: 700px) {
    .site-footer {
      padding: 2.6rem 0 1.1rem;
    }

    .footer-center {
      width: min(100%, 540px);
    }

    .footer-cta {
      margin-bottom: 1.5rem;
    }

    .footer-columns {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      margin-bottom: 1.5rem;
    }
  }
</style>
