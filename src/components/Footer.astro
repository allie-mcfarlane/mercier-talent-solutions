---
import { site } from "../data/site";

const serviceLinks = [
  { label: "Executive Coaching", href: "/services/#executive-coaching" },
  { label: "Assessments", href: "/services/#assessments" },
  { label: "Training", href: "/services/#training" },
  { label: "Consulting", href: "/services/#consulting" },
];
---

<footer class="site-footer">
  <div class="container footer-cta">
    <h2>Let's do our best work <em>together</em></h2>
  </div>

  <div class="container footer-grid" aria-label="Footer navigation">
    <a class="footer-brand" href="/" aria-label="Mercier Talent Solutions home">
      <img src="/images/mercier-logo-white.png" alt="Mercier Talent Solutions" />
    </a>
    <nav>
      <h3>Firm</h3>
      <a href="/about/">About</a>
      <a href="/whitepapers/">White Papers</a>
      <a href="/news/">News & Insights</a>
    </nav>
    <nav>
      <h3>Services</h3>
      {serviceLinks.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="contact">
      <h3>Contact</h3>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={`tel:${site.phone.replaceAll(/[^\d+]/g, "")}`}>{site.phone}</a>
      <a href={site.linkedIn}>LinkedIn</a>
    </div>
  </div>
  <div class="container privacy-links" aria-label="Privacy links">
    {site.privacyNav.map((item) => <a href={item.href}>{item.label}</a>)}
  </div>
  <div class="container copyright">©2026 Mercier Talent Solutions LLC. All rights reserved</div>
</footer>

<style>
  .site-footer {
    min-height: 292px;
    background: var(--color-blue-dark);
    color: var(--color-white);
    padding: 48px 0 0.85rem;
  }

  .footer-cta {
    display: grid;
    justify-items: center;
    max-width: none;
    margin-bottom: 14px;
    padding-left: 0;
    text-align: center;
  }

  .footer-cta h2 {
    max-width: 558px;
    margin: 0;
    color: var(--color-white);
    font-size: 35px;
    font-weight: 400;
    line-height: 1.3;
  }

  .footer-cta h2 em {
    color: var(--color-blue);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(170px, 205px) minmax(110px, 130px) minmax(130px, 150px) minmax(190px, 220px);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
    border-top: 0;
    justify-content: center;
    max-width: 780px;
    padding-top: 0;
  }

  .footer-brand {
    width: fit-content;
    justify-self: start;
  }

  img {
    width: min(172px, 58vw);
    height: auto;
  }

  nav,
  .contact {
    display: grid;
    gap: 0.28rem;
    padding-top: 12px;
    font-size: 12px;
    line-height: 1.5;
  }

  h3 {
    margin: 0 0 0.25rem;
    color: var(--color-white);
    font-family: var(--font-label);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  nav a,
  .contact a {
    white-space: nowrap;
  }

  a:hover,
  a:focus-visible {
    text-decoration: underline;
  }

  .copyright {
    width: fit-content;
    max-width: calc(100% - 2rem);
    margin-top: 10px;
    color: rgba(255, 255, 255, 0.58);
    font-size: 12px;
    text-align: center;
  }

  .privacy-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    justify-content: center;
    width: fit-content;
    max-width: calc(100% - 2rem);
    margin-top: 1.1rem;
    color: rgba(255, 255, 255, 0.76);
    font-size: 12px;
    text-align: center;
  }

  @media (max-width: 840px) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer-brand {
      grid-column: 1 / -1;
    }

    .footer-grid nav:first-of-type {
      grid-column: auto;
    }

    nav a,
    .contact a {
      white-space: normal;
    }
  }

  @media (max-width: 620px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-cta .button {
      width: fit-content;
    }

    .footer-cta {
      padding-left: 0;
    }
  }
</style>
