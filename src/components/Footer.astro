---
import { site } from "../data/site";
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p class="eyebrow">Mercier Talent Solutions</p>
      <p class="footer-line">Developing the lawyers and leaders who sustain high-performing firms.</p>
    </div>
    <nav aria-label="Footer navigation">
      {site.nav.slice(1).map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="contact">
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={`tel:${site.phone.replaceAll(/[^\d+]/g, "")}`}>{site.phone}</a>
      <a href={site.linkedIn}>LinkedIn</a>
    </div>
  </div>
  <div class="container privacy-links" aria-label="Privacy links">
    {site.privacyNav.map((item) => <a href={item.href}>{item.label}</a>)}
  </div>
  <div class="container copyright">©2026 Mercier Talent Solutions LLC. Allrights reserved</div>
</footer>

<style>
  .site-footer {
    background: var(--color-blue-dark);
    color: var(--color-white);
    padding: 3.5rem 0 1.25rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 2rem;
  }

  .footer-line {
    max-width: 420px;
    margin: 0.6rem 0 0;
    color: rgba(255, 255, 255, 0.74);
  }

  nav,
  .contact {
    display: grid;
    gap: 0.45rem;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover,
  a:focus-visible {
    text-decoration: underline;
  }

  .copyright {
    margin-top: 1.4rem;
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.85rem;
  }

  .privacy-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin-top: 2.8rem;
    color: rgba(255, 255, 255, 0.76);
    font-size: 0.9rem;
  }

  @media (max-width: 720px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
