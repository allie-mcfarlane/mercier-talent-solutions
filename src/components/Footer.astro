---
import { site } from "../data/site";

const serviceLinks = [
  { label: "Executive Coaching", href: "/services/#executive-coaching" },
  { label: "Assessments", href: "/services/#assessments" },
  { label: "Training", href: "/services/#training" },
  { label: "Consulting", href: "/services/#consulting" },
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <h2 class="footer-cta">Let's do our best work <em>together</em></h2>

    <div class="footer-columns" aria-label="Footer navigation">
      <div class="footer-brand">
        <a href="/" aria-label="Mercier Talent Solutions home">
          <img src="/images/mercier-logo-white.png" alt="Mercier Talent Solutions" />
        </a>
      </div>

      <div class="footer-nav-group">
        <nav>
          <h3>Firm</h3>
          <a href="/about/">About</a>
          <a href="/services/">Services</a>
          <a href="/whitepapers/">White Papers</a>
          <a href="/news/">News &amp; Insights</a>
        </nav>

        <nav>
          <h3>Services</h3>
          {serviceLinks.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>

        <div class="footer-contact">
          <h3>Contact</h3>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <a href={`tel:${site.phone.replaceAll(/[^\d+]/g, "")}`}>{site.phone}</a>
          <a href={site.linkedIn}>LinkedIn</a>
          <a href="/careers/">Careers</a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <nav class="privacy-links" aria-label="Privacy links">
        {site.privacyNav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <p class="copyright">©2026 Mercier Talent Solutions LLC. All rights reserved</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-blue-dark);
    color: var(--color-white);
    padding: clamp(4.5rem, 7vw, 6.6rem) 0 2rem;
  }

  .footer-inner {
    width: min(calc(100% - (var(--page-gutter) * 2)), 1680px);
    margin-inline: auto;
  }

  .footer-cta {
    margin: 0 auto clamp(3.2rem, 5vw, 4.2rem);
    color: var(--color-white) !important;
    font-family: var(--font-heading);
    font-size: clamp(2.15rem, 3vw, 3.25rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.08;
    text-align: center;
  }

  .footer-cta em {
    color: var(--color-blue);
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 700;
  }

  .footer-columns {
    position: relative;
    display: block;
    min-height: 176px;
  }

  .footer-brand {
    position: absolute;
    top: 0;
    left: 0;
  }

  .footer-brand a {
    display: inline-flex;
  }

  .footer-brand img {
    display: block;
    width: min(184px, 100%);
    height: auto;
  }

  .footer-nav-group {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2.5rem, 5vw, 5rem);
    width: min(100%, 820px);
    margin-inline: auto;
  }

  .footer-nav-group nav,
  .footer-contact {
    display: grid;
    align-content: start;
    gap: 0.48rem;
  }

  .footer-columns h3 {
    margin: 0 0 0.65rem;
    color: var(--color-white);
    font-family: var(--font-label);
    font-size: 12.5px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .footer-columns a,
  .footer-contact a {
    color: rgba(255, 255, 255, 0.84);
    font-size: 14px;
    line-height: 1.75;
    text-decoration: none;
  }

  .footer-columns a:hover,
  .footer-columns a:focus-visible,
  .footer-contact a:hover,
  .footer-contact a:focus-visible {
    color: var(--color-white);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-bottom {
    display: grid;
    gap: 0.75rem;
    margin-top: clamp(3rem, 5vw, 4rem);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-top: 1.45rem;
    justify-items: center;
  }

  .privacy-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.55rem 1.4rem;
    width: 100%;
    color: rgba(255, 255, 255, 0.72);
    font-size: 12.5px;
    text-align: center;
  }

  .privacy-links a {
    color: inherit;
    text-decoration: none;
  }

  .privacy-links a:hover,
  .privacy-links a:focus-visible {
    color: var(--color-white);
    text-decoration: underline;
  }

  .copyright {
    margin: 0;
    color: rgba(255, 255, 255, 0.56);
    font-size: 12.5px;
    line-height: 1.5;
    text-align: center;
  }

  @media (max-width: 980px) {
    .footer-columns {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2.4rem;
      min-height: 0;
    }

    .footer-brand {
      position: static;
    }

    .footer-nav-group {
      width: 100%;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .site-footer {
      padding: 3.5rem 0 1.5rem;
    }

    .footer-cta {
      margin-bottom: 2.5rem;
      text-align: left;
    }

    .footer-columns {
      gap: 1.9rem;
    }

    .footer-brand {
      margin-bottom: 0.4rem;
    }

    .footer-nav-group {
      grid-template-columns: 1fr;
      gap: 1.9rem;
      margin-inline: 0;
    }

    .footer-bottom {
      justify-items: start;
    }

    .privacy-links {
      justify-content: flex-start;
      text-align: left;
    }

    .copyright {
      text-align: left;
    }
  }
</style>